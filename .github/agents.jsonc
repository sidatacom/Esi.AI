# Agent Routing Specification
# JSONC format for agent orchestration and routing configuration
# Version: 1.0.0
# Last updated: 2026-08-14

# Root configuration
{
	"version": "1.0.0",
	"description": "Routing fuer vorhandene Esi.AI-Agenten mit exklusiven NVIDIA- und Intel-GPU-Slots.",

	"models": {
		"gemma-4-12b-it-qat-mtp": {
			"agent": "model-gemma-4.agent.md",
			"gpu": "nvidia",
			"backend": "customendpoint"
		},
		"qwen3.6-14b": {
			"agent": "model-qwen3.6-14b.agent.md",
			"gpu": "nvidia",
			"backend": "customendpoint"
		},
		"qwen3.6-27b": {
			"agent": "model-qwen3.6-27b.agent.md",
			"gpu": "intel",
			"backend": "customendpoint"
		},
		"qwen3.8-27b-q4": {
			"agent": "model-qwen3.8-27b-q4.agent.md",
			"gpu": "intel",
			"backend": "customendpoint"
		},
		"nemotron-3.5-lightning-30b-a3b-nvfp4": {
			"agent": "model-muse-glimmer-30b.agent.md",
			"canonical_name": "nemotron-3.5-lightning-30b-a3b-nvfp4",
			"gpu": "intel",
			"backend": "customendpoint"
		},
		"glm-4.7-flash": {
			"agent": "model-glm-4.7-flash.agent.md",
			"gpu": "intel",
			"backend": "customendpoint"
		}
	},

	"gpu_slots": {
		"nvidia": {
			"max_active_agents": 1,
			"required": true,
			"models": [
				"gemma-4-12b-it-qat-mtp",
				"qwen3.6-14b"
			]
		},
		"intel": {
			"max_active_agents": 1,
			"required": true,
			"models": [
				"qwen3.6-27b",
				"qwen3.8-27b-q4",
				"nemotron-3.5-lightning-30b-a3b-nvfp4",
				"glm-4.7-flash"
			]
		}
	},

	"routing": {
		"strategy": "gpu_affinity",
		"max_parallel_agents": 2,
		"required_parallel_agents": 2,
		"require_all_gpu_slots": true,
		"require_one_agent_per_gpu": true,
		"dispatch_mode": "parallel_gpu_pair",
		"pairing": {
			"agent_count": 2,
			"role_agent_occupies_declared_gpu": true,
			"opposite_gpu_agent_source": "models",
			"nvidia_default_model": "gemma-4-12b-it-qat-mtp",
			"intel_default_model": "qwen3.6-27b",
			"role_pairs": {
				"code-generation": {
					"nvidia": "expert-csharp.agent.md",
					"intel": "model-qwen3.6-27b.agent.md"
				},
				"code-review": {
					"nvidia": "model-gemma-4.agent.md",
					"intel": "expert-dotnet-software-engineer.agent.md"
				},
				"debugging": {
					"nvidia": "model-gemma-4.agent.md",
					"intel": "expert-dotnet-software-engineer.agent.md"
				},
				"documentation": {
					"nvidia": "model-gemma-4.agent.md",
					"intel": "model-muse-glimmer-30b.agent.md"
				},
				"blazor": {
					"nvidia": "model-gemma-4.agent.md",
					"intel": "dotnet-fullstack-mentor.agent.md"
				},
				"mcp-server": {
					"nvidia": "model-gemma-4.agent.md",
					"intel": "csharp-mcp-expert.agent.md"
				},
				"testing": {
					"nvidia": "model-gemma-4.agent.md",
					"intel": "test-runner.agent.md"
				},
				"governance": {
					"nvidia": "model-gemma-4.agent.md",
					"intel": "agent-governance-reviewer.agent.md"
				}
			}
		},
		"max_active_agents_per_gpu": 1,
		"allow_same_gpu_parallelism": false,
		"model_switching": {
			"serial": true,
			"verify_previous_worker_stopped_via_api": true,
			"forbid_shell_signals": true
		},
		"roles": {
			"code-generation": [
				"expert-csharp.agent.md",
				"expert-dotnet-software-engineer.agent.md",
				"dotnet-fullstack-mentor.agent.md"
			],
			"code-review": [
				"expert-dotnet-software-engineer.agent.md",
				"agent-governance-reviewer.agent.md"
			],
			"debugging": [
				"expert-dotnet-software-engineer.agent.md",
				"expert-csharp.agent.md"
			],
			"documentation": [
				"model-muse-glimmer-30b.agent.md",
				"model-qwen3.6-27b.agent.md"
			],
			"blazor": [
				"dotnet-fullstack-mentor.agent.md",
				"expert-csharp.agent.md"
			],
			"mcp-server": [
				"csharp-mcp-expert.agent.md"
			],
			"testing": [
				"test-runner.agent.md"
			],
			"governance": [
				"agent-governance-reviewer.agent.md"
			]
		},
		"agent_model_group_matrix": {
			"agent-governance-reviewer.agent.md": { "model": "qwen3.8-27b-q4", "group": "intel" },
			"csharp-mcp-expert.agent.md": { "model": "nemotron-3.5-lightning-30b-a3b-nvfp4", "group": "intel" },
			"dotnet-fullstack-mentor.agent.md": { "model": "nemotron-3.5-lightning-30b-a3b-nvfp4", "group": "intel" },
			"expert-csharp.agent.md": { "model": "gemma-4-12b-it-qat-mtp", "group": "nvidia" },
			"expert-dotnet-software-engineer.agent.md": { "model": "qwen3.8-27b-q4", "group": "intel" },
			"model-gemma-4.agent.md": { "model": "gemma-4-12b-it-qat-mtp", "group": "nvidia" },
			"model-glm-4.7-flash.agent.md": { "model": "glm-4.7-flash", "group": "intel" },
			"model-muse-glimmer-30b.agent.md": { "model": "nemotron-3.5-lightning-30b-a3b-nvfp4", "group": "intel" },
			"model-qwen3.6-14b.agent.md": { "model": "qwen3.6-14b", "group": "nvidia" },
			"model-qwen3.6-27b.agent.md": { "model": "qwen3.6-27b", "group": "intel" },
			"model-qwen3.8-27b-q4.agent.md": { "model": "qwen3.8-27b-q4", "group": "intel" },
			"test-runner.agent.md": { "model": "qwen3.6-27b", "group": "intel" }
		},
		"fallbacks": {
			"default": "model-qwen3.6-27b.agent.md",
			"code-generation": "expert-csharp.agent.md",
			"code-review": "expert-dotnet-software-engineer.agent.md",
			"debugging": "expert-dotnet-software-engineer.agent.md",
			"documentation": "model-qwen3.6-27b.agent.md",
			"blazor": "expert-csharp.agent.md",
			"mcp-server": "csharp-mcp-expert.agent.md",
			"testing": "test-runner.agent.md",
			"governance": "agent-governance-reviewer.agent.md"
		}
	}
}