# Agent Routing Specification
# JSONC format for agent orchestration and routing configuration
# Version: 1.0.0
# Last updated: 2026-08-14

# Root configuration
{
  "version": "1.0.0",
  "description": "Agent routing configuration for Esi.AI",
  "agents": {
    # ──────────────────────────────────────────────
    # Agent Definitions
    # ──────────────────────────────────────────────

    "code-reviewer": {
      "id": "code-reviewer",
      "type": "specialist",
      "domain": "code-review",
      "description": "Reviews code changes for correctness, style, and best practices",
      "capabilities": [
        "linting",
        "security-audit",
        "style-check",
        "performance-analysis",
        "test-coverage-check"
      ],
      "dependencies": [
        "lint-tool",
        "security-scanner",
        "coverage-analyzer"
      ],
      "max_concurrent": 1,
      "timeout_ms": 30000,
      "fallback_chain": [
        "code-reviewer-v2",
        "human-reviewer"
      ],
      "routing": {
        "patterns": [
          "code review",
          "code review request",
          "pull request review",
          "code quality",
          "style check",
          "security audit"
        ],
        "keywords": [
          "review",
          "lint",
          "security",
          "quality",
          "style"
        ],
        "exclude_patterns": [
          "code generation",
          "debug",
          "test",
          "deploy"
        ]
      },
      "resources": {
        "gpu_required": false,
        "memory_mb": 512,
        "cpu_cores": 2
      }
    },

    "code-generator": {
      "id": "code-generator",
      "type": "executor",
      "domain": "code-generation",
      "description": "Generates code from natural language specifications",
      "capabilities": [
        "code-generation",
        "template-filling",
        "refactoring",
        "boilerplate-creation",
        "test-generation"
      ],
      "dependencies": [
        "language-model",
        "template-engine",
        "code-formatter"
      ],
      "max_concurrent": 3,
      "timeout_ms": 60000,
      "fallback_chain": [
        "code-generator-v2",
        "human-developer"
      ],
      "routing": {
        "patterns": [
          "generate code",
          "write code",
          "create file",
          "implement",
          "build component",
          "add feature"
        ],
        "keywords": [
          "generate",
          "create",
          "implement",
          "build",
          "write",
          "code"
        ],
        "exclude_patterns": [
          "review",
          "debug",
          "test",
          "deploy",
          "explain"
        ]
      },
      "resources": {
        "gpu_required": true,
        "memory_mb": 4096,
        "cpu_cores": 4
      }
    },

    "test-runner": {
      "id": "test-runner",
      "type": "executor",
      "domain": "testing",
      "description": "Runs unit tests, integration tests, and validates code quality",
      "capabilities": [
        "unit-test",
        "integration-test",
        "e2e-test",
        "coverage-report",
        "performance-benchmark"
      ],
      "dependencies": [
        "test-runner",
        "coverage-collector",
        "benchmark-tool"
      ],
      "max_concurrent": 5,
      "timeout_ms": 120000,
      "fallback_chain": [
        "test-runner-v2",
        "human-tester"
      ],
      "routing": {
        "patterns": [
          "run tests",
          "run unit tests",
          "run integration tests",
          "check coverage",
          "run e2e tests",
          "validate code"
        ],
        "keywords": [
          "test",
          "unit test",
          "integration test",
          "coverage",
          "e2e",
          "validate"
        ],
        "exclude_patterns": [
          "generate",
          "review",
          "debug",
          "deploy"
        ]
      },
      "resources": {
        "gpu_required": false,
        "memory_mb": 2048,
        "cpu_cores": 4
      }
    },

    "debugger": {
      "id": "debugger",
      "type": "specialist",
      "domain": "debugging",
      "description": "Diagnoses bugs, traces execution, and suggests fixes",
      "capabilities": [
        "bug-tracing",
        "stack-trace-analysis",
        "runtime-error-diagnosis",
        "performance-profiling",
        "root-cause-analysis"
      ],
      "dependencies": [
        "profiler",
        "tracer",
        "code-reviewer"
      ],
      "max_concurrent": 1,
      "timeout_ms": 180000,
      "fallback_chain": [
        "debugger-v2",
        "human-debugger"
      ],
      "routing": {
        "patterns": [
          "debug",
          "fix bug",
          "error",
          "crash",
          "trace",
          "performance issue",
          "slow"
        ],
        "keywords": [
          "debug",
          "error",
          "bug",
          "crash",
          "trace",
          "slow",
          "performance"
        ],
        "exclude_patterns": [
          "generate",
          "review",
          "test",
          "deploy"
        ]
      },
      "resources": {
        "gpu_required": true,
        "memory_mb": 8192,
        "cpu_cores": 8
      }
    },

    "documentation": {
      "id": "documentation",
      "type": "specialist",
      "domain": "documentation",
      "description": "Creates, updates, and maintains documentation",
      "capabilities": [
        "doc-generation",
        "api-docs",
        "readme-creation",
        "tutorial-writing",
        "changelog-update"
      ],
      "dependencies": [
        "code-reader",
        "template-engine",
        "code-generator"
      ],
      "max_concurrent": 2,
      "timeout_ms": 45000,
      "fallback_chain": [
        "documentation-v2",
        "human-writer"
      ],
      "routing": {
        "patterns": [
          "write documentation",
          "create docs",
          "update readme",
          "api docs",
          "tutorial",
          "changelog"
        ],
        "keywords": [
          "doc",
          "documentation",
          "readme",
          "api",
          "tutorial",
          "changelog"
        ],
        "exclude_patterns": [
          "generate",
          "review",
          "debug",
          "test",
          "deploy"
        ]
      },
      "resources": {
        "gpu_required": false,
        "memory_mb": 1024,
        "cpu_cores": 2
      }
    },

    "blazor-router": {
      "id": "blazor-router",
      "type": "specialist",
      "domain": "blazor-routing",
      "description": "Handles Blazor-specific routing, navigation, and component lifecycle",
      "capabilities": [
        "route-definition",
        "navigation",
        "component-lifecycle",
        "state-management",
        "api-integration"
      ],
      "dependencies": [
        "code-reader",
        "code-generator"
      ],
      "max_concurrent": 2,
      "timeout_ms": 30000,
      "fallback_chain": [
        "blazor-router-v2",
        "human-blazor-dev"
      ],
      "routing": {
        "patterns": [
          "blazor route",
          "blazor navigation",
          "blazor component",
          "blazor state",
          "blazor api",
          "blazor webassembly"
        ],
        "keywords": [
          "blazor",
          "route",
          "navigation",
          "component",
          "state",
          "webassembly"
        ],
        "exclude_patterns": [
          "generate",
          "review",
          "debug",
          "test",
          "deploy"
        ]
      },
      "resources": {
        "gpu_required": false,
        "memory_mb": 2048,
        "cpu_cores": 2
      }
    },

    "mcp-server": {
      "id": "mcp-server",
      "type": "specialist",
      "domain": "mcp-server",
      "description": "Manages MCP server configuration, tool registration, and protocol compliance",
      "capabilities": [
        "mcp-config",
        "tool-registration",
        "protocol-validation",
        "resource-management",
        "gateway-setup"
      ],
      "dependencies": [
        "code-reader",
        "code-generator"
      ],
      "max_concurrent": 1,
      "timeout_ms": 60000,
      "fallback_chain": [
        "mcp-server-v2",
        "human-mcp-admin"
      ],
      "routing": {
        "patterns": [
          "mcp server",
          "mcp config",
          "mcp tool",
          "mcp resource",
          "mcp gateway",
          "mcp protocol"
        ],
        "keywords": [
          "mcp",
          "model context protocol",
          "mcp server",
          "mcp tool",
          "mcp resource"
        ],
        "exclude_patterns": [
          "generate",
          "review",
          "debug",
          "test",
          "deploy"
        ]
      },
      "resources": {
        "gpu_required": false,
        "memory_mb": 1024,
        "cpu_cores": 2
      }
    },

    "blazor-architecture": {
      "id": "blazor-architecture",
      "type": "specialist",
      "domain": "blazor-architecture",
      "description": "Provides guidance on Blazor architecture, patterns, and best practices",
      "capabilities": [
        "architecture-pattern",
        "component-pattern",
        "lifecycle-guide",
        "state-management",
        "routing-guide",
        "api-integration"
      ],
      "dependencies": [
        "code-reader",
        "documentation"
      ],
      "max_concurrent": 1,
      "timeout_ms": 30000,
      "fallback_chain": [
        "blazor-architecture-v2",
        "human-blazor-expert"
      ],
      "routing": {
        "patterns": [
          "blazor architecture",
          "blazor pattern",
          "blazor best practice",
          "blazor guide",
          "blazor tutorial",
          "blazor component"
        ],
        "keywords": [
          "blazor",
          "architecture",
          "pattern",
          "best practice",
          "guide",
          "tutorial"
        ],
        "exclude_patterns": [
          "generate",
          "review",
          "debug",
          "test",
          "deploy"
        ]
      },
      "resources": {
        "gpu_required": false,
        "memory_mb": 1024,
        "cpu_cores": 2
      }
    }
  },

  # ──────────────────────────────────────────────
  # Global Routing Configuration
  # ──────────────────────────────────────────────

  "global": {
    "default_agent": "code-reviewer",
    "max_fallback_chain_length": 3,
    "default_timeout_ms": 30000,
    "retry_policy": {
      "max_retries": 2,
      "backoff_factor": 1.5,
      "max_backoff_ms": 10000
    },
    "concurrency": {
      "max_concurrent_agents": 10,
      "per_domain_limit": 3
    },
    "observability": {
      "logging": true,
      "metrics": true,
      "tracing": true,
      "audit_trail": true
    },
    "security": {
      "tool_access_control": true,
      "content_filtering": true,
      "rate_limiting": true,
      "max_tokens_per_agent": 4096,
      "max_output_tokens": 2048
    }
  },

  # ──────────────────────────────────────────────
  # Routing Rules Engine
  # ──────────────────────────────────────────────

  "routing": {
    "strategy": "hybrid",
    "intent_classifier": {
      "model": "local-classifier",
      "confidence_threshold": 0.75,
      "fallback_on_low_confidence": true
    },
    "rule_engine": {
      "type": "regex-based",
      "case_sensitive": false,
      "normalize_whitespace": true,
      "normalize_case": true
    },
    "fallback_strategy": "chain",
    "parallel_execution": {
      "enabled": true,
      "max_parallel_agents": 5,
      "wait_for_all": true
    }
  },

  # ──────────────────────────────────────────────
  # MCP Integration
  # ──────────────────────────────────────────────

  "mcp": {
    "enabled": true,
    "servers": [
      {
        "id": "code-executor",
        "type": "tool",
        "description": "Executes code in the workspace",
        "endpoint": "mcp://code-executor",
        "tools": [
          "run-command",
          "read-file",
          "write-file",
          "list-directory",
          "grep"
        ]
      },
      {
        "id": "git-client",
        "type": "tool",
        "description": "Git operations for version control",
        "endpoint": "mcp://git-client",
        "tools": [
          "git-status",
          "git-log",
          "git-diff",
          "git-commit",
          "git-push",
          "git-branch"
        ]
      },
      {
        "id": "terminal",
        "type": "tool",
        "description": "Terminal execution for shell commands",
        "endpoint": "mcp://terminal",
        "tools": [
          "run-command",
          "run-script",
          "run-test",
          "run-build"
        ]
      },
      {
        "id": "file-system",
        "type": "tool",
        "description": "File system operations",
        "endpoint": "mcp://file-system",
        "tools": [
          "read-file",
          "write-file",
          "delete-file",
          "create-directory",
          "list-directory",
          "find-files"
        ]
      }
    ],
    "resource_management": {
      "max_resources": 100,
      "auto_cleanup": true,
      "retention_hours": 24
    }
  },

  # ──────────────────────────────────────────────
  # Blazor-Specific Configuration
  # ──────────────────────────────────────────────

  "blazor": {
    "target_framework": "net10.0",
    "hosting": "webassembly",
    "component_library": "Microsoft.AspNetCore.Components",
    "realtime": "SignalR",
    "state_management": "StatefulService",
    "routing": {
      "pattern": "path-based",
      "default_route": "/",
      "fallback_route": "/404",
      "blazorlink": true
    },
    "architecture": {
      "pattern": "component-based",
      "state": "component-local + service",
      "navigation": "Router + BlazorLink",
      "api": "HttpClient + SignalR"
    }
  }
}
