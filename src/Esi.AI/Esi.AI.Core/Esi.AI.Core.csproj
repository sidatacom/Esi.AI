<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Esi.AI.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Python\inference_server.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\vllm_xpu_bootstrap.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\sitecustomize.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\inference_pb2.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\inference_pb2_grpc.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\requirements.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\vllm-requirements.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\vllm-xpu-requirements.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\sglang-requirements.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Python\sglang-cuda-requirements.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Esi.AI.Models/Esi.AI.Models.csproj" />
    <ProjectReference Include="../../../origins/sidatacom/LLamaSharp/LLama/LLamaSharp.csproj" />
    <ProjectReference Include="../../../origins/sidatacom/OpenVINO-CSharp-API/src/OpenVINO.CSharp.API/OpenVINO.CSharp.API.csproj" />
    <ProjectReference Include="../../../origins/sidatacom/dotLLM/src/DotLLM.Core/DotLLM.Core.csproj" />
    <ProjectReference Include="../../../origins/sidatacom/dotLLM/src/DotLLM.Engine/DotLLM.Engine.csproj" />
    <ProjectReference Include="../../../origins/sidatacom/dotLLM/src/DotLLM.Models/DotLLM.Models.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../Esi.AI.Models/Grpc/vllm_inference.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
      <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/cu12.4.0/*"
        Link="runtimes/linux-x64/native/cuda12/%(Filename)%(Extension)"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/vulkan/*"
          Link="runtimes/linux-x64/native/vulkan/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
      <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/sycl/*.so"
        Link="runtimes/linux-x64/native/sycl/%(Filename)%(Extension)"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest" />
        <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/avx2/libggml-cpu.so"
          Link="runtimes/linux-x64/native/vulkan/libggml-cpu.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
        <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/avx2/libggml-cpu.so"
          Link="runtimes/linux-x64/native/avx2/libggml-cpu.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
        <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/avx2/libggml-base.so"
          Link="runtimes/linux-x64/native/avx2/libggml-base.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
        <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/avx2/libggml.so"
          Link="runtimes/linux-x64/native/avx2/libggml.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
        <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/avx2/libllama.so"
          Link="runtimes/linux-x64/native/avx2/libllama.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
