@page "/flow"
@rendermode InteractiveAuto
@using Esi.AI.Models
@using Esi.AI.Studio.Contracts
@using Esi.AI.Workflow
@inject IDataService DataService

<div class="flow-shell">
    <header class="flow-header">
        <div>
            <p class="eyebrow">WORKFLOW ROUTING</p>
            <h1>Flow routing</h1>
            <p class="lede">Open-Source-Elsa-Designer für die Esi.AI-Routing-Workflows.</p>
        </div>
        <div class="flow-actions">
            <span class="engine-status"><span class="status-dot"></span> Elsa designer ready</span>
            <button class="primary-button" type="button" @onclick="PublishFlowAsync" disabled="@isSaving">Publish</button>
        </div>
    </header>

    <section class="flow-toolbar" aria-label="Flow controls">
        <div class="toolbar-group">
            <span class="toolbar-label">Workflow</span>
            <select value="@selectedWorkflow" @onchange="OnWorkflowChangedAsync">
                <option>Chat request router</option>
                <option>Vision request router</option>
                <option>Tool calling router</option>
            </select>
            <span class="version-label">v@(currentDefinition?.Version ?? 1) · @(currentDefinition?.IsPublished == true ? "Published" : "Draft")</span>
        </div>
        <div class="toolbar-group toolbar-right">
            <button class="tool-button" type="button" @onclick="() => SaveFlowAsync()" disabled="@isSaving">@(isSaving ? "Saving..." : "Save draft")</button>
        </div>
    </section>

    <main class="flow-workspace">
        <EsiAiWorkflowDesigner DefinitionJson="@definitionJson"
                               DefinitionJsonChanged="DefinitionChangedCallback" />
    </main>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <p class="save-status">@statusMessage</p>
    }
</div>

<style>
    .flow-shell { min-height: calc(100vh - 5rem); padding: 1.4rem 1.25rem 2rem; color: #203033; }
    .flow-header, .flow-toolbar, .toolbar-group, .flow-actions { display: flex; align-items: center; gap: 1rem; }
    .flow-header { justify-content: space-between; margin: 0 auto 1.25rem; max-width: 1500px; }
    .flow-header h1 { margin: .25rem 0 .4rem; font-size: clamp(1.8rem, 3vw, 2.8rem); }
    .flow-header .lede { max-width: 42rem; margin: 0; }
    .flow-actions { flex-wrap: wrap; justify-content: flex-end; }
    .engine-status { display: inline-flex; align-items: center; gap: .45rem; color: #35675e; font-size: .82rem; font-weight: 700; }
    .status-dot { width: .55rem; height: .55rem; border-radius: 50%; background: #38a169; box-shadow: 0 0 0 .2rem #d7f2e4; }
    .primary-button, .tool-button { border: 1px solid #b7c7c2; background: #fff; color: #254b4b; cursor: pointer; font: inherit; }
    .primary-button { padding: .65rem 1rem; border-color: #236b70; background: #236b70; color: #fff; font-weight: 700; }
    .flow-toolbar { justify-content: space-between; max-width: 1500px; margin: 0 auto 1rem; padding: .7rem .9rem; border: 1px solid #d6dfdb; background: #f7faf8; }
    .toolbar-label, .version-label { color: #667976; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
    .flow-toolbar select { border: 1px solid #c4d0cc; background: #fff; color: #203033; font: inherit; padding: .5rem .6rem; }
    .toolbar-right { margin-left: auto; }.tool-button { padding: .5rem .8rem; }
    .flow-workspace { max-width: 1500px; height: 44rem; margin: 0 auto; border: 1px solid #cbd8d3; background: #fff; overflow: hidden; }
    .flow-workspace ::deep .esi-ai-elsa-designer { min-height: 44rem; height: 100%; }
    .save-status { max-width: 1500px; margin: .75rem auto; padding: .45rem .7rem; border: 1px solid #b9d5c8; background: #f1faf4; color: #35675e; font-size: .75rem; }
    @@media (max-width: 680px) { .flow-shell { padding: 1rem .75rem; }.flow-header, .flow-toolbar { align-items: stretch; flex-direction: column; }.flow-actions, .toolbar-right { justify-content: flex-start; margin-left: 0; }.flow-workspace { height: 36rem; } .flow-workspace ::deep .esi-ai-elsa-designer { min-height: 36rem; } }
</style>

@code {
    private string selectedWorkflow = "Chat request router";
    private string definitionJson = "{}";
    private FlowDefinition? currentDefinition;
    private string? statusMessage;
    private bool isSaving;

    private EventCallback<string> DefinitionChangedCallback => EventCallback.Factory.Create<string>(this, OnDefinitionChangedAsync);

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkflowAsync();
    }

    private async Task OnWorkflowChangedAsync(ChangeEventArgs args)
    {
        selectedWorkflow = args.Value?.ToString() ?? "Chat request router";
        await LoadWorkflowAsync();
    }

    private async Task LoadWorkflowAsync()
    {
        var definitions = await DataService.FlowDefinition_ReadAsync();
        currentDefinition = definitions.FirstOrDefault(definition => definition.Name == selectedWorkflow);
                definitionJson = currentDefinition?.DefinitionJson ?? CreateDefaultDefinitionJson(selectedWorkflow);
        statusMessage = null;
    }

        private static string CreateDefaultDefinitionJson(string workflowName) => workflowName switch
        {
                "Vision request router" => """
                        {
                            "nodes": [
                                { "name": "Receive vision request", "detail": "Vision request", "kind": "trigger" },
                                { "name": "Route to vision backend", "detail": "Vision backend", "kind": "backend" }
                            ]
                        }
                        """,
                "Tool calling router" => """
                        {
                            "nodes": [
                                { "name": "Receive tool request", "detail": "Tool calling request", "kind": "trigger" },
                                { "name": "Route to tool backend", "detail": "Loaded local model", "kind": "backend" }
                            ]
                        }
                        """,
                _ => """
                        {
                            "nodes": [
                                { "name": "Receive chat request", "detail": "Chat request", "kind": "trigger" },
                                { "name": "Route to chat backend", "detail": "Loaded local model", "kind": "backend" }
                            ]
                        }
                        """
        };

    private Task OnDefinitionChangedAsync(string value)
    {
        definitionJson = value;
        return Task.CompletedTask;
    }

    private Task PublishFlowAsync() => SaveFlowAsync(true);

    private async Task SaveFlowAsync(bool publish = false)
    {
        isSaving = true;
        statusMessage = null;
        try
        {
            var definition = new FlowDefinition(
                currentDefinition?.Id ?? Guid.Empty,
                selectedWorkflow,
                currentDefinition is null ? 1 : currentDefinition.Version + 1,
                publish || currentDefinition?.IsPublished == true,
                definitionJson,
                currentDefinition?.CreatedAtUtc ?? DateTime.UtcNow,
                DateTime.UtcNow);
            currentDefinition = currentDefinition is null
                ? await DataService.FlowDefinition_CreateAsync(definition)
                : await DataService.FlowDefinition_UpdateAsync(definition);
            statusMessage = publish ? "Flow published" : "Flow saved";
        }
        catch (Exception exception)
        {
            statusMessage = $"Save failed: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
