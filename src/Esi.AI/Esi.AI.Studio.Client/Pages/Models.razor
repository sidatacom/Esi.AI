@page "/models"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable
@using Esi.AI.Models
@inject NavigationManager NavigationManager
@inject IDataService DataService
@inject IModelDownloadEvents DownloadEvents

<div class="models-shell">
    <header class="models-header">
        <div><p class="eyebrow">MODEL LIBRARY</p><p class="lede">Lokale GGUF-Dateien verwalten oder Modelle von Hugging Face laden.</p></div>
        <button class="primary-button" type="button" @onclick="ScanLocalAsync" disabled="@isBusy">Bibliothek aktualisieren</button>
    </header>

    @if (activeTab == ModelTab.HuggingFace && downloads.Count > 0)
    {
        <section class="library-section downloads-section" aria-live="polite"><div class="section-heading"><div><p class="eyebrow">TRANSFERS</p><h2>Downloads</h2></div></div>
            @foreach (var download in downloads.Values.OrderByDescending(item => item.Id))
            {
                    <div class="download-row"><div class="download-heading"><strong>@download.FileName</strong><span>@download.ModelId</span></div>@if (!string.IsNullOrWhiteSpace(download.Error)) { <p class="error-message">@download.Error</p> } else { <progress max="100" value="@download.Percent"></progress><div class="download-footer"><span class="download-status">@(download.Completed ? "Download abgeschlossen" : download.Paused ? $"Pausiert · {FormatSize(download.BytesDownloaded)}" : download.Queued ? "Warteschlange" : $"{download.Percent:F0}% · {FormatSize(download.BytesDownloaded)}")</span>@if (!download.Completed) { <div class="download-actions"><button class="secondary-button" type="button" @onclick="() => (download.Paused ? ResumeDownloadAsync(download.Id) : PauseDownloadAsync(download.Id))">@(download.Paused ? "Fortsetzen" : "Pausieren")</button><button class="danger-button" type="button" @onclick="() => CancelDownloadAsync(download.Id)">Abbrechen</button></div> }</div>@if (download.Files is { Count: > 1 } files) { <details class="download-files"><summary>@files.Count Dateien</summary>@foreach (var file in files) { <div class="download-file"><span>@file.FileName</span><span>@(file.Completed ? "fertig" : $"{file.Percent:F0}% · {FormatSize(file.BytesDownloaded)}")</span><progress max="100" value="@file.Percent"></progress></div> } }</details> } }</div>
            }
        </section>
    }

    @if (status is not null)
    {
        <section class="runtime-status" aria-live="polite">
            <div class="runtime-summary">
                <p class="eyebrow">RUNTIME STATUS</p>
                <div class="status-line"><span class="status-dot @GetStatusClass()" aria-hidden="true"></span><strong>@GetStatusTitle()</strong></div>
                <span>@GetStatusDetail()</span>
            </div>
            <div class="runtime-actions"><button class="secondary-button" type="button" @onclick="OpenConfiguration">Backend konfigurieren</button><button class="primary-button" type="button" @onclick="OpenChat" disabled="@(!status.IsModelLoaded)">Chat öffnen</button></div>
        </section>
    }

    <nav class="model-tabs" aria-label="Model library views">
        <button class="model-tab @(activeTab == ModelTab.Library ? "active" : "")" type="button" @onclick="() => activeTab = ModelTab.Library">Meine Model Library</button>
        <button class="model-tab @(activeTab == ModelTab.HuggingFace ? "active" : "")" type="button" @onclick="() => activeTab = ModelTab.HuggingFace">Hugging Face suchen</button>
    </nav>

    @if (activeTab == ModelTab.Library)
    {
    <section class="library-section">
        <div class="search-row local-search-row"><span class="count-label">@localModels.Count(model => model.Format == ReferenceModelFormat.Gguf) GGUF · @localModels.Count(model => model.Format == ReferenceModelFormat.OpenVinoIr) OpenVINO</span></div>
        @if (modelDirectories.Count > 0) { <p class="directories">Suche in: @string.Join(" · ", modelDirectories)</p> }
        @if (localModels.Count == 0) { <p class="empty-state">Keine unterstützten Modelle in den konfigurierten Ordnern gefunden.</p> }
        else
        {
            <div class="model-list">
                @foreach (var model in localModels)
                {
                    <article class="model-row @(IsActive(model.Path) ? "selected" : "")"><div class="model-details"><strong>@model.Name</strong><span>@model.Format · @FormatSize(model.SizeInBytes) · @model.Path</span><div class="compatibility-editor"><span class="control-label">Kompatible Backends</span><div class="backend-checkboxes">@foreach (var backend in supportedBackends) { <label><input type="checkbox" checked="@IsCompatible(model, backend)" @onchange="async _ => await SetModelBackendAsync(model, backend)" /> @GetBackendLabel(backend)</label> }</div><div class="hf-sync-row"><input class="form-control" value="@GetHuggingFaceId(model)" @oninput="eventArgs => SetHuggingFaceId(model.Path, eventArgs.Value?.ToString())" placeholder="owner/repository" /><button class="secondary-button" type="button" @onclick="() => SyncModelBackendAsync(model)" disabled="@isBusy">HF synchronisieren</button></div></div></div><div class="model-actions">@if (model.Format == ReferenceModelFormat.Gguf) { <button class="secondary-button" type="button" @onclick="() => SelectModelAsync(model.Path)">@(IsActive(model.Path) ? "Aktiv" : "Auswählen")</button> } else { <button class="secondary-button" type="button" @onclick="OpenConfiguration">Konfigurieren</button> }<button class="danger-button" type="button" @onclick="() => RequestDeleteModel(model)" disabled="@isBusy">Löschen</button></div></article>
                }
            </div>
        }
    </section>
    }

    @if (activeTab == ModelTab.HuggingFace)
    {
    <section class="library-section remote-section">
        <div class="section-heading"><div><p class="eyebrow">HUGGING FACE</p><h2>Modelle suchen</h2></div></div>
        <div class="search-row"><InputText class="form-control" @bind-Value="searchQuery" placeholder="z. B. Qwen 3" @onkeydown="HandleSearchKeyDown" /><button class="primary-button" type="button" @onclick="SearchAsync" disabled="@isSearching">@(isSearching ? "Suche ..." : "Suchen")</button></div>
        <section class="hf-filter-panel" aria-label="Hugging Face Filter">
            <nav class="hf-filter-tabs" aria-label="Filtergruppen">
                @foreach (var group in Enum.GetValues<FilterGroup>())
                {
                    <button class="hf-filter-tab @(activeFilter == group ? "active" : "")" type="button" @onclick="() => activeFilter = group">@group</button>
                }
            </nav>
            <div class="filter-toolbar"><button class="secondary-button" type="button" @onclick="ClearFiltersAsync" disabled="@(!HasActiveFilters)">Alle Filter löschen</button></div>
            @if (activeFilter == FilterGroup.Main)
            {
                <div class="filter-columns">
                    @FilterGroupView("Tasks", mainTaskOptions, searchTasks, value => SelectFilter(FilterKind.Task, value))
                    @FilterGroupView("Parameters", parameterOptions, searchParameterRanges, value => SelectFilter(FilterKind.ParameterRange, value))
                    @FilterGroupView("Libraries", mainLibraryOptions, searchLibraries, value => SelectFilter(FilterKind.Library, value))
                    @FilterGroupView("Apps", appOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                </div>
                <div class="main-toggles"><label><input type="checkbox" @bind="baseOnly" /> Base only</label><label><input type="checkbox" @bind="inferenceAvailable" /> Inference Available</label><label class="sort-control">Sort <InputSelect @bind-Value="searchSort" @bind-Value:after="SearchAsync"><option value="trending">Trending</option><option value="downloads">Downloads</option><option value="likes">Likes</option><option value="lastModified">Recently updated</option></InputSelect></label></div>
            }
            else if (activeFilter == FilterGroup.Tasks)
            {
                @FilterGroupView("Tasks", taskOptions, searchTasks, value => SelectFilter(FilterKind.Task, value))
            }
            else if (activeFilter == FilterGroup.Libraries)
            {
                @FilterGroupView("Libraries", libraryOptions, searchLibraries, value => SelectFilter(FilterKind.Library, value))
            }
            else if (activeFilter == FilterGroup.Languages)
            {
                @FilterGroupView("Languages", languageOptions, searchLanguages, value => SelectFilter(FilterKind.Language, value))
            }
            else if (activeFilter == FilterGroup.Licenses)
            {
                @FilterGroupView("Licenses", licenseOptions, searchLicenses, value => SelectFilter(FilterKind.License, value))
            }
            else if (activeFilter == FilterGroup.Hardware)
            {
                @FilterGroupView("Hardware", hardwareOptions, searchHardware, value => SelectFilter(FilterKind.Hardware, value))
            }
            else
            {
                <div class="filter-columns">
                    @FilterGroupView("Model Tree", modelTreeOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                    @FilterGroupView("Apps", appOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                    @FilterGroupView("Inference Providers", inferenceProviderOptions, searchInferenceProviders, value => SelectFilter(FilterKind.InferenceProvider, value))
                    @FilterGroupView("One-click Deployment", deploymentOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                    @FilterGroupView("Misc", miscOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                </div>
            }
        </section>
        @if (searchResults.Count > 0)
        {
            <div class="model-list">
                @foreach (var model in searchResults)
                {
                    <article class="model-row"><div class="model-details"><strong>@model.Id</strong><span>@model.Downloads Downloads · @model.Likes Likes · @(model.Author ?? "unbekannter Autor")</span><span>Kompatibel: @FormatBackends(model.CompatibleBackends)</span>@if (downloadOptions.TryGetValue(model.Id, out var options)) { <div class="download-options"><span class="download-options-label">Version auswählen</span>@foreach (var option in options.Options) { <button class="filter-option" type="button" @onclick="() => DownloadAsync(model.Id, option.FileName, options.Library)" disabled="@(isBusy || IsDownloadQueued(model.Id))">@option.Label</button> }</div> }</div><div class="model-actions">@if (GetDownloadLibrary(model) is { } downloadLibrary) { var downloadQueued = IsDownloadQueued(model.Id); <button class="secondary-button" type="button" @onclick="() => ChooseDownloadAsync(model.Id, downloadLibrary)" disabled="@(isBusy || downloadQueued)">@(downloadQueued ? "In Download-Queue" : downloadLibrary == "openvino" ? "OpenVINO laden" : downloadLibrary == "gguf" ? "Versionen anzeigen" : "Repository laden")</button> }<a class="secondary-button" href="https://huggingface.co/@model.Id" target="_blank" rel="noopener noreferrer">Auf Hugging Face öffnen</a></div></article>
                }
            </div>
        }
        else if (hasSearched) { <p class="empty-state">Keine passenden Hugging-Face-Modelle gefunden.</p> }
    </section>
    }

    @if (pendingDeleteModel is not null)
    {
        <div class="dialog-backdrop" role="presentation">
            <section class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-model-title">
                <p class="eyebrow">MODELL ENTFERNEN</p>
                <h2 id="delete-model-title">@pendingDeleteModel.Name löschen?</h2>
                <p>Das Modell wird aus der Library entfernt.</p>
                <label class="delete-files-option"><input type="checkbox" @bind="deleteModelFiles" /> Dateien ebenfalls löschen</label>
                <div class="dialog-actions"><button class="secondary-button" type="button" @onclick="CancelDeleteModel">Abbrechen</button><button class="danger-button" type="button" @onclick="ConfirmDeleteModelAsync">Endgültig löschen</button></div>
            </section>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(message)) { <p class="model-message" role="status">@message</p> }
</div>

<style>
    .models-shell { max-width: 1040px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
    .models-header, .runtime-status, .section-heading, .search-row, .model-row, .download-heading, .download-footer { display: flex; justify-content: space-between; gap: 1rem; }
    .model-tabs { display: flex; gap: .35rem; border-bottom: 1px solid #d9d4ca; margin-top: 1.5rem; }.model-tab { border: 0; border-bottom: 3px solid transparent; background: transparent; color: #756f65; cursor: pointer; font: inherit; font-weight: 700; padding: .8rem 1rem; }.model-tab.active { border-bottom-color: #236b70; color: #236b70; }
    .models-header { align-items: end; margin-bottom: 1.5rem; }
    .runtime-status { align-items: center; border-top: 1px solid #d9d4ca; border-bottom: 1px solid #d9d4ca; margin-bottom: 1.25rem; padding: .85rem 0; }
    .runtime-summary, .model-details, .download-heading { display: grid; gap: .25rem; min-width: 0; }
    .runtime-summary .eyebrow { margin: 0; }.runtime-summary > span, .directories, .model-details span, .download-heading span { color: #756f65; overflow-wrap: anywhere; }
    .status-line { align-items: center; display: flex; gap: .5rem; }.status-dot { background: #8b8377; border-radius: 50%; display: inline-block; flex: 0 0 auto; height: .6rem; width: .6rem; }.status-dot.selected { background: #b5792f; }.status-dot.ready { background: #236b70; }
    .runtime-actions, .download-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
    .library-section { margin-top: 1.25rem; }
    .section-heading { align-items: end; border-bottom: 1px solid #e1dbd1; padding-bottom: .9rem; }
    .section-heading h2 { margin: 0; }.count-label, .download-status { color: #756f65; font-size: .85rem; }.directories { font-size: .85rem; }
    .model-list { display: grid; gap: .65rem; margin-top: 1rem; }.model-row { align-items: center; padding: .9rem 0; border-bottom: 1px solid #e1dbd1; }.model-row:last-child { border-bottom: 0; }.model-row.selected { border-left: 3px solid #236b70; padding-left: .75rem; }.model-details strong { overflow-wrap: anywhere; }.download-options { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .5rem; }
    .model-actions { display: flex; flex-wrap: wrap; gap: .45rem; justify-content: flex-end; }.delete-dialog { background: #fff; box-shadow: 0 1rem 3rem rgb(48 45 40 / .2); max-width: 30rem; padding: 1.5rem; width: min(100%, 30rem); }.delete-dialog h2 { margin: 0 0 .5rem; }.delete-dialog p { color: #756f65; }.delete-files-option { align-items: center; display: flex; gap: .45rem; margin: 1rem 0; }.dialog-backdrop { align-items: center; background: rgb(48 45 40 / .45); display: flex; inset: 0; justify-content: center; padding: 1rem; position: fixed; z-index: 10; }.dialog-actions { display: flex; flex-wrap: wrap; gap: .65rem; justify-content: flex-end; }.danger-button { background: #8b3f2f; border: 0; color: #fff; cursor: pointer; font-weight: 700; padding: .7rem 1rem; white-space: nowrap; }.danger-button:disabled { cursor: not-allowed; opacity: .55; }
    .search-row { margin-top: 1rem; }.search-row .form-control { flex: 1; }.remote-section { background: #f2eee7; }.downloads-section { background: #eef4f0; }.download-row { display: grid; gap: .4rem; padding: .8rem 0; border-bottom: 1px solid #d5dfd8; }.download-footer { align-items: center; }.download-footer .download-status { flex: 1; }progress { width: 100%; height: .7rem; accent-color: #236b70; }.empty-state, .model-message { color: #756f65; }.error-message { color: #7e311f; margin: 0; }.download-options-label { color: #756f65; display: block; font-size: .85rem; font-weight: 700; margin-bottom: .35rem; }
    .compatibility-editor { display: grid; gap: .45rem; margin-top: .35rem; }.control-label { color: #756f65; font-size: .8rem; font-weight: 700; }.backend-checkboxes { display: flex; flex-wrap: wrap; gap: .55rem .9rem; }.backend-checkboxes label { align-items: center; display: inline-flex; gap: .3rem; font-size: .82rem; }.backend-checkboxes input { accent-color: #236b70; }.hf-sync-row { align-items: center; display: flex; flex-wrap: wrap; gap: .45rem; }.hf-sync-row .form-control { flex: 1; min-width: 12rem; }
    .download-files { border-top: 1px solid #d5dfd8; margin-top: .25rem; padding-top: .4rem; }.download-files summary { color: #236b70; cursor: pointer; font-size: .85rem; }.download-file { display: grid; gap: .2rem; margin-top: .55rem; }.download-file span { overflow-wrap: anywhere; }.download-file span:nth-child(2) { color: #756f65; font-size: .8rem; }
    .hf-filter-panel { border-bottom: 1px solid #d9d4ca; }.hf-filter-tabs { display: flex; gap: .35rem; overflow-x: auto; padding: .7rem 0; }.hf-filter-tab { border: 0; border-radius: 999px; background: transparent; color: #756f65; cursor: pointer; font: inherit; padding: .35rem .65rem; white-space: nowrap; }.hf-filter-tab.active { background: #302d28; color: #fff; }.filter-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; padding: .75rem 0 1rem; }.filter-group { min-width: 0; }.filter-group h3 { color: #756f65; font-size: .85rem; font-weight: 500; margin: 0 0 .55rem; }.filter-options { display: flex; flex-wrap: wrap; gap: .45rem; }.filter-option { align-items: center; background: #fff; border: 1px solid #e2ddd5; border-radius: .5rem; color: #302d28; cursor: pointer; display: inline-flex; font-size: .85rem; gap: .35rem; padding: .42rem .6rem; }.filter-option.selected { border-color: #236b70; box-shadow: 0 0 0 1px #236b70; color: #236b70; }.filter-option input { display: none; }.main-toggles { align-items: center; border-top: 1px solid #e1dbd1; display: flex; flex-wrap: wrap; gap: 1rem; padding: .8rem 0 1rem; }.main-toggles label { align-items: center; display: inline-flex; gap: .4rem; font-size: .85rem; }.sort-control select { margin-left: .35rem; }.range-option { display: grid; gap: .35rem; min-width: 10rem; }.range-option span { color: #756f65; font-size: .8rem; }.range-option input { accent-color: #236b70; width: 100%; }
    .primary-button, .secondary-button { border: 0; padding: .7rem 1rem; font-weight: 700; cursor: pointer; }.primary-button { background: #236b70; color: white; }.secondary-button { background: #e7e1d7; color: #302d28; white-space: nowrap; }button:disabled { opacity: .55; cursor: not-allowed; }
    @@media (max-width: 680px) { .models-header, .runtime-status, .model-row, .search-row { align-items: stretch; flex-direction: column; } .filter-columns { grid-template-columns: 1fr; }.secondary-button, .primary-button { width: 100%; } }
</style>

@code {
    private readonly List<LocalModel> localModels = [];
    private readonly List<HuggingFaceModel> searchResults = [];
    private readonly Dictionary<Guid, DownloadStatus> downloads = [];
    private readonly Dictionary<string, (string Library, IReadOnlyList<ModelDownloadOption> Options)> downloadOptions = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> pendingDownloadModelIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> huggingFaceIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<string> modelDirectories = [];
    private static readonly ConfigurationBackend[] supportedBackends = Enum.GetValues<ConfigurationBackend>();
    private string searchQuery = string.Empty;
    private readonly HashSet<string> searchLibraries = [];
    private readonly HashSet<string> searchTasks = [];
    private readonly HashSet<string> searchLanguages = [];
    private readonly HashSet<string> searchLicenses = [];
    private readonly HashSet<string> searchHardware = [];
    private readonly HashSet<string> searchOther = [];
    private readonly HashSet<string> searchInferenceProviders = [];
    private readonly HashSet<string> searchParameterRanges = [];
    private string searchSort = "trending";
    private bool baseOnly, inferenceAvailable;
    private FilterGroup activeFilter = FilterGroup.Main;
    private ModelTab activeTab = ModelTab.Library;
    private bool isBusy, isSearching, hasSearched;
    private string? message;
    private ModelStatus? status;
    private LocalModel? pendingDeleteModel;
    private bool deleteModelFiles;

    protected override async Task OnInitializedAsync() { DownloadEvents.ModelDownload_Create += HandleModelDownloadCreateAsync; DownloadEvents.ModelDownload_Update += HandleModelDownloadUpdateAsync; DownloadEvents.ModelDownload_Delete += HandleModelDownloadDeleteAsync; await LoadDownloadsAsync(); await LoadStatusAsync(); await ScanLocalAsync(); modelDirectories.AddRange(await DataService.ModelDirectory_ReadAsync()); }
    private async Task ScanLocalAsync() { try { var models = await DataService.LocalModel_ReadAsync(); ReplaceLocalModels(models); message = null; } catch (Exception) { message = "Die lokalen Modelle konnten nicht gelesen werden."; } }
    private async Task SearchAsync() { isSearching = true; hasSearched = true; message = null; try { searchResults.Clear(); searchResults.AddRange(await DataService.SearchModelsAsync(new HuggingFaceSearchRequest(searchQuery.Trim(), searchLibraries.ToArray(), searchTasks.ToArray(), searchParameterRanges.ToArray(), searchLanguages.ToArray(), searchLicenses.ToArray(), searchHardware.ToArray(), searchOther.ToArray(), searchInferenceProviders.ToArray(), baseOnly, inferenceAvailable, searchSort))); } catch (Exception) { message = "Die Hugging-Face-Suche ist fehlgeschlagen."; } finally { isSearching = false; } }
    private async Task ChooseDownloadAsync(string modelId, string library) { if (library == "openvino") { await DownloadAsync(modelId, null, library); return; } try { isBusy = true; message = null; var options = await DataService.ModelDownload_ReadOptionsAsync(modelId, library); if (options.Count == 1) await DownloadAsync(modelId, options[0].FileName, library); else downloadOptions[modelId] = (library, options); } catch (Exception exception) { message = exception.Message; } finally { isBusy = false; } }
    private async Task DownloadAsync(string modelId, string? fileName, string library) { pendingDownloadModelIds.Add(modelId); isBusy = true; message = null; try { await DataService.ModelDownload_CreateAsync(new ModelDownloadRequest(modelId, fileName, library)); downloadOptions.Remove(modelId); } catch (Exception exception) { pendingDownloadModelIds.Remove(modelId); message = exception.Message; } finally { isBusy = false; } }
    private async Task PauseDownloadAsync(Guid id) { try { await DataService.ModelDownload_UpdateAsync(id, true); } catch (Exception exception) { message = exception.Message; } }
    private async Task ResumeDownloadAsync(Guid id) { try { await DataService.ModelDownload_UpdateAsync(id, false); } catch (Exception exception) { message = exception.Message; } }
    private async Task CancelDownloadAsync(Guid id) { try { await DataService.ModelDownload_DeleteAsync(id); await InvokeAsync(() => { if (downloads.Remove(id, out var download)) pendingDownloadModelIds.Remove(download.ModelId); }); message = "Download abgebrochen."; } catch (Exception exception) { message = exception.Message; } }
    private async Task HandleModelDownloadCreateAsync(ModelDownloadUpdate update) { await InvokeAsync(() => { pendingDownloadModelIds.Remove(update.Download.ModelId); downloads[update.Download.Id] = update.Download; }); await InvokeAsync(StateHasChanged); }
    private async Task HandleModelDownloadUpdateAsync(ModelDownloadUpdate update) { await InvokeAsync(() => downloads[update.Download.Id] = update.Download); if (update.LocalModels is not null) await ScanLocalAsync(); await InvokeAsync(StateHasChanged); }
    private async Task HandleModelDownloadDeleteAsync(ModelDownloadUpdate update) { await InvokeAsync(() => { pendingDownloadModelIds.Remove(update.Download.ModelId); downloads.Remove(update.Download.Id); }); await InvokeAsync(StateHasChanged); }
    private async Task LoadDownloadsAsync() { try { foreach (var download in await DataService.ModelDownload_ReadAsync()) { if (!download.Completed) downloads[download.Id] = download; } } catch (Exception exception) { message = exception.Message; } }
    private async Task SetModelBackendAsync(LocalModel model, ConfigurationBackend backend) { var compatibleBackends = (model.CompatibleBackends ?? []).ToHashSet(); if (!compatibleBackends.Add(backend)) compatibleBackends.Remove(backend); var values = compatibleBackends.OrderBy(value => value).ToArray(); try { var models = await DataService.LocalModel_UpdateAsync(new ModelCompatibilityUpdate(model.Path, values, GetHuggingFaceId(model))); ReplaceLocalModels(models); message = "Backend-Kompatibilität gespeichert."; } catch (Exception exception) { message = exception.Message; } }
    private async Task SyncModelBackendAsync(LocalModel model) { var huggingFaceId = GetHuggingFaceId(model).Trim(); if (string.IsNullOrWhiteSpace(huggingFaceId)) { message = "Bitte zuerst eine Hugging-Face-ID angeben."; return; } try { isBusy = true; var models = await DataService.LocalModel_UpdateAsync(model.Path, huggingFaceId); ReplaceLocalModels(models); message = "Backend-Kompatibilität mit Hugging Face synchronisiert."; } catch (Exception exception) { message = exception.Message; } finally { isBusy = false; } }
    private void RequestDeleteModel(LocalModel model) { pendingDeleteModel = model; deleteModelFiles = false; message = null; }
    private void CancelDeleteModel() { pendingDeleteModel = null; deleteModelFiles = false; }
    private async Task ConfirmDeleteModelAsync() { if (pendingDeleteModel is null) return; var model = pendingDeleteModel; try { isBusy = true; var models = await DataService.LocalModel_DeleteAsync(new ModelDeletionRequest(model.Path, deleteModelFiles)); ReplaceLocalModels(models); message = deleteModelFiles ? "Modell und Dateien gelöscht." : "Modell aus der Library entfernt; Dateien behalten."; pendingDeleteModel = null; } catch (Exception exception) { message = exception.Message; } finally { isBusy = false; } }
    private void ReplaceLocalModels(IEnumerable<LocalModel> models) { localModels.Clear(); huggingFaceIds.Clear(); foreach (var model in models) { localModels.Add(model); huggingFaceIds[model.Path] = model.HuggingFaceModelId ?? string.Empty; } }
    private void ReplaceLocalModel(LocalModel model) { var index = localModels.FindIndex(item => string.Equals(item.Path, model.Path, StringComparison.OrdinalIgnoreCase)); if (index >= 0) localModels[index] = model; huggingFaceIds[model.Path] = model.HuggingFaceModelId ?? string.Empty; }
    private bool IsCompatible(LocalModel model, ConfigurationBackend backend) => model.CompatibleBackends?.Contains(backend) == true;
    private string GetHuggingFaceId(LocalModel model) => huggingFaceIds.TryGetValue(model.Path, out var value) ? value : model.HuggingFaceModelId ?? string.Empty;
    private void SetHuggingFaceId(string path, string? value) => huggingFaceIds[path] = value ?? string.Empty;
    private static string GetBackendLabel(ConfigurationBackend backend) => backend switch { ConfigurationBackend.Llama => "LLama", ConfigurationBackend.OpenVino => "OpenVINO", ConfigurationBackend.Vllm => "vLLM", ConfigurationBackend.Sglang => "SGLang", ConfigurationBackend.DotLlm => "dotLLM", _ => backend.ToString() };
    private static string FormatBackends(IReadOnlyList<ConfigurationBackend>? backends) => backends is { Count: > 0 } values ? string.Join(", ", values.Select(GetBackendLabel)) : "nicht zugeordnet";
    private static string? GetDownloadLibrary(HuggingFaceModel model) => HasLibrary(model, "openvino") ? "openvino" : HasLibrary(model, "gguf") ? "gguf" : string.IsNullOrWhiteSpace(model.LibraryName) ? null : model.LibraryName.Trim().ToLowerInvariant();
    private static bool HasLibrary(HuggingFaceModel model, string value) => string.Equals(model.LibraryName, value, StringComparison.OrdinalIgnoreCase) || model.Tags?.Any(tag => string.Equals(tag, value, StringComparison.OrdinalIgnoreCase)) == true;
    private bool IsDownloadQueued(string modelId) => pendingDownloadModelIds.Contains(modelId) || downloads.Values.Any(download => string.Equals(download.ModelId, modelId, StringComparison.OrdinalIgnoreCase) && !download.Completed);
    private async Task SelectModelAsync(string path) { try { status = await DataService.SelectModelAsync(new SelectModelRequest(path)); message = "Modell als aktives Chat-Modell ausgewählt. Jetzt unter LLama laden."; } catch (Exception) { message = "Das Modell konnte nicht ausgewählt werden."; } }
    private async Task LoadStatusAsync() { var modelStatus = await DataService.LoadedModel_ReadAsync(); status = new ModelStatus(modelStatus.ModelPath, modelStatus.Backend, modelStatus.GpuLayerCount, modelStatus.ContextSize, modelStatus.FoundVulkanGpuCount, modelStatus.IsModelLoaded); }
    private string GetStatusTitle() => status?.IsModelLoaded == true ? "Modell geladen" : status?.ModelPath is not null ? "Modell ausgewählt" : "Kein Modell geladen";
    private string GetStatusDetail() => status?.ModelPath is { Length: > 0 } path ? $"{System.IO.Path.GetFileName(path)} · {status.Backend}" : "Wähle ein Modell aus der Library oder konfiguriere ein Backend.";
    private string GetStatusClass() => status?.IsModelLoaded == true ? "ready" : status?.ModelPath is not null ? "selected" : "idle";
    private bool IsActive(string path) => string.Equals(status?.ModelPath, path, StringComparison.OrdinalIgnoreCase);
    private void OpenConfiguration() => NavigationManager.NavigateTo("backends"); private void OpenChat() => NavigationManager.NavigateTo("chats");
    private static string FormatSize(long bytes) => bytes switch { > 1024 * 1024 * 1024 => $"{bytes / 1024d / 1024d / 1024d:F2} GiB", > 1024 * 1024 => $"{bytes / 1024d / 1024d:F1} MiB", _ => $"{bytes / 1024d:F0} KiB" };
    private async Task HandleSearchKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await SearchAsync(); }
    private void SelectFilter(FilterKind kind, string value) { var selectedValues = kind switch { FilterKind.Library => searchLibraries, FilterKind.Task => searchTasks, FilterKind.ParameterRange => searchParameterRanges, FilterKind.Language => searchLanguages, FilterKind.License => searchLicenses, FilterKind.Hardware => searchHardware, FilterKind.Other => searchOther, FilterKind.InferenceProvider => searchInferenceProviders, _ => throw new ArgumentOutOfRangeException(nameof(kind)) }; if (!selectedValues.Add(value)) selectedValues.Remove(value); }
    private bool HasActiveFilters => searchLibraries.Count > 0 || searchTasks.Count > 0 || searchLanguages.Count > 0 || searchLicenses.Count > 0 || searchHardware.Count > 0 || searchOther.Count > 0 || searchInferenceProviders.Count > 0 || searchParameterRanges.Count > 0 || baseOnly || inferenceAvailable;
    private async Task ClearFiltersAsync() { searchLibraries.Clear(); searchTasks.Clear(); searchLanguages.Clear(); searchLicenses.Clear(); searchHardware.Clear(); searchOther.Clear(); searchInferenceProviders.Clear(); searchParameterRanges.Clear(); baseOnly = false; inferenceAvailable = false; if (hasSearched) await SearchAsync(); }
    private static string FilterOptionClass(FilterOption option, IReadOnlySet<string> selectedValues) => selectedValues.Contains(option.Value) ? "filter-option selected" : "filter-option";
