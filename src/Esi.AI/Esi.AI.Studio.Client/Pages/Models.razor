@page "/models"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable
@using Esi.AI.Models
@inject NavigationManager NavigationManager
@inject IDataService DataService
@inject IModelDownloadEvents DownloadEvents

<div class="models-shell">
    <header class="models-header">
        <div><p class="eyebrow">MODEL LIBRARY</p><p class="lede">Lokale GGUF-Dateien verwalten oder Modelle von Hugging Face laden.</p></div>
        <button class="primary-button" type="button" @onclick="ScanLocalAsync" disabled="@isBusy">Bibliothek aktualisieren</button>
    </header>

    @if (activeTab == ModelTab.HuggingFace && downloads.Count > 0)
    {
        <section class="library-section downloads-section" aria-live="polite"><div class="section-heading"><div><p class="eyebrow">TRANSFERS</p><h2>Downloads</h2></div></div>
            @foreach (var download in downloads.Values.OrderByDescending(item => item.Id))
            {
                    <div class="download-row"><div class="download-heading"><strong>@download.FileName</strong><span>@download.ModelId</span></div>@if (!string.IsNullOrWhiteSpace(download.Error)) { <p class="error-message">@download.Error</p> } else { <progress max="100" value="@download.Percent"></progress><div class="download-footer"><span class="download-status">@(download.Completed ? "Download abgeschlossen" : download.Paused ? $"Pausiert · {FormatSize(download.BytesDownloaded)}" : download.Queued ? "Warteschlange" : $"{download.Percent:F0}% · {FormatSize(download.BytesDownloaded)}")</span>@if (!download.Completed) { <button class="secondary-button" type="button" @onclick="() => (download.Paused ? ResumeDownloadAsync(download.Id) : PauseDownloadAsync(download.Id))">@(download.Paused ? "Fortsetzen" : "Pausieren")</button> }</div>@if (download.Files is { Count: > 1 } files) { <details class="download-files"><summary>@files.Count Dateien</summary>@foreach (var file in files) { <div class="download-file"><span>@file.FileName</span><span>@(file.Completed ? "fertig" : $"{file.Percent:F0}% · {FormatSize(file.BytesDownloaded)}")</span><progress max="100" value="@file.Percent"></progress></div> } }</details> } }</div>
            }
        </section>
    }

    @if (status is not null)
    {
        <section class="runtime-status" aria-live="polite">
            <div class="runtime-summary">
                <p class="eyebrow">RUNTIME STATUS</p>
                <div class="status-line"><span class="status-dot @GetStatusClass()" aria-hidden="true"></span><strong>@GetStatusTitle()</strong></div>
                <span>@GetStatusDetail()</span>
            </div>
            <div class="runtime-actions"><button class="secondary-button" type="button" @onclick="OpenConfiguration">Backend konfigurieren</button><button class="primary-button" type="button" @onclick="OpenChat" disabled="@(!status.IsModelLoaded)">Chat öffnen</button></div>
        </section>
    }

    <nav class="model-tabs" aria-label="Model library views">
        <button class="model-tab @(activeTab == ModelTab.Library ? "active" : "")" type="button" @onclick="() => activeTab = ModelTab.Library">Meine Model Library</button>
        <button class="model-tab @(activeTab == ModelTab.HuggingFace ? "active" : "")" type="button" @onclick="() => activeTab = ModelTab.HuggingFace">Hugging Face suchen</button>
    </nav>

    @if (activeTab == ModelTab.Library)
    {
    <section class="library-section">
        <div class="search-row local-search-row"><span class="count-label">@localModels.Count(model => model.Format == ReferenceModelFormat.Gguf) GGUF · @localModels.Count(model => model.Format == ReferenceModelFormat.OpenVinoIr) OpenVINO</span></div>
        @if (modelDirectories.Count > 0) { <p class="directories">Suche in: @string.Join(" · ", modelDirectories)</p> }
        @if (localModels.Count == 0) { <p class="empty-state">Keine unterstützten Modelle in den konfigurierten Ordnern gefunden.</p> }
        else
        {
            <div class="model-list">
                @foreach (var model in localModels)
                {
                    <article class="model-row @(IsActive(model.Path) ? "selected" : "")"><div class="model-details"><strong>@model.Name</strong><span>@model.Format · @FormatSize(model.SizeInBytes) · @model.Path</span><div class="compatibility-editor"><span class="control-label">Kompatible Backends</span><div class="backend-checkboxes">@foreach (var backend in supportedBackends) { <label><input type="checkbox" checked="@IsCompatible(model, backend)" @onchange="async _ => await SetModelBackendAsync(model, backend)" disabled="@isBusy" /> @GetBackendLabel(backend)</label> }</div><div class="hf-sync-row"><input class="form-control" value="@GetHuggingFaceId(model)" @oninput="eventArgs => SetHuggingFaceId(model.Path, eventArgs.Value?.ToString())" placeholder="owner/repository" /><button class="secondary-button" type="button" @onclick="() => SyncModelBackendAsync(model)" disabled="@isBusy">HF synchronisieren</button></div></div><div class="model-capabilities" aria-label="Provider-Funktionen für @model.Name"><span>Provider</span><label><input type="checkbox" checked="@GetCapabilities(model).ToolCalling" @onchange="(ChangeEventArgs args) => UpdateCapabilitiesAsync(model, ToolCalling: IsChecked(args))" disabled="@isBusy" /> Tool-Aufrufe</label><label><input type="checkbox" checked="@GetCapabilities(model).ImageInput" @onchange="(ChangeEventArgs args) => UpdateCapabilitiesAsync(model, ImageInput: IsChecked(args))" disabled="@isBusy" /> Bildeingabe</label><label><input type="checkbox" checked="@GetCapabilities(model).AgentMode" @onchange="(ChangeEventArgs args) => UpdateCapabilitiesAsync(model, AgentMode: IsChecked(args))" disabled="@isBusy" /> Agent-Modus</label><label><input type="checkbox" checked="@GetCapabilities(model).Thinking" @onchange="(ChangeEventArgs args) => UpdateCapabilitiesAsync(model, Thinking: IsChecked(args))" disabled="@isBusy" /> Thinking</label></div></div><div class="model-actions">@if (model.Format == ReferenceModelFormat.Gguf) { <button class="secondary-button" type="button" @onclick="() => SelectModelAsync(model.Path)">@(IsActive(model.Path) ? "Aktiv" : "Auswählen")</button> } else { <button class="secondary-button" type="button" @onclick="OpenConfiguration">Konfigurieren</button> }<button class="danger-button" type="button" @onclick="() => RequestDeleteModel(model)" disabled="@isBusy">Löschen</button></div></article>
                }
            </div>
        }
    </section>
    }

    @if (activeTab == ModelTab.HuggingFace)
    {
    <section class="library-section remote-section">
        <div class="section-heading"><div><p class="eyebrow">HUGGING FACE</p><h2>Modelle suchen</h2></div></div>
        <div class="search-row"><InputText class="form-control" @bind-Value="searchQuery" placeholder="z. B. Qwen 3" @onkeydown="HandleSearchKeyDown" /><button class="primary-button" type="button" @onclick="SearchAsync" disabled="@isSearching">@(isSearching ? "Suche ..." : "Suchen")</button></div>
        <section class="hf-filter-panel" aria-label="Hugging Face Filter">
            <div class="hf-filter-toolbar">
                <nav class="hf-filter-tabs" aria-label="Filtergruppen">
                    @foreach (var group in Enum.GetValues<FilterGroup>())
                    {
                        <button class="hf-filter-tab @(activeFilter == group ? "active" : "")" type="button" @onclick="() => activeFilter = group">@group</button>
                    }
                </nav>
                <button class="secondary-button" type="button" @onclick="ClearFilters" disabled="@(!HasActiveFilters)">Alle Filter löschen</button>
            </div>
            <div class="hardware-fit-filter">
                <div class="filter-group">
                    <h3>Passend für erkannte Hardware</h3>
                    <div class="filter-options">
                        @foreach (var option in GetHardwareMemoryOptions())
                        {
                            <button class="@GetHardwareMemoryOptionClass(option)" type="button" @onclick="() => SelectHardwareMemory(option.VramBudgetGiB)">@option.Label</button>
                        }
                    </div>
                </div>
                <div class="context-filter">
                    <label for="hf-context-length">Kontextlänge</label>
                    <InputSelect id="hf-context-length" class="form-select" @bind-Value="fitContextLength">
                        @foreach (var size in ContextSizes)
                        {
                            <option value="@size.Value">@size.Label</option>
                        }
                    </InputSelect>
                </div>
            </div>
            @if (activeFilter == FilterGroup.Main)
            {
                <div class="filter-columns">
                    @FilterGroupView("Tasks", mainTaskOptions, searchTask, value => SelectFilter(FilterKind.Task, value))
                    @FilterGroupView("Parameters", parameterOptions, searchParameterRange, value => SelectFilter(FilterKind.ParameterRange, value))
                    @FilterGroupView("Libraries", mainLibraryOptions, searchLibrary, value => SelectFilter(FilterKind.Library, value))
                    @FilterGroupView("Apps", appOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                </div>
                <div class="main-toggles"><label><input type="checkbox" @bind="baseOnly" /> Base only</label><label><input type="checkbox" @bind="inferenceAvailable" /> Inference Available</label><label class="sort-control">Sort <InputSelect @bind-Value="searchSort" @bind-Value:after="SearchAsync"><option value="trending">Trending</option><option value="downloads">Downloads</option><option value="likes">Likes</option><option value="lastModified">Recently updated</option></InputSelect></label></div>
            }
            else if (activeFilter == FilterGroup.Tasks)
            {
                @FilterGroupView("Tasks", taskOptions, searchTask, value => SelectFilter(FilterKind.Task, value))
            }
            else if (activeFilter == FilterGroup.Libraries)
            {
                @FilterGroupView("Libraries", libraryOptions, searchLibrary, value => SelectFilter(FilterKind.Library, value))
            }
            else if (activeFilter == FilterGroup.Languages)
            {
                @FilterGroupView("Languages", languageOptions, searchLanguage, value => SelectFilter(FilterKind.Language, value))
            }
            else if (activeFilter == FilterGroup.Licenses)
            {
                @FilterGroupView("Licenses", licenseOptions, searchLicense, value => SelectFilter(FilterKind.License, value))
            }
            else if (activeFilter == FilterGroup.Hardware)
            {
                @FilterGroupView("Hardware", hardwareOptions, searchHardware, value => SelectFilter(FilterKind.Hardware, value))
            }
            else
            {
                <div class="filter-columns">
                    @FilterGroupView("Model Tree", modelTreeOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                    @FilterGroupView("Apps", appOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                    @FilterGroupView("Inference Providers", inferenceProviderOptions, searchInferenceProvider, value => SelectFilter(FilterKind.InferenceProvider, value))
                    @FilterGroupView("One-click Deployment", deploymentOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                    @FilterGroupView("Misc", miscOptions, searchOther, value => SelectFilter(FilterKind.Other, value))
                </div>
            }
        </section>
        @if (searchResults.Count > 0)
        {
            <div class="model-list">
                @foreach (var model in searchResults)
                {
                    <article class="model-row"><div class="model-details"><strong>@model.Id</strong><span>@model.Downloads Downloads · @model.Likes Likes · @(model.Author ?? "unbekannter Autor")</span><span>Kompatibel: @FormatBackends(model.CompatibleBackends)</span>@if (downloadOptions.TryGetValue(model.Id, out var options)) { <div class="download-options"><span class="download-options-label">Version auswählen</span>@foreach (var option in options) { <button class="filter-option" type="button" @onclick="() => DownloadAsync(model.Id, option.FileName)" disabled="@isBusy">@option.Label</button> }</div> }</div><div class="model-actions">@if (searchLibrary is "gguf" or "openvino") { <button class="secondary-button" type="button" @onclick="() => ChooseDownloadAsync(model.Id)" disabled="@isBusy">@(searchLibrary == "openvino" ? "OpenVINO laden" : "Versionen anzeigen")</button> }<a class="secondary-button" href="https://huggingface.co/@model.Id" target="_blank" rel="noopener noreferrer">Auf Hugging Face öffnen</a></div></article>
                }
            </div>
        }
        else if (hasSearched) { <p class="empty-state">Keine passenden Hugging-Face-Modelle gefunden.</p> }
    </section>
    }

    @if (pendingDeleteModel is not null)
    {
        <div class="dialog-backdrop" role="presentation">
            <section class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-model-title">
                <p class="eyebrow">MODELL ENTFERNEN</p>
                <h2 id="delete-model-title">@pendingDeleteModel.Name löschen?</h2>
                <p>Das Modell wird aus der Library entfernt.</p>
                <label class="delete-files-option"><input type="checkbox" @bind="deleteModelFiles" /> Dateien ebenfalls löschen</label>
                <div class="dialog-actions"><button class="secondary-button" type="button" @onclick="CancelDeleteModel">Abbrechen</button><button class="danger-button" type="button" @onclick="ConfirmDeleteModelAsync">Endgültig löschen</button></div>
            </section>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(message)) { <p class="model-message" role="status">@message</p> }
</div>

<style>
    .models-shell { max-width: 1040px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
    .models-header, .runtime-status, .section-heading, .search-row, .model-row, .download-heading, .download-footer { display: flex; justify-content: space-between; gap: 1rem; }
    .model-tabs { display: flex; gap: .35rem; border-bottom: 1px solid #d9d4ca; margin-top: 1.5rem; }.model-tab { border: 0; border-bottom: 3px solid transparent; background: transparent; color: #756f65; cursor: pointer; font: inherit; font-weight: 700; padding: .8rem 1rem; }.model-tab.active { border-bottom-color: #236b70; color: #236b70; }
    .models-header { align-items: end; margin-bottom: 1.5rem; }
    .runtime-status { align-items: center; border-top: 1px solid #d9d4ca; border-bottom: 1px solid #d9d4ca; margin-bottom: 1.25rem; padding: .85rem 0; }
    .runtime-summary, .model-details, .download-heading { display: grid; gap: .25rem; min-width: 0; }
    .runtime-summary .eyebrow { margin: 0; }.runtime-summary > span, .directories, .model-details span, .download-heading span { color: #756f65; overflow-wrap: anywhere; }
    .status-line { align-items: center; display: flex; gap: .5rem; }.status-dot { background: #8b8377; border-radius: 50%; display: inline-block; flex: 0 0 auto; height: .6rem; width: .6rem; }.status-dot.selected { background: #b5792f; }.status-dot.ready { background: #236b70; }
    .runtime-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
    .library-section { margin-top: 1.25rem; }
    .section-heading { align-items: end; border-bottom: 1px solid #e1dbd1; padding-bottom: .9rem; }
    .section-heading h2 { margin: 0; }.count-label, .download-status { color: #756f65; font-size: .85rem; }.directories { font-size: .85rem; }
    .model-list { display: grid; gap: .65rem; margin-top: 1rem; }.model-row { align-items: center; padding: .9rem 0; border-bottom: 1px solid #e1dbd1; }.model-row:last-child { border-bottom: 0; }.model-row.selected { border-left: 3px solid #236b70; padding-left: .75rem; }.model-details strong { overflow-wrap: anywhere; }.model-huggingface { align-items: end; display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .35rem; }.model-huggingface label { color: #756f65; font-size: .8rem; font-weight: 700; }.model-huggingface .form-control { flex: 1 1 16rem; min-width: 12rem; }.model-backends, .model-capabilities { align-items: center; display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .35rem; }.model-backends span, .model-capabilities span { color: #756f65; font-size: .8rem; font-weight: 700; }.model-backends label, .model-capabilities label { align-items: center; color: #4e4941; display: inline-flex; font-size: .8rem; gap: .3rem; }.model-backends input, .model-capabilities input { accent-color: #236b70; }.download-options { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .5rem; }
    .search-row { margin-top: 1rem; }.search-row .form-control { flex: 1; }.remote-section { background: #f2eee7; }.downloads-section { background: #eef4f0; }.download-row { display: grid; gap: .4rem; padding: .8rem 0; border-bottom: 1px solid #d5dfd8; }.download-footer { align-items: center; }.download-footer .download-status { flex: 1; }progress { width: 100%; height: .7rem; accent-color: #236b70; }.empty-state, .model-message { color: #756f65; }.error-message { color: #7e311f; margin: 0; }.download-options-label { color: #756f65; display: block; font-size: .85rem; font-weight: 700; margin-bottom: .35rem; }
    .hardware-fit-filter { align-items: end; border-top: 1px solid #e1dbd1; display: flex; flex-wrap: wrap; gap: 1.25rem; padding: .75rem 0 1rem; }.hardware-fit-filter .filter-group { flex: 1 1 22rem; }.hardware-fit-filter h3 { margin-bottom: .55rem; }.memory-filter-option { align-items: center; background: #fff; border: 1px solid #e2ddd5; border-radius: .5rem; color: #302d28; cursor: pointer; display: inline-flex; font-size: .85rem; padding: .42rem .6rem; }.memory-filter-option.selected { border-color: #236b70; box-shadow: 0 0 0 1px #236b70; color: #236b70; }.context-filter { align-items: center; display: flex; gap: .45rem; }.context-filter label { color: #756f65; font-size: .85rem; font-weight: 700; }.context-filter .form-select { width: 8rem; }.context-filter span { color: #756f65; font-size: .85rem; }
    .download-files { border-top: 1px solid #d5dfd8; margin-top: .25rem; padding-top: .4rem; }.download-files summary { color: #236b70; cursor: pointer; font-size: .85rem; }.download-file { display: grid; gap: .2rem; margin-top: .55rem; }.download-file span { overflow-wrap: anywhere; }.download-file span:nth-child(2) { color: #756f65; font-size: .8rem; }
    .hf-filter-panel { border-bottom: 1px solid #d9d4ca; }.hf-filter-toolbar { align-items: center; display: flex; gap: .75rem; justify-content: space-between; }.hf-filter-tabs { display: flex; flex: 1; gap: .35rem; min-width: 0; overflow-x: auto; padding: .7rem 0; }.hf-filter-tab { border: 0; border-radius: 999px; background: transparent; color: #756f65; cursor: pointer; font: inherit; padding: .35rem .65rem; white-space: nowrap; }.hf-filter-tab.active { background: #302d28; color: #fff; }.filter-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; padding: .75rem 0 1rem; }.filter-group { min-width: 0; }.filter-group h3 { color: #756f65; font-size: .85rem; font-weight: 500; margin: 0 0 .55rem; }.filter-options { display: flex; flex-wrap: wrap; gap: .45rem; }.filter-option { align-items: center; background: #fff; border: 1px solid #e2ddd5; border-radius: .5rem; color: #302d28; cursor: pointer; display: inline-flex; font-size: .85rem; gap: .35rem; padding: .42rem .6rem; }.filter-option.selected { border-color: #236b70; box-shadow: 0 0 0 1px #236b70; color: #236b70; }.filter-option input { display: none; }.main-toggles { align-items: center; border-top: 1px solid #e1dbd1; display: flex; flex-wrap: wrap; gap: 1rem; padding: .8rem 0 1rem; }.main-toggles label { align-items: center; display: inline-flex; gap: .4rem; font-size: .85rem; }.sort-control select { margin-left: .35rem; }.range-option { display: grid; gap: .35rem; min-width: 10rem; }.range-option span { color: #756f65; font-size: .8rem; }.range-option input { accent-color: #236b70; width: 100%; }
    .primary-button, .secondary-button, .danger-button { border: 0; padding: .7rem 1rem; font-weight: 700; cursor: pointer; }.primary-button { background: #236b70; color: white; }.secondary-button { background: #e7e1d7; color: #302d28; white-space: nowrap; }.danger-button { background: #8a1c1c; color: white; white-space: nowrap; }button:disabled { opacity: .55; cursor: not-allowed; }
    .dialog-backdrop { align-items: center; background: rgba(16, 42, 67, .45); display: flex; inset: 3.5rem 0 0 250px; justify-content: center; padding: 1rem; position: fixed; z-index: 10; }
    .delete-dialog { width: min(100%, 38rem); max-height: min(90vh, 28rem); margin: 0; padding: 1.35rem; overflow: auto; background: #fff; box-shadow: 0 1rem 3rem rgba(16, 42, 67, .2); }
    .delete-dialog .eyebrow { margin: 0; }.delete-dialog h2 { margin: .35rem 0 0; }.delete-dialog p:not(.eyebrow) { color: #4e4941; }.delete-files-option { align-items: center; display: inline-flex; gap: .4rem; margin-top: .5rem; }.delete-files-option input { accent-color: #236b70; }.dialog-actions { display: flex; flex-wrap: wrap; gap: .65rem; justify-content: flex-end; margin-top: 1.25rem; }
    @@media (max-width: 640.98px) { .dialog-backdrop { inset: 0; } }
    @@media (max-width: 680px) { .models-header, .runtime-status, .model-row, .search-row { align-items: stretch; flex-direction: column; } .filter-columns { grid-template-columns: 1fr; }.secondary-button, .primary-button { width: 100%; } }
</style>

@code {
    private readonly List<LocalModel> localModels = [];
    private readonly List<HuggingFaceModel> searchResults = [];
    private readonly Dictionary<Guid, DownloadStatus> downloads = [];
    private readonly Dictionary<string, IReadOnlyList<ModelDownloadOption>> downloadOptions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> huggingFaceIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<string> modelDirectories = [];
    private static readonly ConfigurationBackend[] supportedBackends = Enum.GetValues<ConfigurationBackend>();
    private string searchQuery = string.Empty;
    private string searchLibrary = "gguf";
    private string searchTask = string.Empty;
    private string searchLanguage = string.Empty;
    private string searchLicense = string.Empty;
    private string searchHardware = string.Empty;
    private string searchOther = string.Empty;
    private string searchInferenceProvider = string.Empty;
    private string searchParameterRange = string.Empty;
    private string searchSort = "trending";
    private readonly List<VulkanDeviceStatus> detectedHardware = [];
    private int? fitVramBudgetGiB;
    private int fitContextLength = 131_072;
    private static readonly (string Label, int Value)[] ContextSizes =
    [
        ("32k", 32_768), ("40k", 40_960), ("48k", 49_152), ("56k", 57_344),
        ("64k", 65_536), ("72k", 73_728), ("80k", 81_920), ("88k", 90_112),
        ("96k", 98_304), ("104k", 106_496), ("112k", 114_688), ("120k", 122_880),
        ("128k", 131_072), ("136k", 139_264), ("144k", 147_456), ("152k", 155_648),
        ("160k", 163_840), ("168k", 172_032), ("176k", 180_224), ("184k", 188_416),
        ("192k", 196_608), ("200k", 204_800), ("208k", 212_992), ("216k", 221_184),
        ("224k", 229_376), ("232k", 237_568), ("240k", 245_760), ("248k", 253_952),
        ("256k", 262_144), ("512k", 524_288), ("1m", 1_048_576)
    ];
    private bool baseOnly, inferenceAvailable;
    private FilterGroup activeFilter = FilterGroup.Main;
    private ModelTab activeTab = ModelTab.Library;
    private bool isBusy, isSearching, hasSearched;
    private string? message;
    private ModelStatus? status;
    private LocalModel? pendingDeleteModel;
    private bool deleteModelFiles;

    protected override async Task OnInitializedAsync() { DownloadEvents.ModelDownload_Create += HandleModelDownloadChangedAsync; DownloadEvents.ModelDownload_Update += HandleModelDownloadChangedAsync; DownloadEvents.ModelDownload_Delete += HandleModelDownloadChangedAsync; await LoadStatusAsync(); await ScanLocalAsync(); modelDirectories.AddRange(await DataService.ModelDirectory_ReadAsync()); }
    private async Task ScanLocalAsync() { try { var models = await DataService.LocalModel_ReadAsync(); localModels.Clear(); localModels.AddRange(models); huggingFaceIds.Clear(); foreach (var model in models) if (!string.IsNullOrWhiteSpace(model.HuggingFaceModelId)) huggingFaceIds[model.Path] = model.HuggingFaceModelId; } catch (Exception) { message = "Die lokalen Modelle konnten nicht gelesen werden."; } }
    private async Task SearchAsync() { isSearching = true; hasSearched = true; message = null; try { searchResults.Clear(); var contextLength = (uint)Math.Clamp(fitContextLength, 1_024, 1_048_576); searchResults.AddRange(await DataService.SearchModelsAsync(new HuggingFaceSearchRequest(searchQuery.Trim(), Libraries: [searchLibrary], Tasks: FilterValues(searchTask), ParameterRanges: FilterValues(searchParameterRange), Languages: FilterValues(searchLanguage), Licenses: FilterValues(searchLicense), Hardware: FilterValues(searchHardware), Other: FilterValues(searchOther), InferenceProviders: FilterValues(searchInferenceProvider), BaseOnly: baseOnly, InferenceAvailable: inferenceAvailable, Sort: searchSort, VramBudgetGiB: fitVramBudgetGiB, ContextLength: fitVramBudgetGiB is > 0 ? contextLength : null))); } catch (Exception) { message = "Die Hugging-Face-Suche ist fehlgeschlagen."; } finally { isSearching = false; } }
    private async Task ChooseDownloadAsync(string modelId) { if (searchLibrary == "openvino") { await DownloadAsync(modelId, null); return; } try { isBusy = true; message = null; var options = await DataService.ModelDownload_ReadOptionsAsync(modelId, searchLibrary); if (options.Count == 1) await DownloadAsync(modelId, options[0].FileName); else downloadOptions[modelId] = options; } catch (Exception exception) { message = exception.Message; } finally { isBusy = false; } }
    private async Task DownloadAsync(string modelId, string? fileName) { isBusy = true; message = null; try { await DataService.ModelDownload_CreateAsync(new ModelDownloadRequest(modelId, fileName, searchLibrary)); downloadOptions.Remove(modelId); } catch (Exception exception) { message = exception.Message; } finally { isBusy = false; } }
    private async Task SyncHuggingFaceAsync(LocalModel model) => await SyncModelBackendAsync(model);
    private async Task SetModelBackendAsync(LocalModel model, ConfigurationBackend backend) { var compatibleBackends = (model.CompatibleBackends ?? []).ToHashSet(); if (!compatibleBackends.Add(backend)) compatibleBackends.Remove(backend); var values = compatibleBackends.OrderBy(value => value).ToArray(); try { var models = await DataService.LocalModel_UpdateAsync(new ModelCompatibilityUpdate(model.Path, values, GetHuggingFaceId(model), GetCapabilities(model))); ReplaceLocalModels(models); message = "Backend-Kompatibilität gespeichert."; } catch (Exception exception) { message = exception.Message; } }
    private async Task SyncModelBackendAsync(LocalModel model) { var huggingFaceId = GetHuggingFaceId(model).Trim(); if (string.IsNullOrWhiteSpace(huggingFaceId)) { message = "Bitte zuerst eine Hugging-Face-ID angeben."; return; } try { isBusy = true; var models = await DataService.LocalModel_UpdateAsync(model.Path, huggingFaceId); ReplaceLocalModels(models); message = "Backend-Kompatibilität mit Hugging Face synchronisiert."; } catch (Exception exception) { message = exception.Message; } finally { isBusy = false; } }
    private async Task PauseDownloadAsync(Guid id) { try { await DataService.ModelDownload_UpdateAsync(id, paused: true); } catch (Exception exception) { message = exception.Message; } }
    private async Task ResumeDownloadAsync(Guid id) { try { await DataService.ModelDownload_UpdateAsync(id, paused: false); } catch (Exception exception) { message = exception.Message; } }
    private async Task HandleModelDownloadChangedAsync(ModelDownloadUpdate update) { await InvokeAsync(() => { if (update.Cancelled) downloads.Remove(update.Download.Id); else downloads[update.Download.Id] = update.Download; if (update.LocalModels is not null) { localModels.Clear(); localModels.AddRange(update.LocalModels); } StateHasChanged(); }); }
    private async Task UpdateBackendAsync(LocalModel model, ConfigurationBackend backend, bool enabled) { isBusy = true; message = null; try { var backends = (model.CompatibleBackends ?? []).Where(item => item != backend).ToList(); if (enabled) backends.Add(backend); var models = await DataService.LocalModel_UpdateAsync(new ModelCompatibilityUpdate(model.Path, backends, model.HuggingFaceModelId, GetCapabilities(model))); localModels.Clear(); localModels.AddRange(models); } catch (Exception) { message = "Die Backend-Zuordnung konnte nicht gespeichert werden."; } finally { isBusy = false; } }
    private async Task UpdateCapabilitiesAsync(LocalModel model, bool? ToolCalling = null, bool? ImageInput = null, bool? AgentMode = null, bool? Thinking = null) { isBusy = true; message = null; try { var current = GetCapabilities(model); var updated = new ModelCapabilities(ToolCalling ?? current.ToolCalling, ImageInput ?? current.ImageInput, AgentMode ?? current.AgentMode, Thinking ?? current.Thinking); var models = await DataService.LocalModel_UpdateAsync(new ModelCompatibilityUpdate(model.Path, null, model.HuggingFaceModelId, updated)); localModels.Clear(); localModels.AddRange(models); } catch (Exception) { message = "Die Provider-Funktionen konnten nicht gespeichert werden."; } finally { isBusy = false; } }
    private void RequestDeleteModel(LocalModel model) { pendingDeleteModel = model; deleteModelFiles = false; message = null; }
    private void CancelDeleteModel() { pendingDeleteModel = null; deleteModelFiles = false; }
    private async Task ConfirmDeleteModelAsync() { if (pendingDeleteModel is null) return; var model = pendingDeleteModel; try { isBusy = true; var models = await DataService.LocalModel_DeleteAsync(new ModelDeletionRequest(model.Path, deleteModelFiles)); ReplaceLocalModels(models); message = deleteModelFiles ? "Modell und Dateien gelöscht." : "Modell aus der Library entfernt; Dateien behalten."; pendingDeleteModel = null; } catch (Exception exception) { message = exception.Message; } finally { isBusy = false; } }
    private void ReplaceLocalModels(IEnumerable<LocalModel> models) { localModels.Clear(); huggingFaceIds.Clear(); foreach (var model in models) { localModels.Add(model); huggingFaceIds[model.Path] = model.HuggingFaceModelId ?? string.Empty; } }
    private async Task SelectModelAsync(string path) { try { status = await DataService.SelectModelAsync(new SelectModelRequest(path)); message = "Modell als aktives Chat-Modell ausgewählt. Jetzt unter LLama laden."; } catch (Exception) { message = "Das Modell konnte nicht ausgewählt werden."; } }
