    private RenderFragment FilterGroupView(string title, IReadOnlyList<FilterOption> options, IReadOnlySet<string> selectedValues, Action<string> onSelected) => builder =>
    {
        builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "filter-group"); builder.OpenElement(2, "h3"); builder.AddContent(3, title); builder.CloseElement(); builder.OpenElement(4, "div"); builder.AddAttribute(5, "class", "filter-options"); var sequence = 6; foreach (var option in options) { builder.OpenElement(sequence++, "button"); builder.AddAttribute(sequence++, "class", FilterOptionClass(option, selectedValues)); builder.AddAttribute(sequence++, "type", "button"); builder.AddAttribute(sequence++, "aria-pressed", selectedValues.Contains(option.Value)); builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => onSelected(option.Value))); builder.AddContent(sequence++, option.Label); builder.CloseElement(); } builder.CloseElement(); builder.CloseElement();
    };
