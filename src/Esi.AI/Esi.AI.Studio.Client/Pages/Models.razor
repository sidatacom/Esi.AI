    private void SelectHardwareMemory(int? vramBudgetGiB) => fitVramBudgetGiB = vramBudgetGiB;
    private IReadOnlyList<HardwareMemoryOption> GetHardwareMemoryOptions()
    {
        var options = new List<HardwareMemoryOption> { new("None", null) };
        var devices = detectedHardware.Where(device => device.MemoryCapacityMiB is > 0).ToArray();
        options.AddRange(devices.Select(device => new HardwareMemoryOption($"{device.Description ?? device.Name} · {FormatMemoryGiB(device.MemoryCapacityMiB!.Value)} GB", (int)Math.Round(device.MemoryCapacityMiB.Value / 1024d, MidpointRounding.AwayFromZero))));
        if (devices.Length > 1)
            options.Add(new HardwareMemoryOption($"Gesamt · {FormatMemoryGiB(devices.Sum(device => device.MemoryCapacityMiB!.Value))} GB", (int)Math.Round(devices.Sum(device => device.MemoryCapacityMiB!.Value) / 1024d, MidpointRounding.AwayFromZero)));
        return options;
    }
    private string GetHardwareMemoryOptionClass(HardwareMemoryOption option) => option.VramBudgetGiB == fitVramBudgetGiB ? "memory-filter-option selected" : "memory-filter-option";
    private static int FormatMemoryGiB(double memoryMiB) => (int)Math.Round(memoryMiB / 1024d, MidpointRounding.AwayFromZero);
    private static bool IsExcludedHardware(string deviceName) => deviceName.Contains("UHD Graphics 630", StringComparison.OrdinalIgnoreCase);
    private void SelectFilter(FilterKind kind, string value) { switch (kind) { case FilterKind.Library: searchLibrary = ToggleFilterValue(searchLibrary, value); break; case FilterKind.Task: searchTask = ToggleFilterValue(searchTask, value); break; case FilterKind.ParameterRange: searchParameterRange = ToggleFilterValue(searchParameterRange, value); break; case FilterKind.Language: searchLanguage = ToggleFilterValue(searchLanguage, value); break; case FilterKind.License: searchLicense = ToggleFilterValue(searchLicense, value); break; case FilterKind.Hardware: searchHardware = ToggleFilterValue(searchHardware, value); break; case FilterKind.Other: searchOther = ToggleFilterValue(searchOther, value); break; case FilterKind.InferenceProvider: searchInferenceProvider = ToggleFilterValue(searchInferenceProvider, value); break; } }
    private static string ToggleFilterValue(string selectedValue, string value) => string.Equals(selectedValue, value, StringComparison.Ordinal) ? string.Empty : value;
    private static IReadOnlyList<string> FilterValues(string value) => string.IsNullOrWhiteSpace(value) ? [] : [value];
