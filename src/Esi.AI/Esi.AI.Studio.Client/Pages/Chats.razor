@page "/chats"
@rendermode InteractiveWebAssembly
@using Esi.AI.Models
@inject IDataService DataService

<PageTitle>Chats</PageTitle>

<div class="chat-layout">
    <aside class="chat-sidebar">
        <div class="sidebar-heading"><div><p class="eyebrow">ARCHIVE</p><h2>Chats</h2></div><button class="new-button" type="button" @onclick="NewChatAsync" disabled="@isSending" title="Neuen Chat erstellen">+</button></div>
        <div class="chat-list">
            @foreach (var chat in chatSummaries)
            {
                <button class="chat-list-item @(chat.Id == currentChat?.Id ? "active" : "")" type="button" @onclick="() => SelectChatAsync(chat.Id)"><strong>@chat.Title</strong><span>@chat.MessageCount Nachrichten</span></button>
            }
        </div>
    </aside>

    <main class="chat-main">
            <header class="chat-header"><div><p class="eyebrow">LOCAL CONVERSATION</p><h1>@(currentChat?.Title ?? "Chats")</h1><p class="lede">Gespräche mit einem ausgewählten geladenen Modell.</p></div>@if (currentChat is not null) { <label class="model-picker" for="chat-model">Modell<select id="chat-model" value="@selectedModelKey" @onchange="SelectModel" disabled="@isSending"><option value="">Modell auswählen ...</option>@foreach (var model in loadedModels) { <option value="@GetModelKey(model)">@Path.GetFileNameWithoutExtension(model.ModelPath) (@model.Backend)</option>}</select></label> }</header>
        @if (currentChat is null)
        {
            <section class="chat-empty-page"><strong>Bereit für eine neue Unterhaltung.</strong><button class="send-button" type="button" @onclick="NewChatAsync">Neuen Chat starten</button></section>
        }
        else
        {
            <section class="chat-panel" aria-busy="@isSending">
                <div class="message-list">
                    @if (currentChat.Messages.Count == 0) { <div class="chat-empty"><strong>Bereit für deine erste Nachricht.</strong><span>Die Unterhaltung wird automatisch gespeichert.</span></div> }
                    @foreach (var message in currentChat.Messages) { <article class="chat-message @message.Role"><div class="message-header"><span class="message-role">@(message.Role == "user" ? "Du" : "Assistant")</span></div>@if (message.Role == "assistant") { <div class="message-meta">@if (!string.IsNullOrWhiteSpace(message.Backend)) { <span>Backend: @message.Backend</span> }@if (message.ModelPath is not null) { <span>Model: @Path.GetFileNameWithoutExtension(message.ModelPath)</span> }</div> }@if (message.Role == "assistant" && message.TokenCount is not null) { <div class="generation-stats">@message.TokenCount tokens · @message.TokensPerSecond?.ToString("F1") tok/s</div> }<p>@DisplayContent(message)</p></article> }
                    @if (isSending) { <article class="chat-message assistant pending"><span class="message-role">Assistant</span><p>Denke nach ...</p></article> }
                </div>
                <div class="chat-composer"><label for="chat-input">Nachricht</label><InputTextArea id="chat-input" class="form-control" @bind-Value="composer.Content" rows="4" disabled="@isSending" /><div class="composer-footer"><span>@(statusMessage ?? "")</span><button class="send-button" type="button" @onclick="SendAsync" disabled="@(isSending || string.IsNullOrWhiteSpace(composer.Content) || string.IsNullOrWhiteSpace(selectedModelPath))">@(isSending ? "Antwort wird erstellt ..." : "Senden")</button></div></div>
            </section>
        }
    </main>
</div>

<style>
    .chat-layout { display: grid; grid-template-columns: 16rem minmax(0, 1fr); gap: 2rem; max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
    .chat-sidebar { border-right: 1px solid #d9d4ca; padding-right: 1rem; }.sidebar-heading, .chat-header, .composer-footer { display: flex; justify-content: space-between; align-items: end; gap: 1rem; }.sidebar-heading h2 { margin: 0; }.new-button { border: 0; background: #236b70; color: white; width: 2rem; height: 2rem; font-size: 1.3rem; cursor: pointer; }.model-picker { display: grid; gap: .35rem; min-width: 14rem; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }.model-picker select { border: 1px solid #d9d4ca; background: #fbfaf6; color: #302d28; padding: .65rem; font: inherit; text-transform: none; letter-spacing: 0; }
    .chat-list { display: grid; gap: .35rem; margin-top: 1.25rem; }.chat-list-item { display: grid; gap: .25rem; text-align: left; border: 0; border-left: 3px solid transparent; background: transparent; padding: .75rem; cursor: pointer; color: #302d28; }.chat-list-item span { color: #756f65; font-size: .78rem; }.chat-list-item.active { border-left-color: #236b70; background: #e2eeee; }.chat-main { min-width: 0; }.chat-header { margin-bottom: 1.5rem; }.chat-panel { border: 1px solid #d9d4ca; background: #fbfaf6; }.message-list { min-height: 30rem; padding: 1.5rem; display: grid; align-content: start; gap: 1rem; }.chat-empty, .chat-empty-page { min-height: 26rem; display: grid; place-content: center; text-align: center; color: #756f65; gap: .7rem; }.chat-message { max-width: 76%; padding: .9rem 1rem; border-left: 3px solid #b65b38; background: #f0ece4; }.chat-message.user { justify-self: end; border-left: 0; border-right: 3px solid #236b70; background: #e2eeee; }.message-header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }.message-meta { display: flex; flex-wrap: wrap; gap: .35rem .8rem; color: #236b70; font-size: .72rem; font-weight: 700; }.generation-stats { color: #756f65; font-size: .72rem; white-space: nowrap; }.chat-message p { white-space: pre-wrap; margin: .35rem 0 0; }.message-role, .eyebrow { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #665f54; }.pending { opacity: .65; }.chat-composer { border-top: 1px solid #d9d4ca; padding: 1rem 1.5rem 1.5rem; }.chat-composer label { display: block; font-weight: 700; margin-bottom: .4rem; }.composer-footer { margin-top: .75rem; color: #756f65; font-size: .85rem; }.send-button { border: 0; background: #236b70; color: white; padding: .7rem 1rem; font-weight: 700; cursor: pointer; }.send-button:disabled { opacity: .55; cursor: not-allowed; }
    @@media (max-width: 720px) { .chat-layout { grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem .75rem 3rem; }.chat-sidebar { border-right: 0; border-bottom: 1px solid #d9d4ca; padding: 0 0 1rem; }.chat-list { display: flex; overflow-x: auto; }.chat-list-item { min-width: 12rem; }.chat-header, .composer-footer { align-items: stretch; flex-direction: column; }.chat-message { max-width: 94%; }.send-button { width: 100%; } }
</style>

@code {
    private readonly List<ChatSummary> chatSummaries = [];
    private readonly List<LoadedModelStatus> loadedModels = [];
    private readonly Composer composer = new();
    private PersistedChat? currentChat;
    private bool isSending;
    private string? statusMessage;
    private string? selectedModelPath;
    private string? selectedBackend;
    private string? selectedModelKey;

    protected override async Task OnInitializedAsync() { await LoadLoadedModelsAsync(); await LoadChatsAsync(); if (chatSummaries.Count > 0) await SelectChatAsync(chatSummaries[0].Id); else await NewChatAsync(); }
    private async Task LoadLoadedModelsAsync()
    {
        var llamaStatus = await DataService.GetModelStatusAsync();
        var openVinoStatus = await DataService.GetOpenVinoModelStatusAsync();
        loadedModels.Clear();
        loadedModels.AddRange(llamaStatus.LoadedModels);
        if (openVinoStatus.IsModelLoaded && openVinoStatus.ModelPath is not null &&
            !loadedModels.Any(model => string.Equals(model.ModelPath, openVinoStatus.ModelPath, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(model.Backend, "OpenVINO", StringComparison.OrdinalIgnoreCase)))
        {
            loadedModels.Add(new LoadedModelStatus(openVinoStatus.ModelPath, "OpenVINO", 0, 0, openVinoStatus.ModelSizeInBytes, [], null));
        }

        var selectedModel = loadedModels.FirstOrDefault();
        SetSelectedModel(selectedModel);
    }
    private void SelectModel(ChangeEventArgs args)
    {
        var selectedModel = loadedModels.FirstOrDefault(model => string.Equals(GetModelKey(model), args.Value?.ToString(), StringComparison.Ordinal));
        SetSelectedModel(selectedModel);
    }
    private void SetSelectedModel(LoadedModelStatus? model)
    {
        selectedModelPath = model?.ModelPath;
        selectedBackend = model?.Backend;
        selectedModelKey = model is null ? null : GetModelKey(model);
    }
    private static string GetModelKey(LoadedModelStatus model) => $"{model.Backend}|{model.ModelPath}";
    private static string DisplayContent(PersistedChatMessage message)
    {
        if (message.Role != "assistant")
            return message.Content;

        var content = message.Content.Trim();
        if (content.StartsWith("Assistant:", StringComparison.OrdinalIgnoreCase))
            content = content["Assistant:".Length..].TrimStart();
        return string.Equals(content, "User:", StringComparison.OrdinalIgnoreCase)
            ? "Keine Antwort vom Modell erhalten."
            : content;
    }
    private async Task LoadChatsAsync() { chatSummaries.Clear(); chatSummaries.AddRange(await DataService.GetChatSummariesAsync()); }
    private async Task NewChatAsync() { currentChat = await DataService.CreateChatAsync(new CreateChatRequest()); SetSelectedModel(loadedModels.FirstOrDefault()); await LoadChatsAsync(); statusMessage = null; }
    private async Task SelectChatAsync(Guid id) { currentChat = await DataService.GetChatAsync(id); composer.Content = string.Empty; statusMessage = null; }
    private async Task SendAsync() { if (currentChat is null || string.IsNullOrWhiteSpace(composer.Content) || string.IsNullOrWhiteSpace(selectedModelPath) || string.IsNullOrWhiteSpace(selectedBackend) || isSending) return; isSending = true; statusMessage = null; var content = composer.Content.Trim(); composer.Content = string.Empty; try { currentChat = await DataService.AddChatExchangeAsync(currentChat.Id, new ChatExchangeRequest(content, selectedModelPath, selectedBackend)); await LoadChatsAsync(); } catch (Exception exception) { statusMessage = exception.Message; composer.Content = content; } finally { isSending = false; } }
    private sealed class Composer { public string Content { get; set; } = string.Empty; }
}
