    private async Task InitializeAsync()
    {
        try
        {
            var savedSettings = await DataService.GetLlamaSettingsAsync();
            var savedOpenVinoSettings = await DataService.GetOpenVinoSettingsAsync();
            openVinoDiagnostics = await DataService.GetDiagnosticsAsync();
            SyncOpenVinoDevices();
            if (savedSettings is not null && !IsOpenVinoModelPath(savedSettings.ModelPath))
            {
                form.ModelPath = savedSettings.ModelPath;
                form.Backend = savedSettings.Backend;
                form.GpuLayerCount = savedSettings.GpuLayerCount;
                form.ContextSize = savedSettings.ContextSize;
                advanced.Load(savedSettings.Advanced);
                form.VulkanDevices.Clear();
                foreach (var device in savedSettings.VulkanDevices)
                    form.VulkanDevices[device.Key] = device.Value;
            }
            databaseModels = await DataService.ScanLlamaModelsAsync();
            profiles = await DataService.GetModelConfigurationProfilesAsync();
            if (savedOpenVinoSettings is not null)
                openVinoForm.Load(savedOpenVinoSettings);

            var legacyOpenVinoPath = savedOpenVinoSettings?.ModelPath ??
                (savedSettings is not null && IsOpenVinoModelPath(savedSettings.ModelPath) ? savedSettings.ModelPath : string.Empty);
            if (savedOpenVinoSettings is null && !string.IsNullOrWhiteSpace(legacyOpenVinoPath))
            {
                openVinoForm.ModelPath = legacyOpenVinoPath;
                await DataService.SaveOpenVinoSettingsAsync(openVinoForm.ToSettings());
            }

            var savedOpenVinoPath = !string.IsNullOrWhiteSpace(openVinoForm.ModelPath);
            activeBackend = savedOpenVinoPath ? BackendTab.OpenVino : BackendTab.Llama;
            backendModels = await DataService.GetBackendModelsAsync(GetConfigurationBackend(activeBackend));
            var activeModelPath = activeBackend == BackendTab.OpenVino ? openVinoForm.ModelPath : form.ModelPath;
            var preferredProfile = GetPreferredProfile(activeModelPath, activeBackend == BackendTab.OpenVino ? ConfigurationBackend.OpenVino : ConfigurationBackend.Llama);
            if (preferredProfile is not null)
                TryApplyProfile(preferredProfile);
            else
                selectedProfileId = null;
            loadStatus = await DataService.GetModelStatusAsync();
            var openVinoModelStatus = await DataService.GetOpenVinoModelStatusAsync();
            isOpenVinoModelLoaded = openVinoModelStatus.IsModelLoaded;
            openVinoLoadLog = openVinoModelStatus.LoadLog;
            if (openVinoModelStatus.IsModelLoaded && !string.IsNullOrWhiteSpace(openVinoModelStatus.ModelPath))
                openVinoForm.ModelPath = openVinoModelStatus.ModelPath;
            if (openVinoModelStatus.IsModelLoaded && !string.IsNullOrWhiteSpace(openVinoModelStatus.Device))
                openVinoForm.Device = openVinoModelStatus.Device;
            await RefreshBackendPrerequisitesAsync();
        }
        catch (Exception exception)
        {
            statusMessage = $"Initialization failed: {exception.Message}";
        }
        isInitializing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadModelAsync()
    {
        if (string.IsNullOrWhiteSpace(form.ModelPath) || !string.Equals(Path.GetExtension(form.ModelPath), ".gguf", StringComparison.OrdinalIgnoreCase))
        {
            statusMessage = "Select or enter a .gguf model path first.";
            return;
        }

        isLoading = true;
        statusMessage = null;
        loadLog = string.Empty;

        try
        {
            var request = new LoadModelRequest(
                form.ModelPath,
                form.Backend,
                form.GpuLayerCount,
                form.ContextSize,
                GetVulkanWeightsForLoad(),
                advanced.ToSettings());
            await SaveSettingsAsync();
            var loadTask = DataService.LoadModelAsync(request);
            while (!loadTask.IsCompleted)
            {
                await Task.Delay(250);
                loadStatus = await DataService.GetModelStatusAsync();
                loadLog = loadStatus.LoadLog;
                await InvokeAsync(StateHasChanged);
            }

            loadStatus = await loadTask;
            loadLog = loadStatus.LoadLog;
            SyncEnabledDevices();
            statusMessage = $"Loaded: {form.ModelPath}";
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Loading was cancelled.";
        }
        catch (ArgumentException)
        {
            statusMessage = "Enter a valid GGUF model path and GPU layer count.";
        }
        catch (FileNotFoundException)
        {
            statusMessage = "The specified model file was not found.";
        }
        catch (Exception)
        {
            statusMessage = "The model could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

