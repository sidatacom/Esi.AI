    {
        ConfigurationBackend.Llama => "LLama",
        ConfigurationBackend.OpenVino => "OpenVINO",
        ConfigurationBackend.Vllm => "vLLM",
        ConfigurationBackend.Sglang => "SGLang",
        ConfigurationBackend.DotLlm => "dotLLM",
        _ => backend.ToString()
    };

    private ConfigurationBackend CurrentProfileBackend => activeBackend switch
    {
        BackendTab.Llama => ConfigurationBackend.Llama,
        BackendTab.OpenVino => ConfigurationBackend.OpenVino,
        BackendTab.Vllm => ConfigurationBackend.Vllm,
        BackendTab.Sglang => ConfigurationBackend.Sglang,
        BackendTab.DotLlm => ConfigurationBackend.DotLlm,
        _ => ConfigurationBackend.Llama
    };

    private ConfigurationBackend GetConfigurationBackend(BackendTab backend) => backend switch
    {
        BackendTab.Llama => ConfigurationBackend.Llama,
        BackendTab.OpenVino => ConfigurationBackend.OpenVino,
        BackendTab.Vllm => ConfigurationBackend.Vllm,
        BackendTab.Sglang => ConfigurationBackend.Sglang,
        BackendTab.DotLlm => ConfigurationBackend.DotLlm,
        _ => ConfigurationBackend.Llama
    };

    private static bool IsPythonBackendTab(BackendTab backend) => backend is BackendTab.Vllm or BackendTab.Sglang;

    private IEnumerable<ModelConfiguration> BackendProfiles =>
        profiles.Where(profile => profile.Backend == CurrentProfileBackend);

    private ModelConfiguration? GetPreferredProfile(string modelPath, ConfigurationBackend backend)
    {
        var model = databaseModels.FirstOrDefault(item =>
            string.Equals(item.Path, modelPath.Trim(), StringComparison.OrdinalIgnoreCase));
        var storedProfile = model?.ConfigurationId is Guid profileId
            ? profiles.FirstOrDefault(profile => profile.Id == profileId && profile.Backend == backend &&
                string.Equals(profile.ModelPath.Trim(), modelPath.Trim(), StringComparison.OrdinalIgnoreCase))
            : null;
        var matchingProfiles = profiles
            .Where(profile => profile.Backend == backend &&
                string.Equals(profile.ModelPath.Trim(), modelPath.Trim(), StringComparison.OrdinalIgnoreCase));
        return storedProfile ?? matchingProfiles
            .OrderByDescending(profile => profile.IsDefault)
            .ThenByDescending(profile => profile.UpdatedAtUtc)
            .FirstOrDefault();
    }

    private async Task SelectSharedModelAsync(ChangeEventArgs args)
    {
        var modelPath = args.Value?.ToString() ?? string.Empty;
        SetModelPath(activeBackend, modelPath);

        var profile = GetPreferredProfile(modelPath, CurrentProfileBackend);
        if (profile is not null)
            TryApplyProfile(profile);
        else
        {
            selectedProfileId = null;
            ResetActiveBackendConfiguration();
        }

        await PersistSelectedProfileAsync(modelPath, selectedProfileId);
        await SaveSettingsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void SetModelPath(BackendTab backend, string modelPath)
    {
        switch (backend)
        {
            case BackendTab.Llama:
                llamaState.ModelPath = modelPath;
                break;
            case BackendTab.OpenVino:
                openVinoState.ModelPath = modelPath;
                break;
            case BackendTab.DotLlm:
                dotLlmForm.ModelPath = modelPath;
                break;
            default:
                pythonForm.ModelPath = modelPath;
                break;
        }
    }

    private void ResetActiveBackendConfiguration()
    {
        switch (activeBackend)
        {
            case BackendTab.Llama:
                ResetModelConfiguration();
                break;
            case BackendTab.OpenVino:
                ResetOpenVinoConfiguration();
                break;
            case BackendTab.Vllm:
            case BackendTab.Sglang:
                pythonForm.Reset();
                break;
            case BackendTab.DotLlm:
                dotLlmForm.Reset();
                break;
        }
    }

    private bool TryApplyProfile(ModelConfiguration profile)
    {
        try
        {
            isApplyingProfile = true;
            selectedProfileId = profile.Id;
            selectedProfileName = profile.Name;
            selectedProfileAutoLaunch = profile.AutoLaunch;
            ApplyProfileTimeout(profile.InferenceTimeout);
            profileTargetModelPath = profile.ModelPath;
            activeBackend = profile.Backend switch
            {
                ConfigurationBackend.OpenVino => BackendTab.OpenVino,
                ConfigurationBackend.Vllm => BackendTab.Vllm,
                ConfigurationBackend.Sglang => BackendTab.Sglang,
                ConfigurationBackend.DotLlm => BackendTab.DotLlm,
                _ => BackendTab.Llama
            };
            switch (profile.Backend)
            {
                case ConfigurationBackend.OpenVino:
                    openVinoState.Load(new ModelSettings(profile.ModelPath, profile.Backend, profile.ConfigurationJson));
                    EnsureOpenVinoDeviceRoute();
                    break;
                case ConfigurationBackend.Vllm:
                case ConfigurationBackend.Sglang:
                    pythonForm.Load(JsonSerializer.Deserialize<PythonInferenceLoadRequest>(profile.ConfigurationJson) ?? throw new JsonException());
                    break;
                case ConfigurationBackend.DotLlm:
                    dotLlmForm.Load(JsonSerializer.Deserialize<DotLlmLoadRequest>(profile.ConfigurationJson) ?? throw new JsonException());
                    break;
                default:
                    ApplySettings(JsonSerializer.Deserialize<LoadModelRequest>(profile.ConfigurationJson) ?? throw new JsonException());
                    break;
            }
            SetModelPath(activeBackend, profile.ModelPath);
            return true;
        }
        catch (JsonException)
        {
            selectedProfileId = null;
            if (profile.Backend == ConfigurationBackend.OpenVino)
                openVinoStatus = "The selected OpenVINO configuration set is invalid.";
            else
                statusMessage = "The selected configuration set is invalid.";
            return false;
        }
        finally
        {
            isApplyingProfile = false;
        }
    }

    private async Task PersistSelectedProfileAsync(string modelPath, Guid? profileId)
    {
        if (string.IsNullOrWhiteSpace(modelPath))
            return;

        await DataService.SetModelConfigurationAsync(modelPath, profileId);
        databaseModels = databaseModels.Select(model =>
            string.Equals(model.Path, modelPath.Trim(), StringComparison.OrdinalIgnoreCase)
                ? model with { ConfigurationId = profileId }
                : model).ToArray();
    }

    private async Task PersistCurrentProfileSettingsAsync()
    {
        if (!selectedProfileId.HasValue || string.IsNullOrWhiteSpace(CurrentModelPath))
            return;

        var profile = profiles.FirstOrDefault(item => item.Id == selectedProfileId.Value &&
            item.Backend == CurrentProfileBackend &&
            string.Equals(item.ModelPath.Trim(), CurrentModelPath.Trim(), StringComparison.OrdinalIgnoreCase));
        if (profile is null)
            return;

        var saved = await DataService.ModelConfiguration_UpdateAsync(profile with
        {
            Name = selectedProfileName.Trim(),
            ModelPath = CurrentModelPath.Trim(),
            ConfigurationJson = SerializeCurrentSettings(),
            Backend = CurrentProfileBackend,
            InferenceTimeout = CreateProfileTimeoutSettings(),
            AutoLaunch = selectedProfileAutoLaunch
        });
        profiles = profiles.Select(item => item.Id == saved.Id ? saved : item).ToArray();
    }

    private static string SerializeSettingsForModel(string configurationJson, string modelPath)
    {
        var json = System.Text.Json.Nodes.JsonNode.Parse(configurationJson)?.AsObject()
            ?? throw new JsonException();
        json["ModelPath"] = modelPath;
        return json.ToJsonString();
    }

    private async Task SelectOpenVinoModelAsync()
    {
        if (isInitializing || isApplyingProfile)
            return;

        if (string.IsNullOrWhiteSpace(openVinoState.ModelPath))
        {
            selectedProfileId = null;
            ResetOpenVinoConfiguration();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var profile = GetPreferredProfile(openVinoState.ModelPath, ConfigurationBackend.OpenVino);
        if (profile is null)
        {
            selectedProfileId = null;
            ResetOpenVinoConfiguration();
        }
        else if (!TryApplyProfile(profile))
            ResetOpenVinoConfiguration();
        await SaveSettingsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectOpenVinoModelFromPickerAsync(ChangeEventArgs args)
    {
        openVinoState.ModelPath = args.Value?.ToString() ?? string.Empty;
        await SelectOpenVinoModelAsync();
    }

    private void ResetOpenVinoConfiguration()
    {
        openVinoState.Device = string.Empty;
        openVinoState.CacheDirectory = string.Empty;
        openVinoState.MaxNewTokens = 128;
        openVinoState.Temperature = .7f;
        openVinoState.TopP = .9f;
        openVinoState.DoSample = true;
        openVinoState.MaxPromptLength = 1024;
        openVinoState.MinResponseLength = 128;
        openVinoState.PrefillHint = "DYNAMIC";
        openVinoState.GenerateHint = "FAST_COMPILE";
        openVinoState.Devices.Clear();
        SyncOpenVinoDevices();
        EnsureOpenVinoDeviceRoute();
    }

    private void EnsureOpenVinoDeviceRoute()
    {
        var defaultDevice = openVinoDiagnostics?.Devices.FirstOrDefault(device =>
            device.IsCompatible && !IsExcludedDevice(device.Name));
        if (defaultDevice is null)
            return;

        if (!openVinoState.Devices.Any(pair => pair.Value.Enabled && pair.Value.Weight > 0))
            openVinoState.Devices[defaultDevice.Id] = new OpenVinoDeviceSetting(true, 1);

        UpdateOpenVinoDeviceRoute();
    }

    private string SerializeCurrentSettings() => activeBackend == BackendTab.Llama
        ? JsonSerializer.Serialize(new LoadModelRequest(
            llamaState.ModelPath,
            llamaState.Backend,
            llamaState.GpuLayerCount,
            llamaState.ContextSize,
            llamaState.BackendDevices.ToDictionary(pair => pair.Key, pair => pair.Value.Weight),
            llamaAdvancedState.ToSettings(),
            llamaState.MmprojPath,
            GetSelectedDeviceNames()))
        : activeBackend == BackendTab.OpenVino
            ? openVinoState.ToSettings().ConfigurationJson
            : activeBackend == BackendTab.DotLlm
                ? JsonSerializer.Serialize(dotLlmForm.ToRequest())
                : JsonSerializer.Serialize(pythonForm.ToRequest(CurrentProfileBackend));

    private InferenceTimeoutSettings? CreateProfileTimeoutSettings() => profileTimeoutEnabled
        ? new InferenceTimeoutSettings(
            CurrentProfileBackend == ConfigurationBackend.Llama ? "Llama" : GetBackendLabel(CurrentProfileBackend),
            profileTimeoutBaseSeconds,
            profileTimeoutSecondsPerTool,
            profileTimeoutSecondsPerPrefillToken)
        : null;

    private void ApplyProfileTimeout(InferenceTimeoutSettings? settings)
    {
        profileTimeoutEnabled = settings is not null;
        profileTimeoutBaseSeconds = settings?.BaseSeconds ?? 120;
        profileTimeoutSecondsPerTool = settings?.SecondsPerTool ?? 1;
        profileTimeoutSecondsPerPrefillToken = settings?.SecondsPerPrefillToken ?? .01;
    }

    private void ApplySettings(LoadModelRequest settings)
    {
        llamaState.ModelPath = settings.ModelPath;
        llamaState.MmprojPath = settings.MmprojPath;
        llamaState.Backend = settings.Backend;
        llamaState.GpuLayerCount = GetDefaultGpuLayerCount(settings.Backend, settings.GpuLayerCount);
        llamaState.ContextSize = settings.ContextSize;
        llamaAdvancedState.Load(settings.Advanced ?? new LlamaAdvancedSettings());
        llamaState.BackendDevices.Clear();
        foreach (var device in GetConfiguredLlamaDevices(settings))
            llamaState.BackendDevices[device.Key] = new BackendDeviceSetting(device.Value > 0, Math.Max(0, device.Value));
    }

    private void ResetModelConfiguration()
    {
        llamaState.Backend = "Vulkan";
        llamaState.MmprojPath = null;
        llamaState.GpuLayerCount = -1;
        llamaState.ContextSize = 131072;
        llamaAdvancedState.Load(new LlamaAdvancedSettings());
        llamaState.BackendDevices.Clear();
    }

    private static int GetDefaultGpuLayerCount(string backend, int configuredGpuLayerCount) =>
        string.Equals(backend, "SYCL", StringComparison.OrdinalIgnoreCase)
            ? -1
            : configuredGpuLayerCount;

    private IReadOnlyList<string> GetSelectedDeviceNames()
    {
        var selectedDevices = llamaState.BackendDevices
            .Where(pair => pair.Value.Enabled)
            .Select(pair => pair.Key)
            .ToArray();

        return string.Equals(llamaState.Backend, "SYCL", StringComparison.OrdinalIgnoreCase)
            ? selectedDevices.Select((_, index) => $"SYCL{index}").ToArray()
            : selectedDevices;
    }

    private BackendDeviceSetting GetDeviceSetting(string deviceName) =>
        llamaState.BackendDevices.TryGetValue(deviceName, out var setting) && setting is not null
            ? setting
            : new BackendDeviceSetting(false, 0);

    private IReadOnlyDictionary<string, float> GetVulkanWeightsForLoad() =>
        llamaState.BackendDevices
            .Where(pair => !IsExcludedDevice(pair.Key))
            .ToDictionary(
            pair => pair.Key,
            pair => pair.Value.Enabled ? pair.Value.Weight : 0,
            StringComparer.OrdinalIgnoreCase);

    private async Task SetDeviceEnabledAsync(string deviceName, bool enabled)
    {
        if (enabled)
        {
            var setting = GetDeviceSetting(deviceName);
            llamaState.BackendDevices[deviceName] = new BackendDeviceSetting(true, setting.Weight > 0 ? setting.Weight : 1);
        }
        else
        {
            var setting = GetDeviceSetting(deviceName);
            llamaState.BackendDevices[deviceName] = setting with { Enabled = false };
        }
        await SaveSettingsAsync();
    }

    private async Task SetDeviceWeightAsync(string deviceName, string? value)
    {
        if (float.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var weight))
        {
            var setting = GetDeviceSetting(deviceName);
            llamaState.BackendDevices[deviceName] = new BackendDeviceSetting(setting.Enabled, Math.Max(0, weight));
        }
        await SaveSettingsAsync();
    }

    private async Task SetPythonDeviceSelectedAsync(string device, bool selected)
    {
        if (selected)
        {
            if (!pythonForm.Devices.Contains(device, StringComparer.OrdinalIgnoreCase))
                pythonForm.Devices.Add(device);
        }
        else
        {
            pythonForm.Devices.RemoveAll(value => string.Equals(value, device, StringComparison.OrdinalIgnoreCase));
        }

        pythonForm.Device = pythonForm.Devices.FirstOrDefault() ?? string.Empty;
        await SaveSettingsAsync();
        await RefreshBackendPrerequisitesAsync();
    }

    private void SyncPythonDevices(IReadOnlyList<BackendAcceleratorDevice> devices)
    {
        pythonDeviceRoutes = devices
            .Select(device => new PythonDeviceRoute(
                device.Route,
                device.Label,
                device.Vendor,
                device.Driver,
                [BackendTab.Vllm, BackendTab.Sglang]))
            .ToArray();

        pythonForm.Devices.RemoveAll(device => !pythonDeviceRoutes.Any(route => string.Equals(route.Value, device, StringComparison.OrdinalIgnoreCase)));
        pythonForm.Device = pythonForm.Devices.FirstOrDefault() ?? string.Empty;
    }

    private void SyncEnabledDevices()
    {
        if (loadStatus is null)
            return;

        var detectedDeviceNames = GetLlamaRoutingDevices()
            .Where(device => !IsExcludedDevice(device.DeviceCaption ?? device.DeviceId))
            .Select(device => device.DeviceId)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var deviceName in llamaState.BackendDevices.Keys.Except(detectedDeviceNames, StringComparer.OrdinalIgnoreCase).ToArray())
            llamaState.BackendDevices.Remove(deviceName);

        foreach (var device in GetLlamaRoutingDevices())
        {
            if (!llamaState.BackendDevices.ContainsKey(device.DeviceId))
                llamaState.BackendDevices[device.DeviceId] = new BackendDeviceSetting(false, 0);
        }
    }

    private string? GetBackendLoadLog() => activeBackend is BackendTab.Vllm or BackendTab.Sglang &&
        backendLoadLogs.TryGetValue(GetConfigurationBackend(activeBackend), out var loadLog) &&
        !string.IsNullOrWhiteSpace(loadLog)
            ? loadLog
            : null;

    private string GetLoadedModelsCountLabel()
    {
        if (isInitializing)
            return "...";

        var models = DisplayedLoadedModels;
        var activeCount = models.Count(model => !model.IsLoading);
        var loadingCount = models.Count(model => model.IsLoading);
        return loadingCount == 0 ? $"{activeCount} active" : $"{activeCount} active, {loadingCount} loading";
    }

    private static bool IsOpenVinoModelPath(string modelPath) =>
        !string.IsNullOrWhiteSpace(modelPath) &&
        !string.Equals(Path.GetExtension(modelPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)), ".gguf", StringComparison.OrdinalIgnoreCase);

}
