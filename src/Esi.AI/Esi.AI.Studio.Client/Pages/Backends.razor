                    </div>
                    <div class="field-row">
                        <div class="field-group">
                            <label class="form-label">Active device route</label>
                            <input class="form-control" value="@openVinoForm.Device" readonly />
                        </div>
                        <div class="field-group">
                            <label class="form-label" for="openvino-cache">Cache directory</label>
                            <InputText id="openvino-cache" class="form-control" @bind-Value="openVinoForm.CacheDirectory" />
                        </div>
                    </div>
                </details>

                <section class="gpu-panel">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">DEVICE ROUTING</p>
                            <h2>OpenVINO devices</h2>
                        </div>
                        <span class="device-count">@(openVinoDiagnostics?.Devices.Count ?? 0) detected</span>
                    </div>
                        <p class="panel-note">Enable compatible GPUs for MULTI scheduling, or select the NPU as a separate route. Weight controls priority, not model-layer splitting.</p>
                    @if (openVinoDiagnostics?.Devices.Count > 0)
