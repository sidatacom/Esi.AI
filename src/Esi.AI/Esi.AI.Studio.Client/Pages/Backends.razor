    private async Task RefreshBackendPrerequisitesAsync()
    {
        if (activeBackend == BackendTab.OpenVino)
            return;

        isCheckingPrerequisites = true;
        try
        {
            backendPrerequisites = await DataService.GetBackendPrerequisitesAsync(
                CurrentPrerequisiteBackend,
                pythonForm.PythonExecutable,
                devices: activeBackend == BackendTab.Llama ? GetLlamaPrerequisiteDevices(llamaState.Backend) : pythonForm.SelectedDevices);
            if (activeBackend is BackendTab.Vllm or BackendTab.Sglang)
                SyncPythonDevices(backendPrerequisites.AvailableDevices ?? []);
