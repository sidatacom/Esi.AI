    protected override async Task OnInitializedAsync()
    {
        RuntimeEvents.LoadedModel_Create += HandleLoadedModelChangedAsync;
        RuntimeEvents.LoadedModel_Update += HandleLoadedModelChangedAsync;
        RuntimeEvents.LoadedModel_Delete += HandleLoadedModelChangedAsync;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        try
        {
            var savedSettingsTask = DataService.ModelSettings_ReadAsync();
            var savedSettings = (await savedSettingsTask)
                .ToArray();
            var openVinoDiagnosticsTask = DataService.GetDiagnosticsAsync();
            var databaseModelsTask = DataService.Model_UpdateAsync();
            var profilesTask = DataService.ModelConfiguration_ReadAsync();
            await Task.WhenAll(openVinoDiagnosticsTask, databaseModelsTask, profilesTask);
            var savedLlamaSettings = savedSettings.FirstOrDefault(item => item.Backend == ConfigurationBackend.Llama);
            var savedOpenVinoSettings = savedSettings.FirstOrDefault(item => item.Backend == ConfigurationBackend.OpenVino);
            openVinoDiagnostics = await openVinoDiagnosticsTask;
            SyncOpenVinoDevices();
            if (savedLlamaSettings is not null && !IsOpenVinoModelPath(savedLlamaSettings.ModelPath))
            {
                var llamaRequest = JsonSerializer.Deserialize<LoadModelRequest>(savedLlamaSettings.ConfigurationJson)
                    ?? throw new JsonException();
                form.ModelPath = savedLlamaSettings.ModelPath;
                form.Backend = llamaRequest.Backend;
                form.GpuLayerCount = llamaRequest.GpuLayerCount;
                form.ContextSize = llamaRequest.ContextSize;
                advanced.Load(llamaRequest.Advanced);
                form.VulkanDevices.Clear();
                foreach (var device in llamaRequest.VulkanDeviceWeights)
                    form.VulkanDevices[device.Key] = new VulkanDeviceSetting(device.Value > 0, Math.Max(0, device.Value));
            }
                    databaseModels = await databaseModelsTask;
                    profiles = await profilesTask;
            if (savedOpenVinoSettings is not null)
            {
                openVinoForm.Load(savedOpenVinoSettings);
                EnsureOpenVinoDeviceRoute();
            }

            var legacyOpenVinoPath = savedOpenVinoSettings?.ModelPath ??
                (savedLlamaSettings is not null && IsOpenVinoModelPath(savedLlamaSettings.ModelPath) ? savedLlamaSettings.ModelPath : string.Empty);
            if (savedOpenVinoSettings is null && !string.IsNullOrWhiteSpace(legacyOpenVinoPath))
            {
                openVinoForm.ModelPath = legacyOpenVinoPath;
                await DataService.ModelSettings_UpdateAsync(openVinoForm.ToSettings());
            }

            var savedOpenVinoPath = !string.IsNullOrWhiteSpace(openVinoForm.ModelPath);
            activeBackend = savedOpenVinoPath ? BackendTab.OpenVino : BackendTab.Llama;
            backendModels = await DataService.BackendModel_ReadAsync(GetConfigurationBackend(activeBackend));
            var activeModelPath = activeBackend == BackendTab.OpenVino ? openVinoForm.ModelPath : form.ModelPath;
            var preferredProfile = GetPreferredProfile(activeModelPath, activeBackend == BackendTab.OpenVino ? ConfigurationBackend.OpenVino : ConfigurationBackend.Llama);
            if (preferredProfile is not null)
                TryApplyProfile(preferredProfile);
            else
                selectedProfileId = null;
            var openVinoModelStatus = await DataService.GetOpenVinoModelStatusAsync();
            isOpenVinoModelLoaded = openVinoModelStatus.IsModelLoaded;
            if (openVinoModelStatus.IsModelLoaded && !string.IsNullOrWhiteSpace(openVinoModelStatus.ModelPath))
                openVinoForm.ModelPath = openVinoModelStatus.ModelPath;
            if (openVinoModelStatus.IsModelLoaded && !string.IsNullOrWhiteSpace(openVinoModelStatus.Device))
                openVinoForm.Device = openVinoModelStatus.Device;
            RequirementEvents.BackendRequirementStateUpdated += HandleBackendRequirementStateUpdatedAsync;
            ApplyBackendRequirementState(await DataService.GetBackendRequirementStateAsync());
            await RefreshMatrixRequirementActionsAsync();
            var statusVersion = loadedModelStatusVersion;
            var currentLoadStatus = await DataService.LoadedModel_ReadAsync();
            if (statusVersion == loadedModelStatusVersion)
                loadStatus = currentLoadStatus;
        }
        catch (Exception exception)
        {
            statusMessage = $"Initialization failed: {exception.Message}";
        }
        isInitializing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadModelAsync()
    {
        if (string.IsNullOrWhiteSpace(form.ModelPath) || !string.Equals(Path.GetExtension(form.ModelPath), ".gguf", StringComparison.OrdinalIgnoreCase))
        {
            statusMessage = "Select or enter a .gguf model path first.";
            return;
        }

        isLoading = true;
        statusMessage = null;
        ShowPendingModel(form.ModelPath, ConfigurationBackend.Llama, form.Backend);
        await InvokeAsync(StateHasChanged);

        try
        {
            var request = new LoadModelRequest(
                form.ModelPath,
                form.Backend,
                form.GpuLayerCount,
                form.ContextSize,
                GetVulkanWeightsForLoad(),
                advanced.ToSettings());
            await SaveSettingsAsync();
            var loadTask = DataService.LoadModelAsync(request);
            loadStatus = await loadTask;
            SyncEnabledDevices();
            statusMessage = $"Loaded: {form.ModelPath}";
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Loading was cancelled.";
        }
        catch (ArgumentException)
        {
            statusMessage = "Enter a valid GGUF model path and GPU layer count.";
        }
        catch (FileNotFoundException)
        {
            statusMessage = "The specified model file was not found.";
        }
        catch (Exception)
        {
            statusMessage = "The model could not be loaded.";
            loadStatus = await DataService.LoadedModel_ReadAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowPendingModel(string modelPath, ConfigurationBackend backend, string runtime)
    {
        var current = loadStatus ?? new ModelLoadStatus(
            null,
            runtime,
            0,
            0,
            0,
            0,
            [],
            null,
            string.Empty,
            new Dictionary<string, float>(),
            false,
            []);
        var pending = new LoadedModelStatus(
            modelPath,
            backend,
            runtime,
            0,
            0,
            0,
            [],
            null,
            string.Empty,
            true);
        var loadedModels = current.LoadedModels
            .Where(model => !string.Equals(model.ModelPath, modelPath, StringComparison.OrdinalIgnoreCase) || model.Backend != backend)
            .Append(pending)
            .ToArray();
        loadStatus = current with
        {
            ModelPath = modelPath,
            Backend = runtime,
            IsModelLoaded = false,
            LoadedModels = loadedModels
        };
    }

