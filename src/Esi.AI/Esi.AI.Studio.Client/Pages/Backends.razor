    private async Task InitializeAsync()
    {
        try
        {
            loadStatus = await DataService.LoadedModel_ReadAsync();
            ClientState.LoadedModel_Read(loadStatus);
            isInitializing = false;
            await InvokeAsync(StateHasChanged);

            var savedSettingsTask = DataService.ModelSettings_ReadAsync();
            var applicationSettingsTask = DataService.ApplicationSettings_ReadAsync();
            var savedSettings = (await savedSettingsTask)
                .ToArray();
            var applicationSettings = await applicationSettingsTask;
            var databaseModelsTask = DataService.Model_UpdateAsync();
            var profilesTask = DataService.ModelConfiguration_ReadAsync();
            await Task.WhenAll(databaseModelsTask, profilesTask);
            var savedLlamaSettings = savedSettings.FirstOrDefault(item => item.Backend == ConfigurationBackend.Llama);
            var savedOpenVinoSettings = savedSettings.FirstOrDefault(item => item.Backend == ConfigurationBackend.OpenVino);
            openVinoDiagnostics = null;
            SyncOpenVinoDevices();
            if (savedLlamaSettings is not null && !IsOpenVinoModelPath(savedLlamaSettings.ModelPath))
            {
                var llamaRequest = JsonSerializer.Deserialize<LoadModelRequest>(savedLlamaSettings.ConfigurationJson)
                    ?? throw new JsonException();
                llamaState.ModelPath = savedLlamaSettings.ModelPath;
                llamaState.Backend = llamaRequest.Backend;
                llamaState.GpuLayerCount = GetDefaultGpuLayerCount(llamaRequest.Backend, llamaRequest.GpuLayerCount);
                llamaState.ContextSize = llamaRequest.ContextSize;
                llamaAdvancedState.Load(llamaRequest.Advanced);
                llamaState.BackendDevices.Clear();
                foreach (var device in GetConfiguredLlamaDevices(llamaRequest))
                    llamaState.BackendDevices[device.Key] = new BackendDeviceSetting(device.Value > 0, Math.Max(0, device.Value));
            }
                    databaseModels = await databaseModelsTask;
                    profiles = await profilesTask;
            if (savedOpenVinoSettings is not null)
            {
                openVinoState.Load(savedOpenVinoSettings);
                EnsureOpenVinoDeviceRoute();
            }

            var legacyOpenVinoPath = savedOpenVinoSettings?.ModelPath ??
                (savedLlamaSettings is not null && IsOpenVinoModelPath(savedLlamaSettings.ModelPath) ? savedLlamaSettings.ModelPath : string.Empty);
            if (savedOpenVinoSettings is null && !string.IsNullOrWhiteSpace(legacyOpenVinoPath))
            {
                openVinoState.ModelPath = legacyOpenVinoPath;
                await DataService.ModelSettings_UpdateAsync(openVinoState.ToSettings());
            }

            var savedOpenVinoPath = !string.IsNullOrWhiteSpace(openVinoState.ModelPath);
            activeBackend = applicationSettings.LastSelectedBackend switch
            {
                ConfigurationBackend.OpenVino => BackendTab.OpenVino,
                ConfigurationBackend.Vllm => BackendTab.Vllm,
                ConfigurationBackend.Sglang => BackendTab.Sglang,
                ConfigurationBackend.DotLlm => BackendTab.DotLlm,
                ConfigurationBackend.Llama => BackendTab.Llama,
                _ => savedOpenVinoPath ? BackendTab.OpenVino : BackendTab.Llama
            };
            backendModels = await DataService.BackendModel_ReadAsync(GetConfigurationBackend(activeBackend));
            var activeModelPath = activeBackend == BackendTab.OpenVino ? openVinoState.ModelPath : llamaState.ModelPath;
            var preferredProfile = GetPreferredProfile(activeModelPath, activeBackend == BackendTab.OpenVino ? ConfigurationBackend.OpenVino : ConfigurationBackend.Llama);
            if (preferredProfile is not null)
                TryApplyProfile(preferredProfile);
            else
                selectedProfileId = null;
            if (activeBackend is BackendTab.Vllm or BackendTab.Sglang)
                await RefreshBackendPrerequisitesAsync();
            var openVinoModelStatus = await DataService.GetOpenVinoModelStatusAsync();
            isOpenVinoModelLoaded = openVinoModelStatus.IsModelLoaded;
            if (openVinoModelStatus.IsModelLoaded && !string.IsNullOrWhiteSpace(openVinoModelStatus.ModelPath))
                openVinoState.ModelPath = openVinoModelStatus.ModelPath;
            if (openVinoModelStatus.IsModelLoaded && !string.IsNullOrWhiteSpace(openVinoModelStatus.Device))
                openVinoState.Device = openVinoModelStatus.Device;
            RequirementEvents.BackendRequirement_Update += HandleBackendRequirementUpdateAsync;
            ApplyBackendRequirementState(await DataService.BackendRequirement_ReadAsync());
            await RefreshMatrixRequirementActionsAsync();
            isMatrixExpanded = false;
            isBackendRequirementsExpanded = !IsBackendRequirementsReady;
            var statusVersion = loadedModelStatusVersion;
            var currentLoadStatus = await DataService.LoadedModel_ReadAsync();
            if (statusVersion == loadedModelStatusVersion)
                loadStatus = currentLoadStatus;
        }
        catch (Exception exception)
        {
            statusMessage = $"Initialization failed: {exception.Message}";
        }
        isInitializing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> LoadModelAsync()
    {
        if (!IsBackendPrerequisitesReady)
        {
            statusMessage = "The selected LLama backend is not ready. Resolve the backend requirements before loading a model.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(llamaState.ModelPath) || !string.Equals(Path.GetExtension(llamaState.ModelPath), ".gguf", StringComparison.OrdinalIgnoreCase))
        {
            statusMessage = "Select or enter a .gguf model path first.";
            return false;
        }

        isLoading = true;
        statusMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var request = new LoadModelRequest(
                llamaState.ModelPath,
                llamaState.Backend,
                llamaState.GpuLayerCount,
                llamaState.ContextSize,
                GetVulkanWeightsForLoad(),
                llamaAdvancedState.ToSettings(),
                llamaState.MmprojPath,
                GetSelectedDeviceNames());
            await SaveSettingsAsync();
            var loadedStatus = await DataService.LoadModelAsync(request);
            loadStatus = loadedStatus;
            SyncEnabledDevices();
            if (!loadedStatus.IsModelLoaded)
            {
                statusMessage = string.IsNullOrWhiteSpace(loadedStatus.LoadLog)
                    ? "The model could not be loaded."
                    : loadedStatus.LoadLog;
                return false;
            }

            statusMessage = null;
            return true;
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Loading was cancelled.";
            return false;
        }
        catch (ArgumentException exception)
        {
            statusMessage = exception.Message;
            return false;
        }
        catch (FileNotFoundException)
        {
            statusMessage = "The specified model file was not found.";
            return false;
        }
        catch (Exception)
        {
            statusMessage = "The model could not be loaded.";
            return false;
        }
        finally
        {
            isLoading = false;
        }
    }


