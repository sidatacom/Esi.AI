    private async Task RefreshMatrixDialogDiagnosticsAsync()
    {
        if (matrixDialogBackendTab is not { } backend || matrixDialogVendor is null)
            return;

        var route = GetMatrixDeviceRoute(matrixDialogVendor);
        matrixDialogDiagnostics = await DataService.GetBackendPrerequisitesAsync(
            GetConfigurationBackend(backend), pythonForm.PythonExecutable,
