                                    <label class="gpu-name" for="openvino-device-@device.Id">
                                        <strong>@device.Name</strong>
                                        <span>@device.Detail</span>
                                    </label>
                                </div>
                                <div class="weight-field">
                                    <label for="@($"openvino-weight-{device.Id}")">Priority</label>
                                    <input id="@($"openvino-weight-{device.Id}")" class="form-control" type="number" min="0" step="0.1"
                                           disabled="@(!device.IsCompatible)"
                                           value="@GetOpenVinoDeviceSetting(device.Id).Weight.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                           @onchange="async eventArgs => await SetOpenVinoDeviceWeightAsync(device.Id, eventArgs.Value?.ToString())" />
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Keine OpenVINO-GPUs gefunden.</p>
                    }
                </section>

                <details class="settings-panel" open>
                    <summary>Generation</summary>
                    <div class="field-row">
                        <div class="field-group"><label class="form-label" for="openvino-max-tokens">Max new tokens</label><InputNumber id="openvino-max-tokens" class="form-control" @bind-Value="openVinoForm.MaxNewTokens" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-temperature">Temperature</label><InputNumber id="openvino-temperature" class="form-control" @bind-Value="openVinoForm.Temperature" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-top-k">Top K</label><InputNumber id="openvino-top-k" class="form-control" @bind-Value="openVinoForm.TopK" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-top-p">Top P</label><InputNumber id="openvino-top-p" class="form-control" @bind-Value="openVinoForm.TopP" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-repetition-penalty">Repetition penalty</label><InputNumber id="openvino-repetition-penalty" class="form-control" @bind-Value="openVinoForm.RepetitionPenalty" /></div>
                    </div>
                    <label class="setting-toggle"><InputCheckbox @bind-Value="openVinoForm.DoSample" /> Enable sampling</label>
                </details>

                @if (openVinoForm.Device.StartsWith("NPU", StringComparison.OrdinalIgnoreCase))
                {
                    <details class="settings-panel" open>
                        <summary>NPU pipeline</summary>
                        <p class="panel-note">NPU pipelines use a bounded prompt and response context. These properties apply only when the active route is NPU.</p>
                        <div class="field-row">
                            <div class="field-group"><label class="form-label" for="openvino-max-prompt">Max prompt tokens</label><InputNumber id="openvino-max-prompt" class="form-control" @bind-Value="openVinoForm.MaxPromptLength" /></div>
                            <div class="field-group"><label class="form-label" for="openvino-min-response">Min response tokens</label><InputNumber id="openvino-min-response" class="form-control" @bind-Value="openVinoForm.MinResponseLength" /></div>
                        </div>
                        <div class="field-row">
                            <div class="field-group">
                                <label class="form-label" for="openvino-prefill-hint">Prefill hint</label>
                                <InputSelect id="openvino-prefill-hint" class="form-select" @bind-Value="openVinoForm.PrefillHint">
                                    <option value="DYNAMIC">Dynamic</option>
                                    <option value="STATIC">Static</option>
                                </InputSelect>
                            </div>
                            <div class="field-group">
                                <label class="form-label" for="openvino-generate-hint">Generate hint</label>
                                <InputSelect id="openvino-generate-hint" class="form-select" @bind-Value="openVinoForm.GenerateHint">
                                    <option value="FAST_COMPILE">Fast compile</option>
                                    <option value="BEST_PERF">Best performance</option>
                                </InputSelect>
                            </div>
                        </div>
                    </details>
                }
            </div>

        </section>

        <section class="telemetry-panel">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">RUNTIME TELEMETRY</p>
                    <h2>OpenVINO status</h2>
                </div>
            </div>
            <dl class="telemetry-grid">
                @if (openVinoDiagnostics is not null)
                {
                    @foreach (var check in openVinoDiagnostics.Checks)
                    {
                        <dt>@check.Name</dt>
                        <dd class="diagnostic-@(check.IsAvailable ? "ok" : "error")">@(check.IsAvailable ? "Available" : "Missing") - @check.Detail</dd>
                    }
                }
                <dt>Device</dt>
                <dd>@openVinoForm.Device</dd>
                <dt>Model</dt>
                <dd>@(string.IsNullOrWhiteSpace(openVinoForm.ModelPath) ? "Not selected" : Path.GetFileName(openVinoForm.ModelPath.TrimEnd(Path.DirectorySeparatorChar)))</dd>
                <dt>Runtime</dt>
                <dd>@(openVinoStatus ?? "Ready for model loading")</dd>
            </dl>
        </section>
    </div>
}

@if (activeBackend == BackendTab.Llama && isLoading)
{
    <p class="mt-3" role="status">Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="mt-3" role="status">@statusMessage</p>
}

@if (isLoading || isOpenVinoLoading)
{
    <section class="log-panel runtime-loading-log">
        <div class="log-heading">
            <div>
                <p class="eyebrow">RUNTIME</p>
                <h2>Load output</h2>
            </div>
            <span>READ ONLY</span>
        </div>
        <textarea class="form-control log-output" rows="8" readonly>@(activeBackend == BackendTab.Llama ? loadLog ?? loadStatus?.LoadLog : openVinoLoadLog ?? "Waiting for runtime output...")</textarea>
    </section>
}

@code {
    private BackendTab activeBackend = BackendTab.Llama;
    private readonly PythonForm pythonForm = new();
    private bool isPythonLoading;
    private string? pythonStatus;
    private bool isOpenVinoLoading;
    private bool isOpenVinoModelLoaded;
    private bool isCheckingOpenVino;
    private bool isCheckingPrerequisites;
    private bool isPreparingPrerequisites;
    private string? prerequisiteOutput;
    private string? solvingCheckId;
    private string? openVinoStatus;
    private string? openVinoLoadLog;
    private string? openVinoInstallOutput;
    private bool solveRequiresLogin;
    private OpenVinoDiagnosticsDto? openVinoDiagnostics;
    private BackendPrerequisiteDiagnostics? backendPrerequisites;
    private readonly OpenVinoForm openVinoForm = new();
    private readonly DotLlmForm dotLlmForm = new();
    private IReadOnlyList<BackendModel> backendModels = [];
    private bool isDotLlmLoading;
    private string? dotLlmStatus;

    private string ActiveBackendLabel => activeBackend switch
    {
        BackendTab.Llama => "LLama / Vulkan",
        BackendTab.OpenVino => $"OpenVINO / {openVinoForm.Device}",
        BackendTab.DotLlm => "dotLLM / Native .NET",
        _ => $"{GetPythonBackendName(pythonForm.Backend)} / Python"
    };
    private bool IsOpenVinoValidationReady => openVinoDiagnostics?.IsGpuReady == true || openVinoDiagnostics?.IsNpuReady == true;
    private bool IsBackendPrerequisitesReady => backendPrerequisites?.IsReady == true;
    private ConfigurationBackend CurrentPrerequisiteBackend => activeBackend == BackendTab.Python ? pythonForm.Backend : GetConfigurationBackend(activeBackend);
    private IReadOnlyList<LlamaModel> LlamaModels => databaseModels
        .Where(model => string.Equals(Path.GetExtension(model.Path), ".gguf", StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private IReadOnlyList<BackendModel> CurrentBackendModels => backendModels
        .Where(model => model.Backend == CurrentProfileBackend)
        .ToArray();

    private BackendReferenceModel? CurrentReferenceModel => BackendReferenceModels.All
        .FirstOrDefault(model => model.Backend == CurrentProfileBackend);

    private bool IsCurrentModelLoadDisabled => string.IsNullOrWhiteSpace(CurrentModelPath) || activeBackend switch
    {
        BackendTab.Llama => isLoading || !string.Equals(Path.GetExtension(CurrentModelPath), ".gguf", StringComparison.OrdinalIgnoreCase),
        BackendTab.OpenVino => isOpenVinoLoading || !IsOpenVinoValidationReady || string.IsNullOrWhiteSpace(openVinoForm.Device),
        BackendTab.Python => isPythonLoading || !IsBackendPrerequisitesReady,
        BackendTab.DotLlm => isDotLlmLoading,
        _ => true
    };

    private string GetLoadButtonLabel() => activeBackend switch
    {
        BackendTab.Llama => isLoading ? "Loading model..." : "Load model",
        BackendTab.OpenVino => isOpenVinoLoading ? "Loading model..." : "Load model",
        BackendTab.Python => isPythonLoading ? "Starting server..." : "Start Python backend",
        BackendTab.DotLlm => isDotLlmLoading ? "Loading in process..." : "Load dotLLM",
        _ => "Load model"
    };

    private static string GetBackendLabel(BackendTab backend) => backend switch
    {
        BackendTab.Llama => "LLama",
        BackendTab.OpenVino => "OpenVINO",
        BackendTab.DotLlm => "dotLLM",
        _ => "Python"
    };

    private async Task LoadOpenVinoModelAsync()
    {
        if (openVinoDiagnostics?.IsGpuReady != true && openVinoDiagnostics?.IsNpuReady != true)
        {
            openVinoStatus = "No supported OpenVINO accelerator is available.";
            return;
        }

        isOpenVinoLoading = true;
        openVinoStatus = null;
        openVinoLoadLog = string.Empty;
        try
        {
            var loadTask = DataService.LoadModelAsync(
                new OpenVinoLoadRequest(
                    openVinoForm.ModelPath,
                    openVinoForm.Device,
                    openVinoForm.CacheDirectory,
                    openVinoForm.MaxNewTokens,
                    openVinoForm.Temperature,
                    openVinoForm.TopP,
                    openVinoForm.DoSample,
                    new OpenVinoNpuSettings(
                        openVinoForm.MaxPromptLength,
                        openVinoForm.MinResponseLength,
                        openVinoForm.PrefillHint,
                        openVinoForm.GenerateHint),
                    openVinoForm.TopK,
                    openVinoForm.RepetitionPenalty));
            while (!loadTask.IsCompleted)
            {
                await Task.Delay(250);
                var openVinoModelStatus = await DataService.GetOpenVinoModelStatusAsync();
                openVinoLoadLog = openVinoModelStatus.LoadLog;
                await InvokeAsync(StateHasChanged);
            }

            var result = await loadTask;
            isOpenVinoModelLoaded = result.Succeeded;
            openVinoStatus = result.Message;
            var finalOpenVinoStatus = await DataService.GetOpenVinoModelStatusAsync();
            openVinoLoadLog = finalOpenVinoStatus.LoadLog;
            if (result.Succeeded)
                loadStatus = await DataService.GetModelStatusAsync();
            statusMessage = result.Succeeded ? null : "The model could not be loaded.";
        }
        finally
        {
            isOpenVinoLoading = false;
        }
    }

    private Task LoadActiveBackendModelAsync() => activeBackend switch
    {
        BackendTab.Llama => LoadModelAsync(),
        BackendTab.OpenVino => LoadOpenVinoModelAsync(),
        BackendTab.Python => LoadPythonModelAsync(),
        BackendTab.DotLlm => LoadDotLlmModelAsync(),
        _ => Task.CompletedTask
    };

    private async Task LoadPythonModelAsync()
    {
        isPythonLoading = true;
        pythonStatus = null;
        try
        {
            loadStatus = await DataService.LoadPythonModelAsync(pythonForm.ToRequest());
            pythonStatus = $"{GetPythonBackendName(pythonForm.Backend)} is ready.";
        }
        catch (Exception exception)
        {
            pythonStatus = exception.Message;
        }
        finally
        {
            isPythonLoading = false;
        }
    }

    private async Task StopPythonModelAsync()
    {
        await DataService.UnloadModelAsync(loadStatus?.ModelPath ?? pythonForm.ModelPath, pythonForm.Backend);
        loadStatus = await DataService.GetModelStatusAsync();
        pythonStatus = "Python backend stopped.";
    }

    private async Task LoadDotLlmModelAsync()
    {
        isDotLlmLoading = true;
        dotLlmStatus = null;
        try
        {
            loadStatus = await DataService.LoadDotLlmModelAsync(new DotLlmLoadRequest(
                dotLlmForm.ModelPath, dotLlmForm.Device, dotLlmForm.Threads));
            dotLlmStatus = "dotLLM is ready.";
        }
        catch (Exception exception)
        {
            dotLlmStatus = exception.Message;
        }
        finally
        {
            isDotLlmLoading = false;
        }
    }

    private async Task StopDotLlmModelAsync()
    {
        await DataService.UnloadModelAsync(loadStatus?.ModelPath ?? dotLlmForm.ModelPath, ConfigurationBackend.DotLlm);
        loadStatus = await DataService.GetModelStatusAsync();
        dotLlmStatus = "dotLLM stopped.";
    }

    private async Task RefreshOpenVinoDiagnosticsAsync()
    {
        isCheckingOpenVino = true;
        try
        {
            openVinoDiagnostics = await DataService.GetDiagnosticsAsync();
            SyncOpenVinoDevices();
        }
        finally
        {
            isCheckingOpenVino = false;
        }
    }

    private async Task RefreshBackendPrerequisitesAsync()
    {
        if (activeBackend == BackendTab.OpenVino)
            return;

        isCheckingPrerequisites = true;
        try
        {
            backendPrerequisites = await DataService.GetBackendPrerequisitesAsync(CurrentPrerequisiteBackend, pythonForm.PythonExecutable);
        }
        catch (Exception exception)
        {
            backendPrerequisites = new(CurrentPrerequisiteBackend, GetBackendLabel(activeBackend), false,
                [new("diagnostics", "Backend diagnostics", false, exception.Message, false)], exception.ToString());
        }
        finally
        {
            isCheckingPrerequisites = false;
        }
    }

    private async Task PrepareBackendPrerequisitesAsync()
    {
        isPreparingPrerequisites = true;
        prerequisiteOutput = $"Preparing {backendPrerequisites?.BackendName ?? GetBackendLabel(activeBackend)}...";
        try
        {
            var result = await DataService.PrepareBackendAsync(CurrentPrerequisiteBackend, pythonForm.PythonExecutable);
            prerequisiteOutput = $"Result: {(result.Succeeded ? "SUCCESS" : "FAILED")}{Environment.NewLine}{result.Message}{Environment.NewLine}{result.Output}";
            await RefreshBackendPrerequisitesAsync();
        }
        catch (Exception exception)
        {
            prerequisiteOutput = exception.ToString();
        }
        finally
        {
            isPreparingPrerequisites = false;
        }
    }

    private void SyncOpenVinoDevices()
    {
        if (openVinoDiagnostics?.Devices is null)
            return;

        foreach (var device in openVinoDiagnostics.Devices.Where(device => device.IsCompatible))
        {
            if (!openVinoForm.Devices.ContainsKey(device.Id))
                openVinoForm.Devices[device.Id] = new OpenVinoDeviceSetting(false, 0);
        }

        foreach (var device in openVinoForm.Devices.Keys.Except(openVinoDiagnostics.Devices.Where(device => device.IsCompatible).Select(device => device.Id), StringComparer.OrdinalIgnoreCase).ToArray())
            openVinoForm.Devices.Remove(device);

        UpdateOpenVinoDeviceRoute();
    }

    private OpenVinoDeviceSetting GetOpenVinoDeviceSetting(string device) =>
        openVinoForm.Devices.TryGetValue(device, out var setting)
            ? setting
            : new OpenVinoDeviceSetting(false, 0);

    private async Task SetOpenVinoDeviceEnabledAsync(string device, bool enabled)
    {
        var setting = GetOpenVinoDeviceSetting(device);
        if (enabled && device.StartsWith("NPU", StringComparison.OrdinalIgnoreCase))
        {
            foreach (var npuDevice in openVinoForm.Devices.Keys
                .Where(key => key.StartsWith("NPU", StringComparison.OrdinalIgnoreCase) && !string.Equals(key, device, StringComparison.OrdinalIgnoreCase))
                .ToArray())
                openVinoForm.Devices[npuDevice] = GetOpenVinoDeviceSetting(npuDevice) with { Enabled = false };
        }
        else if (enabled)
        {
            foreach (var npuDevice in openVinoForm.Devices.Keys
                .Where(key => key.StartsWith("NPU", StringComparison.OrdinalIgnoreCase))
                .ToArray())
                openVinoForm.Devices[npuDevice] = GetOpenVinoDeviceSetting(npuDevice) with { Enabled = false };
        }
        openVinoForm.Devices[device] = enabled
            ? new OpenVinoDeviceSetting(true, setting.Weight > 0 ? setting.Weight : 1)
            : setting with { Enabled = false };
        UpdateOpenVinoDeviceRoute();
        await SaveSettingsAsync();
    }

    private async Task SetOpenVinoDeviceWeightAsync(string device, string? value)
    {
        _ = float.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var weight);
        var setting = GetOpenVinoDeviceSetting(device);
        openVinoForm.Devices[device] = setting with { Weight = Math.Max(0, weight) };
        UpdateOpenVinoDeviceRoute();
        await SaveSettingsAsync();
    }

    private void UpdateOpenVinoDeviceRoute()
    {
        var enabledDevices = openVinoForm.Devices
            .Where(pair => pair.Value.Enabled && pair.Value.Weight > 0)
            .OrderByDescending(pair => pair.Value.Weight)
            .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var npuDevice = enabledDevices.FirstOrDefault(pair => pair.Key.StartsWith("NPU", StringComparison.OrdinalIgnoreCase));
        var devices = npuDevice.Key is not null
            ? [npuDevice]
            : enabledDevices;
        openVinoForm.Device = devices.Length switch
        {
            0 => string.Empty,
            1 => devices[0].Key,
            _ => $"MULTI:{string.Join(',', devices.Select(pair => pair.Key))}"
        };
    }

    private async Task SelectBackendAsync(BackendTab backend)
    {
        activeBackend = backend;
        statusMessage = null;
        backendPrerequisites = null;
        await RefreshBackendPrerequisitesAsync();
        isAssigningProfile = false;
        isCreatingProfile = false;
        backendModels = await DataService.GetBackendModelsAsync(GetConfigurationBackend(backend));
        var modelPath = backend switch
        {
            BackendTab.Llama => form.ModelPath,
            BackendTab.OpenVino => openVinoForm.ModelPath,
            BackendTab.DotLlm => dotLlmForm.ModelPath,
            _ => pythonForm.ModelPath
        };
        if (string.IsNullOrWhiteSpace(modelPath))
        {
            selectedProfileId = null;
            if (backend == BackendTab.OpenVino)
                ResetOpenVinoConfiguration();
            else if (backend == BackendTab.Llama)
                ResetModelConfiguration();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var profile = GetPreferredProfile(modelPath, GetConfigurationBackend(backend));
        if (profile is not null)
            TryApplyProfile(profile);
        else
        {
            selectedProfileId = null;
            if (backend == BackendTab.OpenVino)
                ResetOpenVinoConfiguration();
            else
                ResetModelConfiguration();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SolveOpenVinoCheckAsync(string checkId)
    {
        solvingCheckId = checkId;
        solveRequiresLogin = false;
        openVinoStatus = "Requesting administrator approval. Please complete the system authorization dialog...";
        openVinoInstallOutput = $"Starting repair action: {checkId}{Environment.NewLine}Waiting for pkexec...";
        try
        {
            var result = await DataService.SolveDiagnosticAsync(checkId);

            var resultMessage = string.IsNullOrWhiteSpace(result?.Message)
                ? "The installer returned no message. Check the command and exit code below."
                : result.Message;
            openVinoStatus = resultMessage;
            openVinoInstallOutput = result is null
                ? "The server returned no repair result."
                : $"Action: {checkId}{Environment.NewLine}Result: {(result.Succeeded ? "SUCCESS" : "FAILED")}{Environment.NewLine}Message: {resultMessage}{Environment.NewLine}{result.Output}";
            await RefreshOpenVinoDiagnosticsAsync();
        }
        catch (Exception exception)
        {
            openVinoStatus = $"Driver repair failed: {exception.Message}";
            openVinoInstallOutput = $"Action: {checkId}{Environment.NewLine}ERROR{Environment.NewLine}{exception}";
        }
        finally
        {
            solvingCheckId = null;
        }
    }

