    private string GetRoutingDeviceCount() => activeBackend switch
    {
        BackendTab.OpenVino => $"{openVinoDiagnostics?.Devices.Count(device => !IsExcludedDevice(device.Name)) ?? 0} available",
        BackendTab.Llama => $"{loadStatus?.VulkanDevices.Count(device => !IsExcludedDevice(device.Description ?? device.Name)) ?? 0} detected",
        BackendTab.Vllm or BackendTab.Sglang => $"{PythonDeviceRoutes.Count(route => route.Backends.Contains(activeBackend))} available",
        BackendTab.DotLlm => "1 supported",
        _ => "0 available"
    };

    private static bool IsExcludedDevice(string deviceName) =>
        deviceName.Contains("UHD Graphics 630", StringComparison.OrdinalIgnoreCase);

    private static string GetVulkanDriverLabel(VulkanDeviceStatus device)
    {
        if (!string.IsNullOrWhiteSpace(device.Driver))
            return device.Driver;
        if (!string.IsNullOrWhiteSpace(device.Vendor))
            return $"{device.Vendor} Vulkan driver";
        if (device.Description?.Contains("NVIDIA", StringComparison.OrdinalIgnoreCase) == true)
            return "NVIDIA Vulkan driver";
        if (device.Description?.Contains("Intel", StringComparison.OrdinalIgnoreCase) == true)
            return "Intel Vulkan/xe driver";
        if (device.Description?.Contains("AMD", StringComparison.OrdinalIgnoreCase) == true)
            return "AMD Vulkan driver";
        return "Vulkan driver";
    }

    private sealed class PythonForm
    {
        public string ModelPath { get; set; } = string.Empty;
        public string PythonExecutable { get; set; } = "python3";
        public string? WorkingDirectory { get; set; }
        public string Device { get; set; } = "cuda:0";
        public List<string> Devices { get; } = ["cuda:0"];
        public string AdditionalDeviceRoutes { get; set; } = string.Empty;
        public IReadOnlyList<string> SelectedDevices => GetDevices();
        public int? GpuMemoryUtilization { get; set; } = 90;
        public int MaxModelLength { get; set; } = 2048;
        public int TensorParallelSize { get; set; } = 1;
        public bool TrustRemoteCode { get; set; } = true;

        public PythonInferenceLoadRequest ToRequest(ConfigurationBackend backend) => new(
            ModelPath,
            backend,
            PythonExecutable,
            WorkingDirectory,
            Port: 8000,
            GpuMemoryUtilization,
            (uint)Math.Max(1, MaxModelLength),
            Math.Max(1, TensorParallelSize),
            TrustRemoteCode,
            EnforceEager: true,
            Device: GetDevices().FirstOrDefault() ?? Device,
            Devices: GetDevices());

        public void Load(PythonInferenceLoadRequest request)
        {
            ModelPath = request.ModelPath;
            PythonExecutable = request.PythonExecutable;
            WorkingDirectory = request.WorkingDirectory;
            Devices.Clear();
            foreach (var device in request.Devices ?? [])
            {
                if (!string.IsNullOrWhiteSpace(device) && !Devices.Contains(device, StringComparer.OrdinalIgnoreCase))
                    Devices.Add(device.Trim());
            }
            if (Devices.Count == 0 && !string.IsNullOrWhiteSpace(request.Device))
                Devices.Add(request.Device.Trim());
            Device = Devices.FirstOrDefault() ?? "cuda:0";
            AdditionalDeviceRoutes = string.Join(", ", Devices.Where(device => !PythonDeviceRoutes.Any(route => string.Equals(route.Value, device, StringComparison.OrdinalIgnoreCase))));
            Devices.RemoveAll(device => !PythonDeviceRoutes.Any(route => string.Equals(route.Value, device, StringComparison.OrdinalIgnoreCase)));
            Device = GetDevices().FirstOrDefault() ?? "cuda:0";
            GpuMemoryUtilization = request.GpuMemoryUtilization;
            MaxModelLength = (int)Math.Min(int.MaxValue, request.MaxModelLength);
            TensorParallelSize = request.TensorParallelSize;
            TrustRemoteCode = request.TrustRemoteCode;
        }

        public void Reset()
        {
            PythonExecutable = "python3";
            Device = "cuda:0";
            Devices.Clear();
            Devices.Add(Device);
            AdditionalDeviceRoutes = string.Empty;
            GpuMemoryUtilization = 90;
            MaxModelLength = 2048;
            TensorParallelSize = 1;
            TrustRemoteCode = true;
        }

        public bool IsDeviceSelected(string device) => Devices.Contains(device, StringComparer.OrdinalIgnoreCase);

        private IReadOnlyList<string> GetDevices() => Devices
            .Concat(AdditionalDeviceRoutes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Where(device => !string.IsNullOrWhiteSpace(device))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

