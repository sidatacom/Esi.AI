@page "/backends"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable

@using System.Text.Json
@using Esi.AI.Models
@inject IDataService DataService
@inject IModelRuntimeEvents RuntimeEvents
@inject IBackendRequirementEvents RequirementEvents

<div class="page-header">
    <div>
        <p class="eyebrow">LOCAL INFERENCE / CONTROL ROOM</p>
    </div>
    <div class="backend-mark"><span></span> @ActiveBackendLabel</div>
</div>

<section class="loaded-models global-loaded-models" aria-labelledby="loaded-models-heading">
    <div class="loaded-models-heading">
        <div>
            <p class="eyebrow">ACTIVE RUNTIMES</p>
            <h2 id="loaded-models-heading">Loaded models</h2>
        </div>
        <div class="loaded-models-status">
            <div class="runtime-status @GetRuntimeStatusClass()" role="status" aria-live="polite">
                <span class="runtime-status-dot"></span>
                <div>
                    <strong>@GetRuntimeStatusLabel()</strong>
                    <span>@GetRuntimeStatusDetail()</span>
                </div>
            </div>
            <span class="device-count">@GetLoadedModelsCountLabel()</span>
        </div>
    </div>
    @if (isInitializing)
    {
        <p class="loaded-models-empty">Checking active runtimes...</p>
    }
    else if (loadStatus?.LoadedModels.Count > 0)
    {
        @foreach (var model in loadStatus.LoadedModels)
        {
            <article class="loaded-model @(model.IsLoading ? "loaded-model-loading" : "")">
                <div class="loaded-model-topline">
                    <div>
                        <strong>@Path.GetFileName(model.ModelPath)</strong>
                        <span>@(model.IsLoading ? $"Loading on {model.Runtime}..." : FormatLoadedModelSummary(model))</span>
                    </div>
                    @if (model.IsLoading)
                    {
                        <span class="loading-model-status" role="status">Loading...</span>
                    }
                    else
                    {
                        <button class="profile-button" type="button" @onclick="() => UnloadModelAsync(model)">Unload</button>
                    }
                </div>
                <div class="loaded-model-devices">
                    @foreach (var device in model.VulkanDevices.Where(device => !IsExcludedDevice(device.Description ?? device.Name) && (device.AssignedLayerCount > 0 || device.ModelBufferMiB is not null)))
                    {
                        <span><b>@device.Name</b> @FormatLoadedModelDevice(model, device)</span>
                    }
                    @if (model.CpuModelBufferMiB is not null)
                    {
                        <span><b>CPU</b> @FormatMemory(model.CpuModelBufferMiB)</span>
                    }
                </div>
                <details class="runtime-log-details">
                    <summary>Load output</summary>
                    <textarea class="form-control log-output" rows="8" readonly>@(string.IsNullOrWhiteSpace(model.LoadLog) ? "No runtime output was captured." : model.LoadLog)</textarea>
                </details>
            </article>
        }
    }
    else
    {
        <p class="loaded-models-empty">No models loaded.</p>
    }
</section>

<details class="backend-support-matrix" open="@(!AreMatrixChecksReady)">
    <summary class="section-heading backend-support-summary">
        <div>
            <p class="eyebrow">GPU COMPATIBILITY MATRIX</p>
            <h2 id="backend-support-heading">Vendor and driver support</h2>
        </div>
    </summary>
    <div class="table-scroll">
        <table class="support-matrix-table">
            <thead>
                <tr>
                    <th scope="col">Backend</th>
                    <th scope="col">NVIDIA / CUDA</th>
                    <th scope="col">Intel / XPU</th>
                    <th scope="col">AMD / ROCm</th>
                    <th scope="col">Multi-GPU</th>
                    <th scope="col">Multi-vendor</th>
                    <th scope="col">Driver strategy</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in BackendGpuSupportMatrix)
                {
                    <tr>
                        <th scope="row">@row.Backend</th>
                        <td>
                            @if (ShouldShowMatrixRequirementsButton(row.Backend, "NVIDIA / CUDA", row.Nvidia))
                            {
                                <button class="matrix-support-button" type="button" @onclick='() => OpenMatrixRequirementsDialogAsync(row.Backend, "NVIDIA / CUDA")' aria-label="Show requirements for @row.Backend on NVIDIA / CUDA">
                                    Requirements
                                </button>
                            }
                            else
                            {
                                @row.Nvidia
                            }
                        </td>
                        <td>
                            @if (ShouldShowMatrixRequirementsButton(row.Backend, "Intel / XPU", row.Intel))
                            {
                                <button class="matrix-support-button" type="button" @onclick='() => OpenMatrixRequirementsDialogAsync(row.Backend, "Intel / XPU")' aria-label="Show requirements for @row.Backend on Intel / XPU">
                                    Requirements
                                </button>
                            }
                            else
                            {
                                @row.Intel
                            }
                        </td>
                        <td>
                            @if (ShouldShowMatrixRequirementsButton(row.Backend, "AMD / ROCm", row.Amd))
                            {
                                <button class="matrix-support-button" type="button" @onclick='() => OpenMatrixRequirementsDialogAsync(row.Backend, "AMD / ROCm")' aria-label="Show requirements for @row.Backend on AMD / ROCm">
                                    Requirements
                                </button>
                            }
                            else
                            {
                                @row.Amd
                            }
                        </td>
                        <td>@row.MultiGpu</td>
                        <td>@row.MultiVendor</td>
                        <td>@row.DriverStrategy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</details>

@if (matrixDialogVendor is not null && matrixDialogBackend is not null)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseMatrixRequirementsDialog">
        <section class="backend-requirements-dialog" role="dialog" aria-modal="true" aria-labelledby="backend-requirements-title" @onclick:stopPropagation="true">
            <div class="dialog-heading">
                <div>
                    <p class="eyebrow">BACKEND REQUIREMENTS</p>
                    <h2 id="backend-requirements-title">@matrixDialogBackend</h2>
                    <p class="dialog-context">Requirements for @matrixDialogBackend in the @matrixDialogVendor context.</p>
                </div>
                <button class="dialog-close-button" type="button" @onclick="CloseMatrixRequirementsDialog" aria-label="Close backend requirements">×</button>
            </div>
            <div class="backend-requirement-tiles">
                @foreach (var tile in GetMatrixRequirementTiles(matrixDialogVendor).Where(tile => tile.Backend == matrixDialogBackendTab))
                {
                    <article class="backend-requirement-tile @(tile.IsSupported ? "" : "backend-requirement-tile-disabled") @(tile.Backend == matrixDialogBackendTab ? "backend-requirement-tile-selected" : "")">
                        <div class="backend-requirement-tile-heading">
                            <h3>@tile.Name</h3>
                            <span class="backend-requirement-status">@tile.SupportStatus</span>
                        </div>
                        <p>@tile.Detail</p>
                        <button class="profile-button" type="button" @onclick="() => SolveMatrixBackendAsync(tile.Backend)" disabled="@(isMatrixActionRunning || !tile.CanOpen)">
                            @(tile.CanSolve ? "Solve requirements" : "Open backend")
                        </button>
                    </article>
                }
            </div>
            @if (isLoadingMatrixDialog)
            {
                <p class="empty-state">Checking requirements for this backend and vendor...</p>
            }
            else if (matrixDialogDiagnostics is not null)
            {
                <ol class="validation-steps matrix-dialog-checks">
                    @for (var index = 0; index < matrixDialogDiagnostics.Checks.Count; index++)
                    {
                        var check = matrixDialogDiagnostics.Checks[index];
                        <li class="validation-step @(check.IsAvailable ? "validation-step-ok" : check.IsOptional ? "validation-step-info" : "validation-step-error")">
                            <span class="validation-step-number">@((index + 1).ToString("00"))</span>
                            <span class="validation-step-indicator" aria-hidden="true">@(check.IsAvailable ? "OK" : check.IsOptional ? "i" : "!")</span>
                            <span class="validation-step-copy">
                                <strong>@check.Name</strong>
                                <small>@check.Detail</small>
                            </span>
                        </li>
                    }
                </ol>
                <p class="validation-summary @(matrixDialogDiagnostics.IsReady ? "validation-summary-ok" : "validation-summary-error")">
                    @(matrixDialogDiagnostics.IsReady ? "Requirements are ready." : "Requirements need attention.")
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(matrixDialogStatus))
            {
                <p class="matrix-dialog-status" role="status">@matrixDialogStatus</p>
            }
        </section>
    </div>
}

<nav class="backend-tabs" aria-label="Inference backends">
    <button class="backend-tab @(activeBackend == BackendTab.Llama ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.Llama)">
        <span>LLama</span>
        <small>GGUF / LLamaSharp</small>
    </button>
    <button class="backend-tab @(activeBackend == BackendTab.OpenVino ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.OpenVino)">
        <span>OpenVINO</span>
        <small>IR or ONNX / GenAI</small>
    </button>
    <button class="backend-tab @(activeBackend == BackendTab.Vllm ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.Vllm)">
        <span>vLLM</span>
        <small>Python engine</small>
    </button>
    <button class="backend-tab @(activeBackend == BackendTab.Sglang ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.Sglang)">
        <span>SGLang</span>
        <small>Python engine</small>
    </button>
    <button class="backend-tab @(activeBackend == BackendTab.DotLlm ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.DotLlm)">
        <span>dotLLM</span>
        <small>Native .NET / GGUF</small>
    </button>
</nav>

<div class="backend-sections">
<section class="config-panel shared-model-config">
    <div class="section-heading">
        <div><p class="eyebrow">SHARED MODEL CATALOG</p><h2>Model and configuration</h2></div>
        <span class="step-label">00</span>
    </div>
    <div class="model-load-row">
        <div class="model-picker">
            <label class="form-label" for="shared-model-picker">Model for @GetBackendLabel(activeBackend)</label>
            <select id="shared-model-picker" class="form-select" @bind="SharedModelPath" @bind:after="SelectSharedModelAsync">
                <option value="">Select a model...</option>
                @if (!string.IsNullOrWhiteSpace(CurrentModelPath) && !CurrentBackendModels.Any(model => string.Equals(model.Path, CurrentModelPath, StringComparison.OrdinalIgnoreCase)))
                {
                    <option value="@CurrentModelPath">@Path.GetFileName(CurrentModelPath) (saved path)</option>
                }
                @foreach (var model in CurrentBackendModels)
                {
                    <option value="@model.Path">@model.Name</option>
                }
            </select>
            @if (CurrentBackendModels.Count == 0)
            {
                <span class="picker-note">No stored models are available. Reference: @CurrentReferenceModel?.ModelId (@CurrentReferenceModel?.EnvironmentVariable)</span>
            }
            else
            {
                <span class="picker-note">Reference: @CurrentReferenceModel?.ModelId (@CurrentReferenceModel?.EnvironmentVariable)</span>
            }
        </div>
        <div class="profile-select">
            <label class="form-label" for="shared-configuration-profile">Configuration set</label>
            <select id="shared-configuration-profile" class="form-select" value="@selectedProfileId" @onchange="SelectProfileAsync" disabled="@string.IsNullOrWhiteSpace(CurrentModelPath)">
                <option value="">Select a saved set...</option>
                @foreach (var profile in MatchingProfiles)
                {
                    <option value="@profile.Id">@profile.Name</option>
                }
            </select>
        </div>
        <div class="profile-actions">
            <button class="profile-button" type="button" @onclick="CreateProfileAsync" disabled="@string.IsNullOrWhiteSpace(CurrentModelPath)">Create</button>
            <button class="profile-button" type="button" @onclick="UpdateProfileAsync" disabled="@(!selectedProfileId.HasValue)">Update</button>
            <button class="profile-button" type="button" @onclick="OpenAssignProfileAsync" disabled="@(!BackendProfiles.Any())">Assign</button>
            <button class="load-button" type="button" @onclick="LoadActiveBackendModelAsync" disabled="@IsCurrentModelLoadDisabled">@GetLoadButtonLabel()</button>
        </div>
    </div>

    @if (isAssigningProfile)
    {
        <div class="profile-create-row">
            <label class="form-label" for="shared-assign-source-profile">Configuration to copy</label>
            <div class="profile-create-fields">
                <select id="shared-assign-source-profile" class="form-select" value="@assignSourceProfileId" @onchange="SelectAssignSourceProfileAsync">
                    <option value="">Select a configuration...</option>
                    @foreach (var profile in BackendProfiles.OrderBy(profile => profile.Name))
                    {
                        <option value="@profile.Id">@profile.Name (@Path.GetFileName(profile.ModelPath))</option>
                    }
                </select>
                <label class="form-label" for="shared-assign-target-model">Target model</label>
                <select id="shared-assign-target-model" class="form-select" value="@profileTargetModelPath" @onchange="SelectProfileTargetModelAsync">
                    <option value="">Select a model...</option>
                    @foreach (var model in CurrentBackendModels)
                    {
                        <option value="@model.Path">@model.Name</option>
                    }
                </select>
                <button class="profile-button profile-button-primary" type="button" @onclick="AssignProfileToModelAsync" disabled="@(!assignSourceProfileId.HasValue || string.IsNullOrWhiteSpace(profileTargetModelPath))">Copy</button>
                <button class="profile-button" type="button" @onclick="CancelAssignProfile">Cancel</button>
            </div>
        </div>
    }

    @if (isCreatingProfile)
    {
        <div class="profile-create-row">
            <label class="form-label" for="shared-new-profile-name">Set name</label>
            <div class="profile-create-fields">
                <InputText id="shared-new-profile-name" class="form-control" @bind-Value="newProfileName" />
                <button class="profile-button profile-button-primary" type="button" @onclick="SaveNewProfileAsync">Save</button>
                <button class="profile-button" type="button" @onclick="CancelCreateProfile">Cancel</button>
            </div>
        </div>
    }

    <section class="gpu-panel shared-device-routing">
        <div class="section-heading">
            <div>
                <p class="eyebrow">DEVICE ROUTING</p>
                <h2>@GetBackendLabel(activeBackend) device</h2>
            </div>
            <span class="device-count">@GetRoutingDeviceCount()</span>
        </div>
        <p class="panel-note">Device routing is saved with this model configuration. The onboard Intel UHD 630 is excluded.</p>
        @if (activeBackend == BackendTab.OpenVino)
        {
            <p class="panel-note">Enable devices with a compatible vendor driver for OpenVINO MULTI scheduling, or select one accelerator route.</p>
            @if (openVinoDiagnostics?.Devices.Any(device => !IsExcludedDevice(device.Name)) == true)
            {
                @foreach (var device in openVinoDiagnostics.Devices.Where(device => !IsExcludedDevice(device.Name)))
                {
                    <div class="gpu-row @(device.IsCompatible ? "" : "gpu-row-disabled")">
                        <div class="gpu-identity">
                            <input class="form-check-input" type="checkbox" id="openvino-device-@device.Id"
                                   checked="@(device.IsCompatible && GetOpenVinoDeviceSetting(device.Id).Enabled)"
                                   disabled="@(!device.IsCompatible || IsExcludedDevice(device.Name))"
                                   @onchange="async eventArgs => await SetOpenVinoDeviceEnabledAsync(device.Id, eventArgs.Value is true)" />
                            <label class="gpu-name" for="openvino-device-@device.Id">
                                <strong>@device.Name</strong>
                                <span>@device.Vendor · @device.Driver · @device.Detail</span>
                            </label>
                        </div>
                        <div class="weight-field">
                            <label for="@($"openvino-weight-{device.Id}")">Priority</label>
                            <input id="@($"openvino-weight-{device.Id}")" class="form-control" type="number" min="0" step="0.1"
                                   disabled="@(!device.IsCompatible || IsExcludedDevice(device.Name))"
                                   value="@GetOpenVinoDeviceSetting(device.Id).Weight.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                   @onchange="async eventArgs => await SetOpenVinoDeviceWeightAsync(device.Id, eventArgs.Value?.ToString())" />
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No OpenVINO devices found.</p>
            }
        }
        else if (activeBackend == BackendTab.Llama)
        {
            <p class="panel-note">Enable Vulkan devices from any installed vendor driver and assign their relative tensor split weight.</p>
            @if (loadStatus?.VulkanDevices.Count > 0)
            {
                @foreach (var device in loadStatus.VulkanDevices.Where(device => !IsExcludedDevice(device.Description ?? device.Name)))
                {
                    <div class="gpu-row">
                        <div class="gpu-identity">
                            <input class="form-check-input" type="checkbox" id="device-@device.Name"
                                   checked="@GetDeviceSetting(device.Name).Enabled"
                                   @onchange="async eventArgs => await SetDeviceEnabledAsync(device.Name, eventArgs.Value is true)" />
                            <label class="gpu-name" for="device-@device.Name">
                                <strong>@(device.Description ?? device.Name)</strong>
                                <span>@device.Name · @GetVulkanDriverLabel(device)</span>
                            </label>
                        </div>
                        <div class="weight-field">
                            <label for="@($"weight-{device.Name}")">Weight</label>
                            <input id="@($"weight-{device.Name}")" class="form-control" type="number" min="0" step="0.1"
                                   value="@GetDeviceSetting(device.Name).Weight.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                   @onchange="async eventArgs => await SetDeviceWeightAsync(device.Name, eventArgs.Value?.ToString())" />
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No Vulkan devices found.</p>
            }
        }
        else if (activeBackend is BackendTab.Vllm or BackendTab.Sglang)
        {
            <div class="field-group">
                <label class="form-label">Accelerator devices</label>
                <div class="python-device-list">
                    @foreach (var route in PythonDeviceRoutes.Where(route => route.Backends.Contains(activeBackend)))
                    {
                        <label class="python-device-option">
                            <input class="form-check-input" type="checkbox"
                                   checked="@pythonForm.IsDeviceSelected(route.Value)"
                                   @onchange="async eventArgs => await SetPythonDeviceSelectedAsync(route.Value, eventArgs.Value is true)" />
                            <span>@route.Label</span>
                        </label>
                    }
                </div>
                <label class="form-label" for="python-additional-device-routes">Additional device routes</label>
                <InputText id="python-additional-device-routes" class="form-control" @bind-Value="pythonForm.AdditionalDeviceRoutes" @bind-Value:after="SaveSettingsAsync" placeholder="cuda:1, cuda:2" />
                <small class="form-text">The requirements environment follows the selected device vendor. CUDA and XPU devices cannot be mixed in one worker.</small>
            </div>
        }
        else
        {
            <div class="field-group">
                <label class="form-label" for="dotllm-device-route">Device route</label>
                <InputText id="dotllm-device-route" class="form-control" @bind-Value="dotLlmForm.Device" @bind-Value:after="SaveSettingsAsync" />
            </div>
        }
    </section>
</section>

@if (activeBackend != BackendTab.OpenVino)
{
    <section class="driver-validation-panel backend-prerequisites-panel">
        <details open="@(!IsBackendPrerequisitesReady)">
            <summary class="section-heading driver-validation-summary">
                <div>
                    <p class="eyebrow">BACKEND REQUIREMENTS</p>
                    <h2>@(backendPrerequisites?.BackendName ?? GetBackendLabel(activeBackend))</h2>
                </div>
                <span class="validation-summary @(IsBackendPrerequisitesReady ? "validation-summary-ok" : "validation-summary-error")">
                    @(IsBackendPrerequisitesReady ? "Ready" : "Needs attention")
                </span>
            </summary>
            <div class="driver-validation-content">
                <button class="profile-button" type="button" @onclick="RefreshBackendPrerequisitesAsync" disabled="@isCheckingPrerequisites">
                    @(isCheckingPrerequisites ? "Checking..." : "Recheck")
                </button>
                @if (backendPrerequisites is null)
                {
                    <p class="empty-state">Checking backend requirements...</p>
                }
                else
                {
                    <ol class="validation-steps">
                        @for (var index = 0; index < backendPrerequisites.Checks.Count; index++)
                        {
                            var check = backendPrerequisites.Checks[index];
                            <li class="validation-step @(check.IsAvailable ? "validation-step-ok" : check.IsOptional ? "validation-step-info" : "validation-step-error")">
                                <span class="validation-step-number">@((index + 1).ToString("00"))</span>
                                <span class="validation-step-indicator" aria-hidden="true">@(check.IsAvailable ? "OK" : check.IsOptional ? "i" : "!")</span>
                                <span class="validation-step-copy">
                                    <strong>@check.Name</strong>
                                    <small>@check.Detail</small>
                                    @if (!check.IsAvailable && !check.IsOptional && check.CanSolve)
                                    {
                                        <button class="validation-solve-button" type="button" @onclick="PrepareBackendPrerequisitesAsync" disabled="@isPreparingPrerequisites">
                                            @(isPreparingPrerequisites ? "Preparing..." : "Prepare")
                                        </button>
                                    }
                                </span>
                            </li>
                        }
                    </ol>
                    <p class="validation-summary @(IsBackendPrerequisitesReady ? "validation-summary-ok" : "validation-summary-error")">
                        @(IsBackendPrerequisitesReady ? "Backend requirements are ready." : "Model loading is disabled until the required backend checks pass.")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(backendPrerequisites.Error))
                    {
                        <details class="solve-output" open>
                            <summary>Diagnostic details</summary>
                            <textarea class="form-control log-output" rows="8" readonly>@backendPrerequisites.Error</textarea>
                        </details>
                    }
                    @if (!string.IsNullOrWhiteSpace(prerequisiteOutput))
                    {
                        <details class="solve-output" open>
                            <summary>Preparation output</summary>
                            <textarea class="form-control log-output" rows="8" readonly>@prerequisiteOutput</textarea>
                        </details>
                    }
                }
            </div>
        </details>
    </section>
}

@if (activeBackend is BackendTab.Vllm or BackendTab.Sglang)
{
    <section class="config-panel">
        <div class="section-heading"><div><p class="eyebrow">PYTHON INFERENCE SERVER</p><h2>Load configuration</h2></div><span class="step-label">01</span></div>
        <div class="field-row">
            <div class="field-group"><label class="form-label" for="python-model">Model path or Hugging Face ID</label><InputText id="python-model" class="form-control" @bind-Value="pythonForm.ModelPath" placeholder="Qwen/Qwen3.8-Flash-Next" /></div>
            <div class="field-group"><label class="form-label" for="python-executable">Python executable (optional override)</label><InputText id="python-executable" class="form-control" @bind-Value="pythonForm.PythonExecutable" @bind-Value:after="RefreshBackendPrerequisitesAsync" /></div>
        </div>
        <div class="field-row">
            <div class="field-group"><label class="form-label" for="python-context">Max model length</label><InputNumber id="python-context" class="form-control" @bind-Value="pythonForm.MaxModelLength" /></div>
            <div class="field-group"><label class="form-label" for="python-tp">Tensor parallel size</label><InputNumber id="python-tp" class="form-control" @bind-Value="pythonForm.TensorParallelSize" /></div>
            <div class="field-group"><label class="form-label" for="python-gpu-memory">GPU memory utilization (%)</label><InputNumber id="python-gpu-memory" class="form-control" @bind-Value="pythonForm.GpuMemoryUtilization" /></div>
        </div>
        <label class="setting-toggle"><InputCheckbox @bind-Value="pythonForm.TrustRemoteCode" /> Trust remote code</label>
        @if (!string.IsNullOrWhiteSpace(pythonStatus)) { <p class="mt-3" role="status">@pythonStatus</p> }
    </section>

    @if (GetBackendLoadLog() is { } backendLoadLog)
    {
        <section class="telemetry-panel backend-load-log-panel" aria-labelledby="backend-load-log-heading">
            <div class="section-heading">
                <div><p class="eyebrow">BACKEND LOAD LOG</p><h2 id="backend-load-log-heading">@GetBackendLabel(activeBackend) output</h2></div>
            </div>
            <textarea class="form-control log-output" rows="14" readonly>@backendLoadLog</textarea>
        </section>
    }

    <section class="telemetry-panel">
        <div class="section-heading"><div><p class="eyebrow">RUNTIME TELEMETRY</p><h2>Python engine status</h2></div></div>
        <dl class="telemetry-grid">
            <dt>Engine</dt>
            <dd>@GetBackendLabel(activeBackend)</dd>
            <dt>Python executable</dt>
            <dd>@pythonForm.PythonExecutable</dd>
            <dt>Model</dt>
            <dd>@(string.IsNullOrWhiteSpace(pythonForm.ModelPath) ? "Not selected" : pythonForm.ModelPath)</dd>
            <dt>Transport</dt>
            <dd>Local gRPC bridge</dd>
            <dt>Runtime</dt>
            <dd class="diagnostic-@(loadStatus?.Backend is "vLLM" or "SGLang" ? "ok" : "error")">@(isPythonLoading ? "Starting" : loadStatus?.Backend is "vLLM" or "SGLang" ? "Ready" : "Not running")</dd>
        </dl>
    </section>
}

@if (activeBackend == BackendTab.DotLlm)
{
    <section class="config-panel">
        <div class="section-heading"><div><p class="eyebrow">NATIVE .NET INFERENCE</p><h2>dotLLM configuration</h2></div><span class="step-label">01</span></div>
        <div class="field-row">
            <div class="field-group"><label class="form-label" for="dotllm-model">GGUF model path or ID</label><InputText id="dotllm-model" class="form-control" @bind-Value="dotLlmForm.ModelPath" /></div>
            <div class="field-group"><label class="form-label" for="dotllm-device">Device</label><InputText id="dotllm-device" class="form-control" @bind-Value="dotLlmForm.Device" placeholder="cpu" /></div>
            <div class="field-group"><label class="form-label" for="dotllm-threads">CPU threads</label><InputNumber id="dotllm-threads" class="form-control" @bind-Value="dotLlmForm.Threads" /></div>
        </div>
        <div class="model-actions"><button class="profile-button" type="button" @onclick="StopDotLlmModelAsync" disabled="@(!isDotLlmLoading && loadStatus?.Backend != "dotLLM")">Unload dotLLM</button></div>
        @if (!string.IsNullOrWhiteSpace(dotLlmStatus)) { <p class="mt-3" role="status">@dotLlmStatus</p> }
    </section>

    <section class="telemetry-panel">
        <div class="section-heading"><div><p class="eyebrow">RUNTIME TELEMETRY</p><h2>dotLLM status</h2></div></div>
        <dl class="telemetry-grid">
            <dt>Model</dt>
            <dd>@(string.IsNullOrWhiteSpace(dotLlmForm.ModelPath) ? "Not selected" : dotLlmForm.ModelPath)</dd>
            <dt>Device</dt>
            <dd>@dotLlmForm.Device</dd>
            <dt>Runtime</dt>
            <dd class="diagnostic-@(loadStatus?.Backend == "dotLLM" ? "ok" : "error")">@(isDotLlmLoading ? "Loading in process" : loadStatus?.Backend == "dotLLM" ? "Ready in process" : "Not loaded")</dd>
        </dl>
    </section>
}

@if (activeBackend == BackendTab.Llama)
{
<div class="llama-workspace">

    <section class="config-panel">
        <div class="section-heading">
            <div>
                <p class="eyebrow">MODEL INPUT</p>
                <h2>Load configuration</h2>
            </div>
            <span class="step-label">01</span>
        </div>

    <div class="settings-panels">
        <details class="settings-panel">
            <summary>Model loading</summary>
            <div class="field-group">
                <label class="form-label" for="model-path">GGUF model path</label>
                <InputText id="model-path" class="form-control" @bind-Value="form.ModelPath" @bind-Value:after="SaveSettingsAsync" />
            </div>
            <div class="field-row">
                <div class="field-group">
                    <label class="form-label" for="backend">Backend</label>
                    <InputSelect id="backend" class="form-select" @bind-Value="form.Backend" @bind-Value:after="SaveSettingsAsync">
                        <option value="Vulkan">Vulkan</option>
                        <option value="CPU">CPU</option>
                    </InputSelect>
                </div>

                <div class="field-group">
                    <label class="form-label" for="gpu-layers">GPU layers</label>
                    <InputNumber id="gpu-layers" class="form-control" @bind-Value="form.GpuLayerCount" @bind-Value:after="SaveSettingsAsync" />
                </div>

                <div class="field-group">
                    <label class="form-label" for="context-size">Context size</label>
                    <InputSelect id="context-size" class="form-select" @bind-Value="form.ContextSize" @bind-Value:after="SaveSettingsAsync">
                        @foreach (var size in ContextSizes)
                        {
                            <option value="@size.Value">@size.Label</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </details>

        <details class="settings-panel">
            <summary>GPU and memory</summary>
            <div class="field-row">
                <div class="field-group"><label class="form-label">Main GPU</label><InputNumber class="form-control" @bind-Value="advanced.MainGpu" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Threads</label><InputNumber class="form-control" @bind-Value="advanced.Threads" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Batch threads</label><InputNumber class="form-control" @bind-Value="advanced.BatchThreads" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.UseMemorymap" @bind-Value:after="SaveSettingsAsync" /> Use memory mapping</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.UseDirectIO" @bind-Value:after="SaveSettingsAsync" /> Use direct I/O</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.UseMemoryLock" @bind-Value:after="SaveSettingsAsync" /> Lock model memory</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.OpOffload" @bind-Value:after="SaveSettingsAsync" /> Offload operations</label>
        </details>

        <details class="settings-panel">
            <summary>Context and batching</summary>
            <div class="field-row">
                <div class="field-group"><label class="form-label">Max sequences</label><InputNumber class="form-control" @bind-Value="advanced.SeqMax" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Batch size</label><InputNumber class="form-control" @bind-Value="advanced.BatchSize" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Physical batch size</label><InputNumber class="form-control" @bind-Value="advanced.UBatchSize" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.Embeddings" @bind-Value:after="SaveSettingsAsync" /> Embeddings mode</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.VocabOnly" @bind-Value:after="SaveSettingsAsync" /> Vocabulary only</label>
        </details>

        <details class="settings-panel">
            <summary>Attention and cache</summary>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.NoKqvOffload" @bind-Value:after="SaveSettingsAsync" /> Keep K/Q/V on CPU</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.FlashAttention" @bind-Value:after="SaveSettingsAsync" /> Flash attention</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.SwaFull" @bind-Value:after="SaveSettingsAsync" /> Full sliding-window attention</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.KVUnified" @bind-Value:after="SaveSettingsAsync" /> Unified KV cache</label>
        </details>

        <details class="settings-panel">
            <summary>LLamaSharp model options</summary>
            <div class="field-row">
                <div class="field-group"><label class="form-label">Context type</label><InputSelect class="form-select" @bind-Value="advanced.ContextType" @bind-Value:after="SaveSettingsAsync"><option value="Default">Default</option><option value="Mtp">MTP</option></InputSelect></div>
                <div class="field-group"><label class="form-label">KV type K</label><InputSelect class="form-select" @bind-Value="advanced.TypeK" @bind-Value:after="SaveSettingsAsync"><option value="">Model default</option><option value="F16">F16</option><option value="Q8_0">Q8_0</option><option value="Q4_K">Q4_K</option></InputSelect></div>
                <div class="field-group"><label class="form-label">KV type V</label><InputSelect class="form-select" @bind-Value="advanced.TypeV" @bind-Value:after="SaveSettingsAsync"><option value="">Model default</option><option value="F16">F16</option><option value="Q8_0">Q8_0</option><option value="Q4_K">Q4_K</option></InputSelect></div>
            </div>
            <div class="field-row">
                <div class="field-group"><label class="form-label">Pooling type</label><InputSelect class="form-select" @bind-Value="advanced.PoolingType" @bind-Value:after="SaveSettingsAsync"><option value="Unspecified">Unspecified</option><option value="None">None</option><option value="Mean">Mean</option><option value="CLS">CLS</option><option value="Last">Last</option><option value="Rank">Rank</option></InputSelect></div>
                <div class="field-group"><label class="form-label">Attention type</label><InputSelect class="form-select" @bind-Value="advanced.AttentionType" @bind-Value:after="SaveSettingsAsync"><option value="Unspecified">Unspecified</option><option value="Causal">Causal</option><option value="NonCausal">Non-causal</option></InputSelect></div>
                <div class="field-group"><label class="form-label">YARN scaling type</label><InputSelect class="form-select" @bind-Value="advanced.YarnScalingType" @bind-Value:after="SaveSettingsAsync"><option value="">Model default</option><option value="Linear">Linear</option><option value="YaRN">YaRN</option></InputSelect></div>
            </div>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.CheckTensors" @bind-Value:after="SaveSettingsAsync" /> Check tensors</label>
        </details>

        <details class="settings-panel">
            <summary>Sampling and generation</summary>
            <div class="field-row">
                <div class="field-group"><label class="form-label">Temperature</label><InputNumber class="form-control" @bind-Value="advanced.Temperature" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Top K</label><InputNumber class="form-control" @bind-Value="advanced.TopK" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Top P</label><InputNumber class="form-control" @bind-Value="advanced.TopP" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Min P</label><InputNumber class="form-control" @bind-Value="advanced.MinP" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
            <div class="field-row">
                <div class="field-group"><label class="form-label">Repeat penalty</label><InputNumber class="form-control" @bind-Value="advanced.RepeatPenalty" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Frequency penalty</label><InputNumber class="form-control" @bind-Value="advanced.FrequencyPenalty" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Presence penalty</label><InputNumber class="form-control" @bind-Value="advanced.PresencePenalty" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Penalty count</label><InputNumber class="form-control" @bind-Value="advanced.PenaltyCount" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
            <div class="field-row">
                <div class="field-group"><label class="form-label">Max generated tokens</label><InputNumber class="form-control" @bind-Value="advanced.MaxTokens" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Tokens to keep</label><InputNumber class="form-control" @bind-Value="advanced.TokensKeep" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">Seed</label><InputNumber class="form-control" @bind-Value="advanced.Seed" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
            <label class="setting-toggle"><InputCheckbox @bind-Value="advanced.DecodeSpecialTokens" @bind-Value:after="SaveSettingsAsync" /> Decode special tokens</label>
        </details>

        <details class="settings-panel">
            <summary>RoPE and YARN scaling</summary>
            <div class="field-row">
                <div class="field-group"><label class="form-label">RoPE frequency base</label><InputNumber class="form-control" @bind-Value="advanced.RopeFrequencyBase" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">RoPE frequency scale</label><InputNumber class="form-control" @bind-Value="advanced.RopeFrequencyScale" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">YARN original context</label><InputNumber class="form-control" @bind-Value="advanced.YarnOriginalContext" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">YARN extrapolation</label><InputNumber class="form-control" @bind-Value="advanced.YarnExtrapolationFactor" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">YARN attention factor</label><InputNumber class="form-control" @bind-Value="advanced.YarnAttentionFactor" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">YARN beta fast</label><InputNumber class="form-control" @bind-Value="advanced.YarnBetaFast" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">YARN beta slow</label><InputNumber class="form-control" @bind-Value="advanced.YarnBetaSlow" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
        </details>

    </div>
    </section>

    <section class="telemetry-panel">
        <div class="section-heading">
            <div>
                <p class="eyebrow">NATIVE TELEMETRY</p>
                <h2>Runtime status</h2>
            </div>
        </div>
        @if (loadStatus is not null)
        {
        <dl class="telemetry-grid">
        <dt>Backend</dt>
        <dd>@loadStatus.Backend, @loadStatus.GpuLayerCount GPU layers, @loadStatus.ContextSize tokens</dd>
        <dt>Found Vulkan GPUs</dt>
        <dd>@loadStatus.FoundVulkanGpuCount</dd>
        @foreach (var device in loadStatus.VulkanDevices)
        {
            <dt>@device.Name @(device.Description is null ? "" : $"({device.Description})")</dt>
            <dd>@device.AssignedLayerCount layers, @(device.ModelBufferMiB?.ToString("F2") ?? "-") MiB model buffer</dd>
        }
        @if (loadStatus.IsModelLoaded && loadStatus.CpuModelBufferMiB is not null)
        {
            <dt>CPU model buffer</dt>
            <dd>@loadStatus.CpuModelBufferMiB.Value.ToString("F2") MiB</dd>
        }
        @if (loadStatus.IsModelLoaded)
        {
            <dt>Model size</dt>
            <dd>@(loadStatus.ModelSizeInBytes / 1024d / 1024d / 1024d).ToString("F2") GiB</dd>
        }
        </dl>
        }
        else
        {
            <p class="empty-state">Waiting for backend discovery.</p>
        }
    </section>
</div>
}
else if (activeBackend == BackendTab.OpenVino)
{
    <div class="llama-workspace openvino-workspace">

        <details class="driver-validation-panel" open="@(!IsOpenVinoValidationReady)">
            <summary class="section-heading driver-validation-summary">
                <div>
                    <p class="eyebrow">OPENVINO PREREQUISITES</p>
                    <h2>Driver validation</h2>
                </div>
                <span class="validation-summary @(IsOpenVinoValidationReady ? "validation-summary-ok" : "validation-summary-error")">
                    @(IsOpenVinoValidationReady ? "Ready" : "Needs attention")
                </span>
            </summary>
            <div class="driver-validation-content">
                <button class="profile-button" type="button" @onclick="RefreshOpenVinoDiagnosticsAsync" disabled="@isCheckingOpenVino">
                    @(isCheckingOpenVino ? "Checking..." : "Recheck")
                </button>
            @if (openVinoDiagnostics is null)
            {
                <p class="empty-state">Checking the local Intel GPU and OpenVINO runtime...</p>
            }
            else
            {
                <ol class="validation-steps">
                    @for (var index = 0; index < openVinoDiagnostics.Checks.Count; index++)
                    {
                        var check = openVinoDiagnostics.Checks[index];
                        <li class="validation-step @(check.IsAvailable ? "validation-step-ok" : "validation-step-error")">
                            <span class="validation-step-number">@((index + 1).ToString("00"))</span>
                            <span class="validation-step-indicator" aria-hidden="true">@(check.IsAvailable ? "OK" : "!")</span>
                            <span class="validation-step-copy">
                                <strong>@check.Name</strong>
                                <small>@check.Detail</small>
                                @if (!check.IsAvailable && check.CanSolve)
                                {
                                    <button class="validation-solve-button" type="button" @onclick="() => SolveOpenVinoCheckAsync(check.Id)" disabled="@(solvingCheckId is not null)">
                                        @(solvingCheckId == check.Id ? "Installing..." : "Solve")
                                    </button>
                                }
                            </span>
                        </li>
                    }
                </ol>
                <p class="validation-summary @(openVinoDiagnostics.IsGpuReady || openVinoDiagnostics.IsNpuReady ? "validation-summary-ok" : "validation-summary-error")">
                    @(openVinoDiagnostics.IsGpuReady || openVinoDiagnostics.IsNpuReady ? "OpenVINO accelerator backend ready." : "No compatible OpenVINO accelerator is ready. Model loading is disabled.")
                </p>
                @if (!string.IsNullOrWhiteSpace(openVinoDiagnostics.Error))
                {
                    <details class="solve-output">
                        <summary>OpenVINO error details</summary>
                        <textarea class="form-control log-output" rows="10" readonly>@openVinoDiagnostics.Error</textarea>
                    </details>
                }
                @if (!string.IsNullOrWhiteSpace(openVinoInstallOutput))
                {
                    <details class="solve-output" open>
                        <summary>Driver installation output</summary>
                        <textarea class="form-control log-output" rows="10" readonly>@openVinoInstallOutput</textarea>
                    </details>
                }
                @if (solveRequiresLogin)
                {
                    <p class="solve-auth-message">
                        <a href="Account/Login?returnUrl=%2Fbackends">Sign in</a> to authorize driver installation, then run Solve again.
                    </p>
                }
            }
            </div>
        </details>

        <section class="config-panel">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">OPENVINO RUNTIME</p>
                    <h2>Load configuration</h2>
                </div>
                <span class="step-label">01</span>
            </div>

            <div class="settings-panels">
                <details class="settings-panel" open>
                    <summary>Model loading</summary>
                    <div class="field-group">
                            <label class="form-label" for="openvino-model-path">Custom GGUF file or IR directory</label>
                        <InputText id="openvino-model-path" class="form-control" @bind-Value="openVinoForm.ModelPath" @bind-Value:after="SelectOpenVinoModelAsync" />
                            <span class="picker-note">Use a supported .gguf file directly, or an OpenVINO IR/GenAI model directory.</span>
                    </div>
                    <div class="field-row">
                        <div class="field-group">
                            <label class="form-label">Active device route</label>
                            <input class="form-control" value="@openVinoForm.Device" readonly />
                        </div>
                        <div class="field-group">
                            <label class="form-label" for="openvino-cache">Cache directory</label>
                            <InputText id="openvino-cache" class="form-control" @bind-Value="openVinoForm.CacheDirectory" />
                        </div>
                    </div>
                </details>

                <details class="settings-panel" open>
                    <summary>Generation</summary>
                    <div class="field-row">
                        <div class="field-group"><label class="form-label" for="openvino-max-tokens">Max new tokens</label><InputNumber id="openvino-max-tokens" class="form-control" @bind-Value="openVinoForm.MaxNewTokens" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-temperature">Temperature</label><InputNumber id="openvino-temperature" class="form-control" @bind-Value="openVinoForm.Temperature" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-top-k">Top K</label><InputNumber id="openvino-top-k" class="form-control" @bind-Value="openVinoForm.TopK" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-top-p">Top P</label><InputNumber id="openvino-top-p" class="form-control" @bind-Value="openVinoForm.TopP" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-repetition-penalty">Repetition penalty</label><InputNumber id="openvino-repetition-penalty" class="form-control" @bind-Value="openVinoForm.RepetitionPenalty" /></div>
                    </div>
                    <label class="setting-toggle"><InputCheckbox @bind-Value="openVinoForm.DoSample" /> Enable sampling</label>
                </details>

                @if (openVinoForm.Device.StartsWith("NPU", StringComparison.OrdinalIgnoreCase))
                {
                    <details class="settings-panel" open>
                        <summary>NPU pipeline</summary>
                        <p class="panel-note">NPU pipelines use a bounded prompt and response context. These properties apply only when the active route is NPU.</p>
                        <div class="field-row">
                            <div class="field-group"><label class="form-label" for="openvino-max-prompt">Max prompt tokens</label><InputNumber id="openvino-max-prompt" class="form-control" @bind-Value="openVinoForm.MaxPromptLength" /></div>
                            <div class="field-group"><label class="form-label" for="openvino-min-response">Min response tokens</label><InputNumber id="openvino-min-response" class="form-control" @bind-Value="openVinoForm.MinResponseLength" /></div>
                        </div>
                        <div class="field-row">
                            <div class="field-group">
                                <label class="form-label" for="openvino-prefill-hint">Prefill hint</label>
                                <InputSelect id="openvino-prefill-hint" class="form-select" @bind-Value="openVinoForm.PrefillHint">
                                    <option value="DYNAMIC">Dynamic</option>
                                    <option value="STATIC">Static</option>
                                </InputSelect>
                            </div>
                            <div class="field-group">
                                <label class="form-label" for="openvino-generate-hint">Generate hint</label>
                                <InputSelect id="openvino-generate-hint" class="form-select" @bind-Value="openVinoForm.GenerateHint">
                                    <option value="FAST_COMPILE">Fast compile</option>
                                    <option value="BEST_PERF">Best performance</option>
                                </InputSelect>
                            </div>
                        </div>
                    </details>
                }
            </div>

        </section>

        <section class="telemetry-panel">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">RUNTIME TELEMETRY</p>
                    <h2>OpenVINO status</h2>
                </div>
            </div>
            <dl class="telemetry-grid">
                @if (openVinoDiagnostics is not null)
                {
                    @foreach (var check in openVinoDiagnostics.Checks)
                    {
                        <dt>@check.Name</dt>
                        <dd class="diagnostic-@(check.IsAvailable ? "ok" : "error")">@(check.IsAvailable ? "Available" : "Missing") - @check.Detail</dd>
                    }
                }
                <dt>Device</dt>
                <dd>@openVinoForm.Device</dd>
                <dt>Model</dt>
                <dd>@(string.IsNullOrWhiteSpace(openVinoForm.ModelPath) ? "Not selected" : Path.GetFileName(openVinoForm.ModelPath.TrimEnd(Path.DirectorySeparatorChar)))</dd>
                <dt>Runtime</dt>
                <dd>@(openVinoStatus ?? "Ready for model loading")</dd>
            </dl>
        </section>
    </div>
}

@if (activeBackend == BackendTab.Llama && isLoading)
{
    <p class="mt-3" role="status">Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="mt-3" role="status">@statusMessage</p>
}

</div>

@code {
    private BackendTab activeBackend = BackendTab.Llama;
    private readonly PythonForm pythonForm = new();
    private bool isPythonLoading;
    private string? pythonStatus;
    private readonly Dictionary<ConfigurationBackend, string> backendLoadLogs = [];
    private bool isOpenVinoLoading;
    private bool isOpenVinoModelLoaded;
    private bool isCheckingOpenVino;
    private bool isCheckingPrerequisites;
    private bool isPreparingPrerequisites;
    private string? prerequisiteOutput;
    private string? solvingCheckId;
    private string? openVinoStatus;
    private string? openVinoInstallOutput;
    private bool solveRequiresLogin;
    private OpenVinoDiagnosticsDto? openVinoDiagnostics;
    private BackendPrerequisiteDiagnostics? backendPrerequisites;
    private BackendRequirementState? backendRequirementState;
    private readonly OpenVinoForm openVinoForm = new();
    private readonly DotLlmForm dotLlmForm = new();
    private IReadOnlyList<BackendModel> backendModels = [];
    private bool isDotLlmLoading;
    private string? dotLlmStatus;
    private string? matrixDialogBackend;
    private string? matrixDialogVendor;
    private BackendTab? matrixDialogBackendTab;
    private BackendPrerequisiteDiagnostics? matrixDialogDiagnostics;
    private bool isLoadingMatrixDialog;
    private string? matrixDialogStatus;
    private bool isMatrixActionRunning;
    private readonly Dictionary<(BackendTab Backend, string Vendor), bool> matrixRequirementActions = [];

    private string ActiveBackendLabel => activeBackend switch
    {
        BackendTab.Llama => "LLama / Vulkan",
        BackendTab.OpenVino => $"OpenVINO / {openVinoForm.Device}",
        BackendTab.Vllm => "vLLM / Python",
        BackendTab.Sglang => "SGLang / Python",
        BackendTab.DotLlm => "dotLLM / Native .NET",
        _ => $"{GetBackendLabel(activeBackend)} / Python"
    };
    private bool IsOpenVinoValidationReady => openVinoDiagnostics?.IsGpuReady == true || openVinoDiagnostics?.IsNpuReady == true;
    private bool IsBackendPrerequisitesReady => backendPrerequisites?.IsReady == true;
    private bool AreMatrixChecksReady => backendRequirementState is not null &&
        !backendRequirementState.IsRefreshing &&
        matrixRequirementActions.Count > 0 &&
        matrixRequirementActions.Values.All(actionRequired => !actionRequired);
    private bool IsRuntimeLoading => isLoading || isOpenVinoLoading || isPythonLoading || isDotLlmLoading ||
        loadStatus?.LoadedModels.Any(model => model.IsLoading) == true;
    private ConfigurationBackend CurrentPrerequisiteBackend => GetConfigurationBackend(activeBackend);
    private IReadOnlyList<Model> Models => databaseModels
        .Where(model => string.Equals(Path.GetExtension(model.Path), ".gguf", StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private IReadOnlyList<BackendModel> CurrentBackendModels => backendModels
