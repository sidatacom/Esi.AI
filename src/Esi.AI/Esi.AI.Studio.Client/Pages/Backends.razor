    private async Task SelectSharedModelAsync()
    {
        var modelPath = SharedModelPath;
        switch (activeBackend)
        {
            case BackendTab.Llama:
                form.ModelPath = modelPath;
                break;
            case BackendTab.OpenVino:
                openVinoForm.ModelPath = modelPath;
                break;
            case BackendTab.DotLlm:
                dotLlmForm.ModelPath = modelPath;
                break;
            default:
                pythonForm.ModelPath = modelPath;
                break;
        }

        var profile = GetPreferredProfile(modelPath, CurrentProfileBackend);
        if (profile is not null)
            TryApplyProfile(profile);
        else
        {
            selectedProfileId = null;
            ResetActiveBackendConfiguration();
        }

        await PersistSelectedProfileAsync(modelPath, selectedProfileId);
        await SaveSettingsAsync();
        await InvokeAsync(StateHasChanged);
    }

