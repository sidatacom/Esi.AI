                        <div class="field-group"><label class="form-label" for="openvino-top-k">Top K</label><InputNumber id="openvino-top-k" class="form-control" @bind-Value="openVinoState.TopK" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-top-p">Top P</label><InputNumber id="openvino-top-p" class="form-control" @bind-Value="openVinoState.TopP" /></div>
                        <div class="field-group"><label class="form-label" for="openvino-repetition-penalty">Repetition penalty</label><InputNumber id="openvino-repetition-penalty" class="form-control" @bind-Value="openVinoState.RepetitionPenalty" /></div>
                    </div>
                    <label class="setting-toggle"><InputCheckbox @bind-Value="openVinoState.DoSample" /> Enable sampling</label>
                </details>

                @if (openVinoState.Device.StartsWith("NPU", StringComparison.OrdinalIgnoreCase))
                {
                    <details class="settings-panel" open>
                        <summary>NPU pipeline</summary>
                        <p class="panel-note">NPU pipelines use a bounded prompt and response context. These properties apply only when the active route is NPU.</p>
                        <div class="field-row">
                            <div class="field-group"><label class="form-label" for="openvino-max-prompt">Max prompt tokens</label><InputNumber id="openvino-max-prompt" class="form-control" @bind-Value="openVinoState.MaxPromptLength" /></div>
                            <div class="field-group"><label class="form-label" for="openvino-min-response">Min response tokens</label><InputNumber id="openvino-min-response" class="form-control" @bind-Value="openVinoState.MinResponseLength" /></div>
                        </div>
                        <div class="field-row">
                            <div class="field-group">
                                <label class="form-label" for="openvino-prefill-hint">Prefill hint</label>
                                <InputSelect id="openvino-prefill-hint" class="form-select" @bind-Value="openVinoState.PrefillHint">
                                    <option value="DYNAMIC">Dynamic</option>
                                    <option value="STATIC">Static</option>
                                </InputSelect>
                            </div>
                            <div class="field-group">
                                <label class="form-label" for="openvino-generate-hint">Generate hint</label>
                                <InputSelect id="openvino-generate-hint" class="form-select" @bind-Value="openVinoState.GenerateHint">
                                    <option value="FAST_COMPILE">Fast compile</option>
                                    <option value="BEST_PERF">Best performance</option>
                                </InputSelect>
                            </div>
                        </div>
                    </details>
                }
            </div>

        </section>

        <section class="telemetry-panel">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">RUNTIME TELEMETRY</p>
                    <h2>OpenVINO status</h2>
                </div>
            </div>
            <dl class="telemetry-grid">
                @if (openVinoDiagnostics is not null)
                {
                    @foreach (var check in openVinoDiagnostics.Checks)
                    {
                        <dt>@check.Name</dt>
                        <dd class="diagnostic-@(check.IsAvailable ? "ok" : "error")">@(check.IsAvailable ? "Available" : "Missing") - @check.Detail</dd>
                    }
                }
                <dt>Device</dt>
                <dd>@openVinoState.Device</dd>
                <dt>Model</dt>
                <dd>@(string.IsNullOrWhiteSpace(openVinoState.ModelPath) ? "Not selected" : Path.GetFileName(openVinoState.ModelPath.TrimEnd(Path.DirectorySeparatorChar)))</dd>
                <dt>Runtime</dt>
                <dd>@(openVinoStatus ?? "Ready for model loading")</dd>
            </dl>
        </section>
    </div>
}

@if (activeBackend == BackendTab.Llama && isLoading)
{
    <p class="mt-3" role="status">Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="mt-3" role="status">@statusMessage</p>
}

</div>

@code {
    private readonly BackendPageState pageState = new();
    private BackendTab activeBackend = BackendTab.Llama;
    private PythonState pythonForm => pageState.Python;
    private bool isPythonLoading;
    private string? pythonStatus;
    private readonly Dictionary<ConfigurationBackend, string> backendLoadLogs = [];
    private bool isOpenVinoLoading;
    private bool isOpenVinoModelLoaded;
    private bool isCheckingOpenVino;
    private bool isCheckingBackendRequirements;
    private bool isCheckingPrerequisites;
    private bool isPreparingPrerequisites;
    private string? prerequisiteOutput;
    private string? solvingCheckId;
    private string? openVinoStatus;
    private string? openVinoInstallOutput;
    private bool solveRequiresLogin;
    private OpenVinoDiagnosticsDto? openVinoDiagnostics;
    private BackendPrerequisiteDiagnostics? backendPrerequisites;
    private BackendRequirementState? backendRequirementState;
    private OpenVinoState openVinoState => pageState.OpenVino;
    private DotLlmState dotLlmForm => pageState.DotLlm;
    private IReadOnlyList<BackendModel> backendModels = [];
    private bool isDotLlmLoading;
    private string? dotLlmStatus;
    private string? matrixDialogBackend;
    private string? matrixDialogVendor;
    private BackendTab? matrixDialogBackendTab;
    private BackendPrerequisiteDiagnostics? matrixDialogDiagnostics;
    private bool isLoadingMatrixDialog;
    private string? matrixDialogStatus;
    private bool isMatrixActionRunning;
    private bool isMatrixExpanded;
    private bool isBackendRequirementsExpanded;
    private readonly Dictionary<(BackendTab Backend, string Vendor), bool> matrixRequirementActions = [];
    private bool profileTimeoutEnabled;
    private double profileTimeoutBaseSeconds = 120;
    private double profileTimeoutSecondsPerTool = 1;
    private double profileTimeoutSecondsPerPrefillToken = .01;
    private readonly Dictionary<BackendTab, Guid> selectedProfileIds = [];

    private bool IsOpenVinoValidationReady => openVinoDiagnostics?.IsGpuReady == true || openVinoDiagnostics?.IsNpuReady == true;
    private string GetOpenVinoValidationMessage() => openVinoDiagnostics?.Error ?? string.Join(" ", openVinoDiagnostics?.Checks
        .Where(check => !check.IsAvailable)
        .Select(check => $"{check.Name}: {check.Detail}") ?? []);
    private bool IsBackendPrerequisitesReady => backendPrerequisites?.IsReady == true;
    private bool IsBackendRequirementsReady => activeBackend == BackendTab.OpenVino ? IsOpenVinoValidationReady : IsBackendPrerequisitesReady;
    private bool AreMatrixChecksReady => backendRequirementState is not null &&
        !backendRequirementState.IsRefreshing &&
        matrixRequirementActions.Count > 0 &&
        matrixRequirementActions.Values.All(actionRequired => !actionRequired);

    private void ToggleMatrixSupportMatrix() => isMatrixExpanded = !isMatrixExpanded;
    private void ToggleBackendRequirements() => isBackendRequirementsExpanded = !isBackendRequirementsExpanded;

    private async Task RefreshBackendRequirementsAsync()
    {
        if (isCheckingBackendRequirements)
            return;

        isCheckingBackendRequirements = true;
        try
        {
            ApplyBackendRequirementState(await DataService.BackendRequirement_UpdateAsync());
            await RefreshMatrixRequirementActionsAsync();
        }
        catch (Exception exception)
        {
            statusMessage = $"Backend requirement check failed: {exception.Message}";
        }
        finally
        {
            isCheckingBackendRequirements = false;
        }
    }

    private ConfigurationBackend CurrentPrerequisiteBackend => GetConfigurationBackend(activeBackend);
    private IReadOnlyList<LoadedModelStatus> DisplayedLoadedModels
    {
        get
        {
            var models = loadStatus?.LoadedModels ?? [];
            if (optimisticLoadingModel is null)
            {
                return models;
            }

            return [optimisticLoadingModel, .. models.Where(model =>
                model.Backend != optimisticLoadingModel.Backend ||
                !string.Equals(model.ModelPath, optimisticLoadingModel.ModelPath, StringComparison.OrdinalIgnoreCase))];
        }
    }

    private IReadOnlyList<Model> Models => databaseModels
        .Where(model => string.Equals(Path.GetExtension(model.Path), ".gguf", StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private IReadOnlyList<BackendModel> CurrentBackendModels => backendModels
        .Where(model => model.Backend == CurrentProfileBackend)
        .ToArray();

    private BackendReferenceModel? CurrentReferenceModel => BackendReferenceModels.All
        .FirstOrDefault(model => model.Backend == CurrentProfileBackend);

    private bool IsCurrentModelLoadDisabled => optimisticLoadingModel is not null || string.IsNullOrWhiteSpace(CurrentModelPath) || activeBackend switch
    {
        BackendTab.Llama => isLoading || !IsBackendPrerequisitesReady || !string.Equals(Path.GetExtension(CurrentModelPath), ".gguf", StringComparison.OrdinalIgnoreCase),
        BackendTab.OpenVino => isOpenVinoLoading || !IsOpenVinoValidationReady || string.IsNullOrWhiteSpace(openVinoState.Device),
        BackendTab.Vllm or BackendTab.Sglang => isPythonLoading || !IsBackendPrerequisitesReady,
        BackendTab.DotLlm => isDotLlmLoading,
        _ => true
    };

    private string GetLoadButtonLabel() => activeBackend switch
    {
        BackendTab.Llama => isLoading ? "Loading model..." : "Load model",
        BackendTab.OpenVino => isOpenVinoLoading ? "Loading model..." : "Load model",
        BackendTab.Vllm or BackendTab.Sglang => isPythonLoading ? "Starting server..." : "Start Python backend",
        BackendTab.DotLlm => isDotLlmLoading ? "Loading in process..." : "Load dotLLM",
        _ => "Load model"
    };

    private static string GetBackendLabel(BackendTab backend) => backend switch
    {
        BackendTab.Llama => "LLama",
        BackendTab.OpenVino => "OpenVINO",
        BackendTab.Vllm => "vLLM",
        BackendTab.Sglang => "SGLang",
        BackendTab.DotLlm => "dotLLM",
        _ => "Python"
    };

    private async Task OpenMatrixRequirementsDialogAsync(string backend, string vendor)
    {
        matrixDialogBackend = backend;
        matrixDialogVendor = vendor;
        matrixDialogBackendTab = ParseMatrixBackend(backend);
        matrixDialogDiagnostics = null;
        matrixDialogStatus = null;
        isLoadingMatrixDialog = true;
        try
        {
            await RefreshMatrixDialogDiagnosticsAsync();
        }
        catch (Exception exception)
        {
            matrixDialogStatus = exception.Message;
        }
        finally
        {
            isLoadingMatrixDialog = false;
        }
    }

    private void CloseMatrixRequirementsDialog()
    {
        if (!isMatrixActionRunning)
        {
            matrixDialogBackend = null;
            matrixDialogVendor = null;
            matrixDialogBackendTab = null;
            matrixDialogDiagnostics = null;
        }
    }

    private async Task RefreshMatrixDialogDiagnosticsAsync()
    {
        if (matrixDialogBackendTab is not { } backend || matrixDialogVendor is null)
            return;

        var route = GetMatrixDeviceRoute(matrixDialogVendor);
        matrixDialogDiagnostics = await DataService.GetBackendPrerequisitesAsync(
            GetConfigurationBackend(backend), pythonForm.PythonExecutable,
            devices: (IsPythonBackendTab(backend) || backend == BackendTab.Llama) && route is not null
                ? [backend == BackendTab.Llama && matrixDialogVendor == "Intel / XPU" ? "sycl:0" : route]
                : null);
        matrixRequirementActions[(backend, matrixDialogVendor)] = !matrixDialogDiagnostics.IsReady;
    }

    private bool ShouldShowMatrixRequirementsButton(string backend, string vendor, string status)
    {
        var backendTab = ParseMatrixBackend(backend);
        return backendTab.HasValue && IsMatrixRouteForVendor(backend, vendor) && IsMatrixSupportAvailable(status) &&
            matrixRequirementActions.TryGetValue((backendTab.Value, vendor), out var actionRequired) && actionRequired;
    }

    private static bool IsMatrixRouteForVendor(string backend, string vendor) => (backend, vendor) switch
    {
        ("LLama / CUDA 12", "NVIDIA / CUDA") => true,
        ("LLama / SYCL 16", "Intel / XPU") => true,
        ("LLama / Vulkan", "AMD / ROCm") => true,
        _ => false
    };

    private static bool IsMatrixSupportAvailable(string status) =>
        !status.StartsWith("Not ", StringComparison.OrdinalIgnoreCase) &&
        !status.Equals("ROCm where installed", StringComparison.OrdinalIgnoreCase);

    private async Task RefreshMatrixRequirementActionsAsync()
    {
        matrixRequirementActions.Clear();
        matrixRequirementActions[(BackendTab.DotLlm, "NVIDIA / CUDA")] = false;
        matrixRequirementActions[(BackendTab.DotLlm, "Intel / XPU")] = false;
        matrixRequirementActions[(BackendTab.DotLlm, "AMD / ROCm")] = false;

        foreach (var entry in backendRequirementState?.Entries ?? [])
        {
            var backend = entry.Backend switch
            {
                ConfigurationBackend.Llama => BackendTab.Llama,
                ConfigurationBackend.Vllm => BackendTab.Vllm,
                ConfigurationBackend.Sglang => BackendTab.Sglang,
                ConfigurationBackend.OpenVino => BackendTab.OpenVino,
                _ => (BackendTab?)null
            };
            if (backend.HasValue)
                matrixRequirementActions[(backend.Value, entry.Vendor)] = !entry.Diagnostics.IsReady;
        }

        await Task.CompletedTask;
    }

    private void ApplyBackendRequirementState(BackendRequirementState state)
    {
        backendRequirementState = state;
        _ = RefreshMatrixRequirementActionsAsync();

        var currentDevices = activeBackend == BackendTab.Llama
            ? GetLlamaPrerequisiteDevices(llamaState.Backend)
            : pythonForm.SelectedDevices;
        var currentEntry = state.Entries.FirstOrDefault(entry =>
            entry.Backend == CurrentPrerequisiteBackend &&
            entry.Devices.SequenceEqual(currentDevices, StringComparer.OrdinalIgnoreCase));
        if (currentEntry is not null)
            backendPrerequisites = currentEntry.Diagnostics;
    }

    private async Task HandleBackendRequirementUpdateAsync(BackendRequirementState state)
    {
        await InvokeAsync(() =>
        {
            ApplyBackendRequirementState(state);
            StateHasChanged();
        });
    }

    private async Task HandleLoadedModelChangedAsync(ModelLoadStatus status)
    {
        await InvokeAsync(() =>
        {
            ClientState.LoadedModel_Update(status);
            if (activeBackend == BackendTab.Llama &&
                !string.Equals(status.Backend, llamaState.Backend, StringComparison.OrdinalIgnoreCase))
            {
                StateHasChanged();
                return;
            }

            loadedModelStatusVersion++;
            loadStatus = status;
            if (optimisticLoadingModel is not null && status.LoadedModels.Any(model =>
                !model.IsLoading &&
                model.Backend == optimisticLoadingModel.Backend &&
                string.Equals(model.ModelPath, optimisticLoadingModel.ModelPath, StringComparison.OrdinalIgnoreCase)))
            {
                optimisticLoadingModel = null;
            }
            if (status.Backend is "vLLM" or "SGLang" && !string.IsNullOrWhiteSpace(status.LoadLog))
                backendLoadLogs[status.Backend == "SGLang" ? ConfigurationBackend.Sglang : ConfigurationBackend.Vllm] = status.LoadLog;
            StateHasChanged();
        });
    }

    private static BackendTab? ParseMatrixBackend(string backend) => backend switch
    {
        _ when backend.StartsWith("LLama /", StringComparison.OrdinalIgnoreCase) => BackendTab.Llama,
        "OpenVINO" => BackendTab.OpenVino,
        "vLLM" => BackendTab.Vllm,
        "SGLang" => BackendTab.Sglang,
        "dotLLM" => BackendTab.DotLlm,
        _ => null
    };

    private IReadOnlyList<BackendRequirementTile> GetMatrixRequirementTiles(string vendor) =>
        Enum.GetValues<BackendTab>()
            .Select(backend =>
            {
                var row = GetMatrixRow(backend, vendor);
                var supportStatus = GetMatrixSupportStatus(row, vendor);
                var isSupported = !supportStatus.StartsWith("Not ", StringComparison.OrdinalIgnoreCase);
                var canSolve = isSupported && (backend == BackendTab.Llama && CanSolveMatrixBackend(vendor) || IsPythonBackendTab(backend) && GetMatrixDeviceRoute(vendor) is not null || backend == BackendTab.OpenVino && vendor == "Intel / XPU");
                var canOpen = isSupported && (canSolve || backend == BackendTab.Llama || backend == BackendTab.DotLlm);
                var detail = canSolve
                    ? $"Use the {vendor} driver route and solve the isolated {GetBackendLabel(backend)} environment."
                    : isSupported
                        ? $"Open the {GetBackendLabel(backend)} tab with the {vendor} context."
                        : "This backend is not available for the selected vendor in the current environment.";
                return new BackendRequirementTile(backend, GetBackendLabel(backend), supportStatus, detail, canSolve, canOpen, isSupported);
            })
            .ToArray();

    private static BackendGpuSupportRow GetMatrixRow(BackendTab backend, string vendor)
    {
        var rowName = backend == BackendTab.Llama
            ? vendor switch
            {
                "NVIDIA / CUDA" => "LLama / CUDA 12",
                "Intel / XPU" => "LLama / SYCL 16",
                _ => "LLama / Vulkan"
            }
            : GetBackendLabel(backend);
        return BackendGpuSupportMatrix.Single(row => row.Backend.Equals(rowName, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SolveMatrixBackendAsync(BackendTab backend)
    {
        if (matrixDialogVendor is null)
            return;

        isMatrixActionRunning = true;
        matrixDialogStatus = $"Opening {GetBackendLabel(backend)} for {matrixDialogVendor}...";
        try
        {
            var route = GetMatrixDeviceRoute(matrixDialogVendor);
            if (backend == BackendTab.Llama)
                llamaState.Backend = GetLlamaBackendForVendor(matrixDialogVendor);
            if (IsPythonBackendTab(backend) && route is not null)
            {
                pythonForm.Devices.Clear();
                pythonForm.Devices.Add(route);
                pythonForm.Device = route;
                pythonForm.AdditionalDeviceRoutes = string.Empty;
            }

            await SelectBackendAsync(backend);
            if (IsPythonBackendTab(backend))
            {
                await RefreshBackendPrerequisitesAsync();
                if (!IsBackendPrerequisitesReady)
                    await PrepareBackendPrerequisitesAsync();
                await RefreshMatrixDialogDiagnosticsAsync();
                matrixDialogStatus = $"{GetBackendLabel(backend)} requirements checked for {matrixDialogVendor}.";
            }
            else if (backend == BackendTab.Llama)
            {
                await RefreshBackendPrerequisitesAsync();
                if (!IsBackendPrerequisitesReady)
                    await PrepareBackendPrerequisitesAsync();
                await RefreshMatrixDialogDiagnosticsAsync();
                matrixDialogStatus = $"LLama requirements checked for {matrixDialogVendor}.";
            }
            else if (backend == BackendTab.OpenVino && matrixDialogVendor == "Intel / XPU")
            {
                var check = openVinoDiagnostics?.Checks.FirstOrDefault(check => !check.IsAvailable && check.CanSolve);
                if (check is not null)
                    await SolveOpenVinoCheckAsync(check.Id);
                else
                    matrixDialogStatus = "OpenVINO requirements are already ready for Intel / XPU.";
                await RefreshMatrixDialogDiagnosticsAsync();
            }
            else
            {
                matrixDialogStatus = $"{GetBackendLabel(backend)} opened for {matrixDialogVendor}.";
            }
        }
        catch (Exception exception)
        {
            matrixDialogStatus = exception.Message;
        }
        finally
        {
            isMatrixActionRunning = false;
        }
    }

    private static string GetMatrixSupportStatus(BackendGpuSupportRow row, string vendor) => vendor switch
    {
        "NVIDIA / CUDA" => row.Nvidia,
        "Intel / XPU" => row.Intel,
        "AMD / ROCm" => row.Amd,
        _ => "Not supported"
    };

    private static string? GetMatrixDeviceRoute(string vendor) => vendor switch
    {
        "NVIDIA / CUDA" => "cuda:0",
        "Intel / XPU" => "xpu:1",
        _ => null
    };

    private static string GetLlamaBackendForVendor(string vendor) => vendor switch
    {
        "NVIDIA / CUDA" => "CUDA",
        "Intel / XPU" => "SYCL",
        _ => "Vulkan"
    };

    private bool CanSolveMatrixBackend(string vendor) =>
        (vendor is "NVIDIA / CUDA" or "Intel / XPU" or "AMD / ROCm") &&
        backendRequirementState?.Entries
            .Where(entry => entry.Backend == ConfigurationBackend.Llama && entry.Vendor.Equals(vendor, StringComparison.OrdinalIgnoreCase))
            .SelectMany(entry => entry.Diagnostics.Checks)
            .Any(check => !check.IsAvailable && check.CanSolve) == true;

    private async Task<bool> LoadOpenVinoModelAsync()
    {
        if (openVinoDiagnostics?.IsGpuReady != true && openVinoDiagnostics?.IsNpuReady != true)
        {
            openVinoStatus = "No supported OpenVINO accelerator is available.";
            statusMessage = openVinoStatus;
            return false;
        }

        isOpenVinoLoading = true;
        openVinoStatus = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var loadTask = DataService.LoadModelAsync(
                new OpenVinoLoadRequest(
                    openVinoState.ModelPath,
                    openVinoState.Device,
                    openVinoState.CacheDirectory,
                    openVinoState.MaxNewTokens,
                    openVinoState.Temperature,
                    openVinoState.TopP,
                    openVinoState.DoSample,
                    new OpenVinoNpuSettings(
                        openVinoState.MaxPromptLength,
                        openVinoState.MinResponseLength,
                        openVinoState.PrefillHint,
                        openVinoState.GenerateHint),
                    openVinoState.TopK,
                    openVinoState.RepetitionPenalty));
            var result = await loadTask;
            isOpenVinoModelLoaded = result.Succeeded;
            openVinoStatus = result.Message;
            statusMessage = result.Succeeded ? null : result.Message;
            return result.Succeeded;
        }
        catch (Exception exception)
        {
            openVinoStatus = $"OpenVINO model load failed: {exception.Message}";
            statusMessage = openVinoStatus;
            return false;
        }
        finally
        {
            isOpenVinoLoading = false;
        }
    }

    private async Task CancelOpenVinoModelLoadAsync()
    {
        await DataService.CancelOpenVinoLoadAsync();
        openVinoStatus = "Cancelling model load...";
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadActiveBackendModelAsync()
    {
        var pendingModel = CreatePendingModelStatus();
        if (pendingModel is null)
            return;

        optimisticLoadingModel = pendingModel;
        await InvokeAsync(StateHasChanged);
        await LoadActiveBackendModelCoreAsync();
    }

    private async Task LoadActiveBackendModelCoreAsync()
    {
        var loadSucceeded = false;
        try
        {
            loadSucceeded = await (activeBackend switch
            {
                BackendTab.Llama => LoadModelAsync(),
                BackendTab.OpenVino => LoadOpenVinoModelAsync(),
                BackendTab.Vllm or BackendTab.Sglang => LoadPythonModelAsync(),
                BackendTab.DotLlm => LoadDotLlmModelAsync(),
                _ => Task.FromResult(false)
            });
        }
        finally
        {
            try
            {
                loadStatus = await DataService.LoadedModel_ReadAsync();
                ClientState.LoadedModel_Read(loadStatus);
            }
            catch (Exception exception)
            {
                statusMessage = exception.Message;
            }

            if (loadSucceeded)
            {
                optimisticLoadingModel = null;
            }
            else if (optimisticLoadingModel is not null)
            {
                var failedModel = optimisticLoadingModel with
                {
                    IsLoading = false,
                    LoadLog = statusMessage ?? "The model could not be loaded."
                };
                optimisticLoadingModel = failedModel;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ClearModelLoadItems()
    {
        var model = optimisticLoadingModel ?? DisplayedLoadedModels.FirstOrDefault(IsFailedModelLoad);
        if (model is not null)
        {
            try
            {
                loadStatus = await DataService.UnloadModelAsync(model.ModelPath, model.Backend);
            }
            catch (Exception exception)
            {
                statusMessage = exception.Message;
                return;
            }
        }

        optimisticLoadingModel = null;
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsFailedModelLoad(LoadedModelStatus model) =>
        !model.IsLoading &&
        !model.IsModelLoaded &&
        !string.IsNullOrWhiteSpace(model.LoadLog);

    private LoadedModelStatus? CreatePendingModelStatus()
    {
        if (string.IsNullOrWhiteSpace(CurrentModelPath))
            return null;

        var runtime = activeBackend switch
        {
            BackendTab.Llama => llamaState.Backend,
            BackendTab.OpenVino => openVinoState.Device,
            BackendTab.Vllm => "vLLM",
            BackendTab.Sglang => "SGLang",
            BackendTab.DotLlm => "dotLLM / In-Process",
            _ => GetBackendLabel(activeBackend)
        };

        return new LoadedModelStatus(
            CurrentModelPath,
            GetConfigurationBackend(activeBackend),
            runtime,
            0,
            0,
            0,
            [],
            null,
            IsLoading: true,
            IsModelLoaded: false);
    }

    private async Task<bool> LoadPythonModelAsync()
    {
        var backend = GetConfigurationBackend(activeBackend);
        var backendName = GetBackendLabel(activeBackend);
        isPythonLoading = true;
        pythonStatus = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await DataService.LoadPythonModelAsync(pythonForm.ToRequest(backend));
            if (!string.IsNullOrWhiteSpace(result.LoadLog))
                backendLoadLogs[backend] = result.LoadLog;
            pythonStatus = result.IsModelLoaded
                ? $"{backendName} is ready."
                : $"{backendName} could not be loaded.";
            statusMessage = result.IsModelLoaded ? null : pythonStatus;
            return result.IsModelLoaded;
        }
        catch (Exception exception)
        {
            pythonStatus = exception.Message;
            statusMessage = pythonStatus;
            backendLoadLogs[backend] = exception.ToString();
            return false;
        }
        finally
        {
            isPythonLoading = false;
        }
    }

    private async Task<bool> LoadDotLlmModelAsync()
    {
        isDotLlmLoading = true;
        dotLlmStatus = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            await DataService.LoadDotLlmModelAsync(new DotLlmLoadRequest(
                dotLlmForm.ModelPath, dotLlmForm.Device, dotLlmForm.Threads));
            dotLlmStatus = "dotLLM is ready.";
            return true;
        }
        catch (Exception exception)
        {
            dotLlmStatus = exception.Message;
            statusMessage = dotLlmStatus;
            return false;
        }
        finally
        {
            isDotLlmLoading = false;
        }
    }

    private async Task StopDotLlmModelAsync()
    {
        await DataService.UnloadModelAsync(loadStatus?.ModelPath ?? dotLlmForm.ModelPath, ConfigurationBackend.DotLlm);
        dotLlmStatus = "dotLLM stopped.";
    }

    private async Task RefreshOpenVinoDiagnosticsAsync()
    {
        isCheckingOpenVino = true;
        try
        {
