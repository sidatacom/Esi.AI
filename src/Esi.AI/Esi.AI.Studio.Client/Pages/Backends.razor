        }
    }

    private static string FormatBytes(ulong bytes) => $"{bytes / 1024d / 1024d / 1024d:F2} GiB";

    private static string FormatMemory(double? memoryMiB) => memoryMiB is null ? "- VRAM" : $"{memoryMiB.Value:F2} MiB VRAM";

    private static string FormatGpuMemory(double memoryMiB) => memoryMiB >= 1024
        ? $"{memoryMiB / 1024d:F1} GB"
        : $"{memoryMiB:F0} MB";

    private static string FormatLoadedModelDevice(LoadedModelStatus model, DeviceStatus device) =>
        model.Backend == ConfigurationBackend.Llama
            ? $"{FormatMemory(device.ModelBufferMiB)}, {device.AssignedLayerCount} layers"
            : FormatMemory(device.ModelBufferMiB);

    private static string FormatLoadedModelMemory(LoadedModelStatus model)
    {
        if (model.Backend != ConfigurationBackend.OpenVino)
            return FormatBytes(model.ModelSizeInBytes);

        var vramUsageMiB = model.Devices.FirstOrDefault()?.ModelBufferMiB;
        return vramUsageMiB is double usage ? $"{usage / 1024d:F2} GiB VRAM" : "VRAM unavailable";
    }

    private static string FormatLoadedModelSummary(LoadedModelStatus model) =>
        string.Join(" | ", GetLoadedModelSummaryParts(model));

    private static IEnumerable<string> GetLoadedModelSummaryParts(LoadedModelStatus model)
    {
        yield return GetBackendLabel(model.Backend);

        if (model.Backend != ConfigurationBackend.OpenVino && !string.IsNullOrWhiteSpace(model.Runtime))
            yield return model.Runtime;
        if (model.ContextSize > 0)
            yield return $"{model.ContextSize} tokens";
        if (model.Backend == ConfigurationBackend.OpenVino)
            yield return FormatLoadedModelMemory(model);
        else if (model.ModelSizeInBytes > 0)
            yield return FormatBytes(model.ModelSizeInBytes);
        if (model.Backend == ConfigurationBackend.Llama && model.GpuLayerCount > 0)
            yield return $"{model.GpuLayerCount} GPU layers";
    }

    private async Task SaveSettingsAsync()
    {
        if (isInitializing || isApplyingProfile)
            return;

        if (activeBackend == BackendTab.OpenVino)
        {
            await DataService.ModelSettings_UpdateAsync(openVinoState.ToSettings(selectedProfileId));
            await PersistCurrentProfileSettingsAsync();
            await PersistSelectedProfileAsync(openVinoState.ModelPath, selectedProfileId);
            return;
        }

        if (activeBackend is BackendTab.Vllm or BackendTab.Sglang or BackendTab.DotLlm)
        {
            await PersistCurrentProfileSettingsAsync();
            await PersistSelectedProfileAsync(CurrentModelPath, selectedProfileId);
            return;
        }

        await DataService.ModelSettings_UpdateAsync(new ModelSettings(
            llamaState.ModelPath,
            ConfigurationBackend.Llama,
            JsonSerializer.Serialize(new LoadModelRequest(
                llamaState.ModelPath,
                llamaState.Backend,
                llamaState.GpuLayerCount,
                llamaState.ContextSize,
                llamaState.BackendDevices.ToDictionary(pair => pair.Key, pair => pair.Value.Weight),
                llamaAdvancedState.ToSettings(),
                llamaState.MmprojPath)),
            selectedProfileId));
        await PersistCurrentProfileSettingsAsync();
    }

    private async Task SelectProfileAsync(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var profileId))
        {
            selectedProfileId = null;
            if (!string.IsNullOrWhiteSpace(CurrentModelPath))
                await PersistSelectedProfileAsync(CurrentModelPath, null);
            return;
        }

        var profile = await DataService.ModelConfiguration_ReadAsync(profileId);
        if (profile is null)
            return;

        if (!TryApplyProfile(profile))
            return;

        selectedProfileIds[activeBackend] = profile.Id;
        statusMessage = $"Selected: {profile.Name}";
        await PersistSelectedProfileAsync(profile.ModelPath, profile.Id);
        await SaveSettingsAsync();
    }

    private Task OpenAssignProfileAsync()
    {
        assignSourceProfileId = selectedProfileId ?? BackendProfiles.FirstOrDefault()?.Id;
        profileTargetModelPath = CurrentModelPath;
        isAssigningProfile = true;
        return InvokeAsync(StateHasChanged);
    }

    private void SelectAssignSourceProfileAsync(ChangeEventArgs args) =>
        assignSourceProfileId = Guid.TryParse(args.Value?.ToString(), out var profileId) ? profileId : null;

    private void SelectProfileTargetModelAsync(ChangeEventArgs args) =>
        profileTargetModelPath = args.Value?.ToString() ?? string.Empty;

    private void CancelAssignProfile()
    {
        isAssigningProfile = false;
        assignSourceProfileId = null;
    }

    private async Task AssignProfileToModelAsync()
    {
        if (!assignSourceProfileId.HasValue || string.IsNullOrWhiteSpace(profileTargetModelPath))
            return;

        var profile = profiles.FirstOrDefault(item => item.Id == assignSourceProfileId.Value);
        if (profile is null)
            return;

        if (string.Equals(profile.ModelPath, profileTargetModelPath, StringComparison.OrdinalIgnoreCase))
        {
            statusMessage = "The configuration is already assigned to this model.";
            return;
        }

        var targetName = databaseModels.FirstOrDefault(model =>
            string.Equals(model.Path, profileTargetModelPath, StringComparison.OrdinalIgnoreCase))?.Name
            ?? Path.GetFileName(profileTargetModelPath);
        var copyName = GetAvailableProfileName($"{profile.Name} - {targetName}");
        var configurationJson = profile.Backend == ConfigurationBackend.OpenVino
            ? SerializeSettingsForModel(profile.ConfigurationJson, profileTargetModelPath)
            : SerializeSettingsForModel(profile.ConfigurationJson, profileTargetModelPath);
        var saved = await DataService.ModelConfiguration_CreateAsync(new ModelConfiguration(
            Guid.Empty,
            copyName,
            profile.Description,
            profileTargetModelPath,
            false,
            profile.SchemaVersion,
            configurationJson,
            default,
            default,
            profile.Backend,
            profile.InferenceTimeout,
            profile.AutoLaunch));
        profiles = profiles.Append(saved).ToArray();
        profileTargetModelPath = saved.ModelPath;
        assignSourceProfileId = saved.Id;
        await PersistSelectedProfileAsync(saved.ModelPath, saved.Id);
        isAssigningProfile = false;
        statusMessage = $"Configuration copied to {Path.GetFileName(saved.ModelPath)}.";
    }

    private string GetAvailableProfileName(string baseName)
    {
        var name = baseName;
        var suffix = 2;
        while (profiles.Any(profile => profile.Backend == CurrentProfileBackend &&
            string.Equals(profile.Name, name, StringComparison.OrdinalIgnoreCase)))
            name = $"{baseName} ({suffix++})";
        return name;
    }

    private async Task SelectModelAsync(ChangeEventArgs args)
    {
        var modelPath = args.Value?.ToString();
        llamaState.ModelPath = modelPath ?? string.Empty;
        var configurationInvalid = false;
        var profile = GetPreferredProfile(llamaState.ModelPath, ConfigurationBackend.Llama);

        if (profile is null)
        {
            selectedProfileId = null;
            ResetModelConfiguration();
        }
        else
        {
            if (!TryApplyProfile(profile))
            {
                selectedProfileId = null;
                ResetModelConfiguration();
                configurationInvalid = true;
            }
            else
            {
                llamaState.ModelPath = modelPath ?? string.Empty;
            }
        }

        await SaveSettingsAsync();
        await PersistSelectedProfileAsync(llamaState.ModelPath, selectedProfileId);
        if (configurationInvalid)
        {
            statusMessage = "The model configuration is invalid.";
            return;
        }

        statusMessage = string.IsNullOrWhiteSpace(modelPath)
            ? "No model selected."
            : $"Model selected: {databaseModels.FirstOrDefault(model => model.Path == modelPath)?.Name ?? modelPath}; configuration applied.";
    }

    private async Task CreateProfileAsync()
    {
        newProfileName = string.Empty;
        isCreatingProfile = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveNewProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(newProfileName))
        {
            statusMessage = "Enter a name for the configuration set.";
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentModelPath))
        {
            statusMessage = "Select a model before creating a configuration set.";
            isCreatingProfile = false;
            return;
        }

        try
        {
            var saved = await DataService.ModelConfiguration_CreateAsync(new ModelConfiguration(
                Guid.Empty, newProfileName.Trim(), null, CurrentModelPath.Trim(), false, 1, SerializeCurrentSettings(), default, default, CurrentProfileBackend,
                CreateProfileTimeoutSettings(), true));
            profiles = profiles.Append(saved).OrderByDescending(profile => profile.IsDefault).ThenBy(profile => profile.Name).ToArray();
            selectedProfileId = saved.Id;
            selectedProfileName = saved.Name;
            selectedProfileAutoLaunch = saved.AutoLaunch;
            isCreatingProfile = false;
            await PersistSelectedProfileAsync(saved.ModelPath, saved.Id);
            statusMessage = $"Created: {saved.Name}";
        }
        catch (Exception exception)
        {
            statusMessage = $"Could not create configuration set: {exception.Message}";
        }
    }

    private async Task UpdateProfileAsync()
    {
        if (!selectedProfileId.HasValue)
            return;

        var profile = profiles.FirstOrDefault(item => item.Id == selectedProfileId.Value);
        if (profile is null)
            return;
        if (string.IsNullOrWhiteSpace(selectedProfileName))
        {
            statusMessage = "Configuration name is required.";
            return;
        }

        try
        {
            var saved = await DataService.ModelConfiguration_UpdateAsync(profile with
            {
                Name = selectedProfileName.Trim(),
                ModelPath = CurrentModelPath.Trim(),
                ConfigurationJson = SerializeCurrentSettings(),
                Backend = CurrentProfileBackend,
                InferenceTimeout = CreateProfileTimeoutSettings(),
                AutoLaunch = selectedProfileAutoLaunch
            });
            profiles = profiles.Select(item => item.Id == saved.Id ? saved : item).ToArray();
            await PersistSelectedProfileAsync(saved.ModelPath, saved.Id);
            statusMessage = $"Updated: {saved.Name}";
        }
        catch (Exception exception)
        {
            statusMessage = $"Could not update configuration set: {exception.Message}";
        }
    }

    private async Task DeleteSelectedProfileAsync()
    {
        if (!selectedProfileId.HasValue)
            return;

        var profile = profiles.FirstOrDefault(item => item.Id == selectedProfileId.Value);
        if (profile is null)
            return;

        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Delete configuration set '{profile.Name}'?");
        if (!confirmed)
            return;

        try
        {
            await DataService.ModelConfiguration_DeleteAsync(profile.Id);
            profiles = profiles.Where(item => item.Id != profile.Id).ToArray();
            selectedProfileIds.Remove(activeBackend);
            selectedProfileId = null;
            selectedProfileName = string.Empty;
            selectedProfileAutoLaunch = true;
            assignSourceProfileId = assignSourceProfileId == profile.Id ? null : assignSourceProfileId;
            await PersistSelectedProfileAsync(CurrentModelPath, null);
            statusMessage = $"Deleted: {profile.Name}";
        }
        catch (Exception exception)
        {
            statusMessage = $"Could not delete configuration set: {exception.Message}";
        }
    }

    private void CancelCreateProfile() => isCreatingProfile = false;

