@page "/backends"
@rendermode InteractiveAuto
@implements IAsyncDisposable

@using System.Text.Json
@using Esi.AI.Models
@using Esi.AI.Studio.Client.State
@inject IDataService DataService
@inject IModelRuntimeEvents RuntimeEvents
@inject IBackendRequirementEvents RequirementEvents
@inject IClientStateStore ClientState
@inject IJSRuntime JsRuntime

<section class="loaded-models global-loaded-models" aria-labelledby="loaded-models-heading">
    <div class="loaded-models-heading">
        <div>
            <p class="eyebrow">ACTIVE RUNTIMES</p>
            <h2 id="loaded-models-heading">Loaded models</h2>
        </div>
        <div class="loaded-models-status">
            <span class="device-count">@GetLoadedModelsCountLabel()</span>
            @if (optimisticLoadingModel is not null && !optimisticLoadingModel.IsLoading)
            {
                <button class="profile-button" type="button" @onclick="ClearModelLoadItems">Clear</button>
            }
        </div>
    </div>
    @if (isInitializing)
    {
        <p class="loaded-models-empty">Checking active runtimes...</p>
    }
    else if (DisplayedLoadedModels.Count > 0)
    {
        @foreach (var model in DisplayedLoadedModels)
        {
            <article class="loaded-model @(model.IsLoading ? "loaded-model-loading" : "")">
                <div class="loaded-model-topline">
                    <div class="loaded-model-state @(model.IsLoading ? "loaded-model-state-loading" : "loaded-model-state-ready")" role="status" aria-label="@(model.IsLoading ? "Loading model" : "Model loaded")">
                        <span class="loaded-model-state-dot"></span>
                    </div>
                    <div class="loaded-model-copy">
                        <strong>@Path.GetFileName(model.ModelPath)</strong>
                        <span>@(model.IsLoading ? $"Loading on {model.Runtime}..." : FormatLoadedModelSummary(model))</span>
                    </div>
                    @if (model.IsLoading)
                    {
                        @if (model.Backend == ConfigurationBackend.OpenVino)
                        {
                            <button class="profile-button cancel-button" type="button" @onclick="CancelOpenVinoModelLoadAsync">Cancel loading</button>
                        }
                        else
                        {
                            <span class="loading-model-status" role="status">Loading...</span>
                        }
                    }
                    else
                    {
                        @if (IsFailedModelLoad(model))
                        {
                            <button class="profile-button" type="button" @onclick="ClearModelLoadItems">Clear</button>
                        }
                        else
                        {
                            <button class="profile-button" type="button" @onclick="() => UnloadModelAsync(model)">Unload</button>
                        }
                    }
                </div>
                <div class="loaded-model-devices">
                    @foreach (var device in model.Devices.Where(device => !IsExcludedDevice(device.Description ?? device.Name) && (device.AssignedLayerCount > 0 || device.ModelBufferMiB is not null)))
                    {
                        <span><b>@device.Name</b> @FormatLoadedModelDevice(model, device)</span>
                    }
                </div>
                @if (model.Backend == ConfigurationBackend.OpenVino && model.Devices.FirstOrDefault(device => device.ModelBufferMiB is not null && device.MemoryCapacityMiB is > 0) is { } openVinoDevice)
                {
                    var usedMiB = Math.Max(0, openVinoDevice.ModelBufferMiB!.Value);
                    var totalMiB = openVinoDevice.MemoryCapacityMiB!.Value;
                    var usagePercent = Math.Clamp(usedMiB / totalMiB * 100, 0, 100);
                    <div class="gpu-memory-meter">
                        <div class="gpu-memory-meter-heading">
                            <span>GPU memory</span>
                            <strong>@FormatGpuMemory(usedMiB) / @FormatGpuMemory(totalMiB) (@usagePercent.ToString("F0")%)</strong>
                        </div>
                        <div class="gpu-memory-meter-track" role="progressbar" aria-label="Global GPU memory usage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@usagePercent.ToString("F0")">
                            <div class="gpu-memory-meter-fill" style="width: @usagePercent.ToString("F0")%"></div>
                        </div>
                        <small>Global GPU usage reported by the Intel xe driver</small>
                    </div>
                }
                <details class="runtime-log-details">
                    <summary>Load output</summary>
                    <textarea class="form-control log-output" rows="8" readonly>@(string.IsNullOrWhiteSpace(model.LoadLog) ? "No runtime output was captured." : model.LoadLog)</textarea>
                </details>
            </article>
        }
    }
    else
    {
        <p class="loaded-models-empty">No models loaded.</p>
    }
</section>

<details class="backend-support-matrix" open="@isMatrixExpanded">
    <summary class="section-heading backend-support-summary" aria-expanded="@isMatrixExpanded" @onclick="ToggleMatrixSupportMatrix" @onclick:preventDefault="true">
        <div>
            <p class="eyebrow">GPU COMPATIBILITY MATRIX</p>
        </div>
    </summary>
    <div class="table-scroll">
        <table class="support-matrix-table">
            <thead>
                <tr>
                    <th scope="col">Backend</th>
                    <th scope="col">NVIDIA / CUDA</th>
                    <th scope="col">Intel / XPU</th>
                    <th scope="col">AMD / ROCm</th>
                    <th scope="col">Multi-GPU</th>
                    <th scope="col">Multi-vendor</th>
                    <th scope="col">Driver strategy</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in BackendGpuSupportMatrix)
                {
                    <tr>
                        <th scope="row">@row.Backend</th>
                        <td>
                            @if (ShouldShowMatrixRequirementsButton(row.Backend, "NVIDIA / CUDA", row.Nvidia))
                            {
                                <button class="matrix-support-button" type="button" @onclick='() => OpenMatrixRequirementsDialogAsync(row.Backend, "NVIDIA / CUDA")' aria-label="Show requirements for @row.Backend on NVIDIA / CUDA">
                                    Requirements
                                </button>
                            }
                            else
                            {
                                @row.Nvidia
                            }
                        </td>
                        <td>
                            @if (ShouldShowMatrixRequirementsButton(row.Backend, "Intel / XPU", row.Intel))
                            {
                                <button class="matrix-support-button" type="button" @onclick='() => OpenMatrixRequirementsDialogAsync(row.Backend, "Intel / XPU")' aria-label="Show requirements for @row.Backend on Intel / XPU">
                                    Requirements
                                </button>
                            }
                            else
                            {
                                @row.Intel
                            }
                        </td>
                        <td>
                            @if (ShouldShowMatrixRequirementsButton(row.Backend, "AMD / ROCm", row.Amd))
                            {
                                <button class="matrix-support-button" type="button" @onclick='() => OpenMatrixRequirementsDialogAsync(row.Backend, "AMD / ROCm")' aria-label="Show requirements for @row.Backend on AMD / ROCm">
                                    Requirements
                                </button>
                            }
                            else
                            {
                                @row.Amd
                            }
                        </td>
                        <td>@row.MultiGpu</td>
                        <td>@row.MultiVendor</td>
                        <td>@row.DriverStrategy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</details>

@if (matrixDialogVendor is not null && matrixDialogBackend is not null)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseMatrixRequirementsDialog">
        <section class="backend-requirements-dialog" role="dialog" aria-modal="true" aria-labelledby="backend-requirements-title" @onclick:stopPropagation="true">
            <div class="dialog-heading">
                <div>
                    <p class="eyebrow">BACKEND REQUIREMENTS</p>
                    <h2 id="backend-requirements-title">@matrixDialogBackend</h2>
                    <p class="dialog-context">Requirements for @matrixDialogBackend in the @matrixDialogVendor context.</p>
                </div>
                <button class="dialog-close-button" type="button" @onclick="CloseMatrixRequirementsDialog" aria-label="Close backend requirements">×</button>
            </div>
            <div class="backend-requirement-tiles">
                @foreach (var tile in GetMatrixRequirementTiles(matrixDialogVendor).Where(tile => tile.Backend == matrixDialogBackendTab))
                {
                    <article class="backend-requirement-tile @(tile.IsSupported ? "" : "backend-requirement-tile-disabled") @(tile.Backend == matrixDialogBackendTab ? "backend-requirement-tile-selected" : "")">
                        <div class="backend-requirement-tile-heading">
                            <h3>@tile.Name</h3>
                            <span class="backend-requirement-status">@tile.SupportStatus</span>
                        </div>
                        <p>@tile.Detail</p>
                        <button class="profile-button" type="button" @onclick="() => SolveMatrixBackendAsync(tile.Backend)" disabled="@(isMatrixActionRunning || !tile.CanOpen)">
                            @(tile.CanSolve ? "Solve requirements" : "Open backend")
                        </button>
                    </article>
                }
            </div>
            @if (isLoadingMatrixDialog)
            {
                <p class="empty-state">Checking requirements for this backend and vendor...</p>
            }
            else if (matrixDialogDiagnostics is not null)
            {
                <ol class="validation-steps matrix-dialog-checks">
                    @for (var index = 0; index < matrixDialogDiagnostics.Checks.Count; index++)
                    {
                        var check = matrixDialogDiagnostics.Checks[index];
                        <li class="validation-step @(check.IsAvailable ? "validation-step-ok" : check.IsOptional ? "validation-step-info" : "validation-step-error")">
                            <span class="validation-step-number">@((index + 1).ToString("00"))</span>
                            <span class="validation-step-indicator" aria-hidden="true">@(check.IsAvailable ? "OK" : check.IsOptional ? "i" : "!")</span>
                            <span class="validation-step-copy">
                                <strong>@check.Name</strong>
                                <small>@check.Detail</small>
                            </span>
                        </li>
                    }
                </ol>
                <p class="validation-summary @(matrixDialogDiagnostics.IsReady ? "validation-summary-ok" : "validation-summary-error")">
                    @(matrixDialogDiagnostics.IsReady ? "Requirements are ready." : "Requirements need attention.")
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(matrixDialogStatus))
            {
                <p class="matrix-dialog-status" role="status">@matrixDialogStatus</p>
            }
        </section>
    </div>
}

<nav class="backend-tabs" aria-label="Inference backends">
    <button class="backend-tab @(activeBackend == BackendTab.Llama ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.Llama)">
        <span>LLama</span>
        <small>GGUF / LLamaSharp</small>
    </button>
    <button class="backend-tab @(activeBackend == BackendTab.OpenVino ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.OpenVino)">
        <span>OpenVINO</span>
        <small>IR or ONNX / GenAI</small>
    </button>
    <button class="backend-tab @(activeBackend == BackendTab.Vllm ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.Vllm)">
        <span>vLLM</span>
        <small>Python engine</small>
    </button>
    <button class="backend-tab @(activeBackend == BackendTab.Sglang ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.Sglang)">
        <span>SGLang</span>
        <small>Python engine</small>
    </button>
    <button class="backend-tab @(activeBackend == BackendTab.DotLlm ? "active" : "")" type="button" @onclick="() => SelectBackendAsync(BackendTab.DotLlm)">
        <span>dotLLM</span>
        <small>Native .NET / GGUF</small>
    </button>
</nav>

<div class="backend-sections">
<section class="driver-validation-panel backend-prerequisites-panel @(isBackendRequirementsExpanded ? "is-expanded" : "is-collapsed")">
    <details open="@isBackendRequirementsExpanded">
        <summary class="section-heading driver-validation-summary" aria-expanded="@isBackendRequirementsExpanded" @onclick="ToggleBackendRequirements" @onclick:preventDefault="true">
            <div>
                <p class="eyebrow">BACKEND REQUIREMENTS</p>
            </div>
            <span class="validation-summary @(IsBackendRequirementsReady ? "validation-summary-ok" : "validation-summary-error")">
                @(IsBackendRequirementsReady ? "Ready" : "Needs attention")
            </span>
        </summary>
        <div class="driver-validation-content">
            @if (activeBackend != BackendTab.OpenVino && backendRequirementState is null)
            {
                <button class="profile-button" type="button" @onclick="RefreshBackendRequirementsAsync" disabled="@isCheckingBackendRequirements">
                    @(isCheckingBackendRequirements ? "Checking..." : "Check backend requirements")
                </button>
            }
            @if (activeBackend == BackendTab.OpenVino)
            {
                <button class="profile-button" type="button" @onclick="RefreshOpenVinoDiagnosticsAsync" disabled="@isCheckingOpenVino">
                    @(isCheckingOpenVino ? "Checking..." : "Recheck")
                </button>
                @if (openVinoDiagnostics is null)
                {
                    <p class="empty-state">Checking the local Intel GPU and OpenVINO runtime...</p>
                }
                else
                {
                    <ol class="validation-steps">
                        @for (var index = 0; index < openVinoDiagnostics.Checks.Count; index++)
                        {
                            var check = openVinoDiagnostics.Checks[index];
                            <li class="validation-step @(check.IsAvailable ? "validation-step-ok" : "validation-step-error")">
                                <span class="validation-step-number">@((index + 1).ToString("00"))</span>
                                <span class="validation-step-indicator" aria-hidden="true">@(check.IsAvailable ? "OK" : "!")</span>
                                <span class="validation-step-copy">
                                    <strong>@check.Name</strong>
                                    <small>@check.Detail</small>
                                    @if (!check.IsAvailable && check.CanSolve)
                                    {
                                        <button class="validation-solve-button" type="button" @onclick="() => SolveOpenVinoCheckAsync(check.Id)" disabled="@(solvingCheckId is not null)">
                                            @(solvingCheckId == check.Id ? "Installing..." : "Solve")
                                        </button>
                                    }
                                </span>
                            </li>
                        }
                    </ol>
                    <p class="validation-summary @(IsOpenVinoValidationReady ? "validation-summary-ok" : "validation-summary-error")">
                        @(IsOpenVinoValidationReady ? "OpenVINO accelerator backend ready." : "No compatible OpenVINO accelerator is ready. Model loading is disabled.")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(openVinoDiagnostics.Error))
                    {
                        <details class="solve-output">
                            <summary>OpenVINO error details</summary>
                            <textarea class="form-control log-output" rows="10" readonly>@openVinoDiagnostics.Error</textarea>
                        </details>
                    }
                    @if (!string.IsNullOrWhiteSpace(openVinoInstallOutput))
                    {
                        <details class="solve-output" open>
                            <summary>Driver installation output</summary>
                            <textarea class="form-control log-output" rows="10" readonly>@openVinoInstallOutput</textarea>
                        </details>
                    }
                    @if (solveRequiresLogin)
                    {
                        <p class="solve-auth-message">
                            <a href="Account/Login?returnUrl=%2Fbackends">Sign in</a> to authorize driver installation, then run Solve again.
                        </p>
                    }
                }
            }
            else if (backendPrerequisites is null)
            {
                <p class="empty-state">Checking backend requirements...</p>
            }
            else
            {
                <button class="profile-button" type="button" @onclick="RefreshBackendPrerequisitesAsync" disabled="@isCheckingPrerequisites">
                    @(isCheckingPrerequisites ? "Checking..." : "Recheck")
                </button>
                <ol class="validation-steps">
                    @for (var index = 0; index < backendPrerequisites.Checks.Count; index++)
                    {
                        var check = backendPrerequisites.Checks[index];
                        <li class="validation-step @(check.IsAvailable ? "validation-step-ok" : check.IsOptional ? "validation-step-info" : "validation-step-error")">
                            <span class="validation-step-number">@((index + 1).ToString("00"))</span>
                            <span class="validation-step-indicator" aria-hidden="true">@(check.IsAvailable ? "OK" : check.IsOptional ? "i" : "!")</span>
                            <span class="validation-step-copy">
                                <strong>@check.Name</strong>
                                <small>@check.Detail</small>
                                @if (!check.IsAvailable && !check.IsOptional && check.CanSolve)
                                {
                                    <button class="validation-solve-button" type="button" @onclick="() => PrepareBackendPrerequisitesAsync(check.Id)" disabled="@isPreparingPrerequisites">
                                        @(isPreparingPrerequisites ? (CurrentPrerequisiteBackend == ConfigurationBackend.Llama ? "Installing..." : "Preparing...") : CurrentPrerequisiteBackend == ConfigurationBackend.Llama ? "Install" : "Prepare")
                                    </button>
                                }
                            </span>
                        </li>
                    }
                </ol>
                <p class="validation-summary @(IsBackendPrerequisitesReady ? "validation-summary-ok" : "validation-summary-error")">
                    @(IsBackendPrerequisitesReady ? "Backend requirements are ready." : "Model loading is disabled until the required backend checks pass.")
                </p>
                @if (!string.IsNullOrWhiteSpace(backendPrerequisites.Error))
                {
                    <details class="solve-output" open>
                        <summary>Diagnostic details</summary>
                        <textarea class="form-control log-output" rows="8" readonly>@backendPrerequisites.Error</textarea>
                    </details>
                }
                @if (!string.IsNullOrWhiteSpace(prerequisiteOutput))
                {
                    <details class="solve-output" open>
                        <summary>Preparation output</summary>
                        <textarea class="form-control log-output" rows="8" readonly>@prerequisiteOutput</textarea>
                    </details>
                }
            }
        </div>
    </details>
</section>

<section class="config-panel shared-model-config">
    <div class="section-heading">
        <div><p class="eyebrow">SHARED MODEL CATALOG</p><h2>Model and configuration</h2></div>
        <span class="step-label">00</span>
    </div>
    <div class="model-load-row">
        <div class="model-picker">
            <label class="form-label" for="shared-model-picker">Model for @GetBackendLabel(activeBackend)</label>
            <select @key="@($"{activeBackend}:{CurrentModelPath}")" id="shared-model-picker" class="form-select" value="@CurrentModelPath" @onchange="SelectSharedModelAsync">
                <option value="">Select a model...</option>
                @if (!string.IsNullOrWhiteSpace(CurrentModelPath) && !CurrentBackendModels.Any(model => string.Equals(model.Path, CurrentModelPath, StringComparison.OrdinalIgnoreCase)))
                {
                    <option value="@CurrentModelPath" selected>@Path.GetFileName(CurrentModelPath) (saved path)</option>
                }
                @foreach (var model in CurrentBackendModels)
                {
                    <option value="@model.Path" selected="@string.Equals(model.Path, CurrentModelPath, StringComparison.OrdinalIgnoreCase)">@model.Name</option>
                }
            </select>
            @if (CurrentBackendModels.Count == 0)
            {
                <span class="picker-note">No stored models are available. Reference: @CurrentReferenceModel?.ModelId (@CurrentReferenceModel?.EnvironmentVariable)</span>
            }
            else
            {
                <span class="picker-note">Reference: @CurrentReferenceModel?.ModelId (@CurrentReferenceModel?.EnvironmentVariable)</span>
            }
        </div>
        <div class="model-load-action">
            @if (isOpenVinoLoading)
            {
                <button class="load-button cancel-button" type="button" @onclick="CancelOpenVinoModelLoadAsync">Cancel loading</button>
            }
            else
            {
                <button class="load-button" type="button" @onclick="LoadActiveBackendModelAsync" disabled="@IsCurrentModelLoadDisabled">@GetLoadButtonLabel()</button>
            }
        </div>
    </div>
    @if (activeBackend == BackendTab.OpenVino && !IsOpenVinoValidationReady && openVinoDiagnostics is not null)
    {
        <p class="mt-3" role="alert">OpenVINO model loading is disabled: @GetOpenVinoValidationMessage()</p>
    }
    <div class="profile-toolbar">
        <div class="profile-select">
            <label class="form-label" for="shared-configuration-profile">Configuration set</label>
            <select id="shared-configuration-profile" class="form-select" value="@selectedProfileId" @onchange="SelectProfileAsync" disabled="@(!BackendProfiles.Any())">
                <option value="">Select a saved set...</option>
                @foreach (var profile in BackendProfiles.OrderBy(profile => profile.Name))
                {
                    <option value="@profile.Id">@profile.Name</option>
                }
            </select>
        </div>
        <div class="profile-actions">
            <button class="profile-button" type="button" @onclick="CreateProfileAsync" disabled="@string.IsNullOrWhiteSpace(CurrentModelPath)">Create</button>
            <button class="profile-button" type="button" @onclick="UpdateProfileAsync" disabled="@(!selectedProfileId.HasValue)">Update</button>
            <button class="profile-button profile-button-danger" type="button" @onclick="DeleteSelectedProfileAsync" disabled="@(!selectedProfileId.HasValue)">Delete</button>
            <button class="profile-button" type="button" @onclick="OpenAssignProfileAsync" disabled="@(!BackendProfiles.Any())">Assign</button>
        </div>
    </div>

    <div class="timeout-settings-link">
        <div>
            <p class="eyebrow">INFERENCE TIMEOUTS</p>
            <strong>Backend-Zeitbudgets</strong>
            <p>Die globalen Werte für Basiszeit, Tools und Prefill werden in den allgemeinen Einstellungen gepflegt.</p>
        </div>
        <a class="profile-button profile-button-primary" href="settings">Globale Timeouts öffnen</a>
    </div>

    @if (selectedProfileId.HasValue)
    {
        <div class="profile-identity-row">
            <label class="profile-identity-field">Configuration name <InputText class="form-control" @bind-Value="selectedProfileName" /></label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="selectedProfileAutoLaunch" /> AutoLaunch bei API-Anfragen</label>
        </div>
        <div id="profile-timeout-settings" class="profile-timeout-row">
            <div class="profile-timeout-copy">
                <p class="eyebrow">CONFIGURATION OVERRIDE</p>
                <label class="setting-toggle"><InputCheckbox @bind-Value="profileTimeoutEnabled" /> Timeout für diese Konfiguration überschreiben</label>
                <small>Leer lassen, um die globalen Werte des Backends zu verwenden.</small>
            </div>
            @if (profileTimeoutEnabled)
            {
                <label class="profile-timeout-field">Basiszeit (s) <InputNumber class="form-control" @bind-Value="profileTimeoutBaseSeconds" /></label>
                <label class="profile-timeout-field">Pro Tool (s) <InputNumber class="form-control" @bind-Value="profileTimeoutSecondsPerTool" /></label>
                <label class="profile-timeout-field">Pro Prefill-Token (s) <InputNumber class="form-control" @bind-Value="profileTimeoutSecondsPerPrefillToken" /></label>
            }
        </div>
    }

    @if (isAssigningProfile)
    {
        <div class="profile-create-row">
            <label class="form-label" for="shared-assign-source-profile">Configuration to copy</label>
            <div class="profile-create-fields">
                <select id="shared-assign-source-profile" class="form-select" value="@assignSourceProfileId" @onchange="SelectAssignSourceProfileAsync">
                    <option value="">Select a configuration...</option>
                    @foreach (var profile in BackendProfiles.OrderBy(profile => profile.Name))
                    {
                        <option value="@profile.Id">@profile.Name</option>
                    }
                </select>
                <label class="form-label" for="shared-assign-target-model">Target model</label>
                <select id="shared-assign-target-model" class="form-select" value="@profileTargetModelPath" @onchange="SelectProfileTargetModelAsync">
                    <option value="">Select a model...</option>
                    @foreach (var model in CurrentBackendModels)
                    {
                        <option value="@model.Path">@model.Name</option>
                    }
                </select>
                <button class="profile-button profile-button-primary" type="button" @onclick="AssignProfileToModelAsync" disabled="@(!assignSourceProfileId.HasValue || string.IsNullOrWhiteSpace(profileTargetModelPath))">Copy</button>
                <button class="profile-button" type="button" @onclick="CancelAssignProfile">Cancel</button>
            </div>
        </div>
    }

    @if (isCreatingProfile)
    {
        <div class="profile-create-row">
            <label class="form-label" for="shared-new-profile-name">Set name</label>
            <div class="profile-create-fields">
                <InputText id="shared-new-profile-name" class="form-control" @bind-Value="newProfileName" />
                <button class="profile-button profile-button-primary" type="button" @onclick="SaveNewProfileAsync">Save</button>
                <button class="profile-button" type="button" @onclick="CancelCreateProfile">Cancel</button>
            </div>
        </div>
    }

    <section class="gpu-panel shared-device-routing">
        <div class="section-heading">
            <div>
                <p class="eyebrow">DEVICE ROUTING</p>
                <h2>@GetBackendLabel(activeBackend) device</h2>
            </div>
            <span class="device-count">@GetRoutingDeviceCount()</span>
        </div>
        <p class="panel-note">Device routing is saved with this model configuration. SYCL and CUDA use the selected native devices; Vulkan additionally supports explicit device weights.</p>
        @if (activeBackend == BackendTab.OpenVino)
        {
            <p class="panel-note">Enable devices with a compatible vendor driver for OpenVINO MULTI scheduling, or select one accelerator route.</p>
            @if (openVinoDiagnostics?.Devices.Any(device => !IsExcludedDevice(device.Name)) == true)
            {
                @foreach (var device in openVinoDiagnostics.Devices.Where(device => !IsExcludedDevice(device.Name)))
                {
                    <div class="gpu-row @(device.IsCompatible ? "" : "gpu-row-disabled")">
                        <div class="gpu-identity">
                            <input class="form-check-input" type="checkbox" id="openvino-device-@device.Id"
                                   checked="@(device.IsCompatible && GetOpenVinoDeviceSetting(device.Id).Enabled)"
                                   disabled="@(!device.IsCompatible || IsExcludedDevice(device.Name))"
                                   @onchange="async eventArgs => await SetOpenVinoDeviceEnabledAsync(device.Id, eventArgs.Value is true)" />
                            <label class="gpu-name" for="openvino-device-@device.Id">
                                <strong>@device.Name</strong>
                                <span>@device.Vendor · @device.Driver · @device.Detail</span>
                            </label>
                        </div>
                        <div class="weight-field">
                            <label for="@($"openvino-weight-{device.Id}")">Priority</label>
                            <input id="@($"openvino-weight-{device.Id}")" class="form-control" type="number" min="0" step="0.1"
                                   disabled="@(!device.IsCompatible || IsExcludedDevice(device.Name))"
                                   value="@GetOpenVinoDeviceSetting(device.Id).Weight.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                   @onchange="async eventArgs => await SetOpenVinoDeviceWeightAsync(device.Id, eventArgs.Value?.ToString())" />
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No OpenVINO devices found.</p>
            }
        }
        else if (activeBackend == BackendTab.Llama)
        {
            <p class="panel-note">Select the devices to use for CUDA, SYCL, or Vulkan. Leave all devices unchecked to use all compatible accelerators.</p>
            @if (GetLlamaRoutingDevices().Count > 0)
            {
                @foreach (var device in GetLlamaRoutingDevices())
                {
                    var deviceId = device.DeviceId;
                    <div class="gpu-row">
                        <div class="gpu-identity">
                            <input class="form-check-input" type="checkbox" id="device-@deviceId"
                                   checked="@(GetDeviceSetting(deviceId).Enabled)"
                                   @onchange="async eventArgs => await SetDeviceEnabledAsync(deviceId, eventArgs.Value is true)" />
                            <label class="gpu-name" for="device-@deviceId">
                                <strong>@device.DeviceCaption</strong>
                                <span>@deviceId · @GetBackendDriverLabel(device)</span>
                            </label>
                        </div>
                        <div class="weight-field">
                            <label for="@($"weight-{deviceId}")">Weight</label>
                            <input id="@($"weight-{deviceId}")" class="form-control" type="number" min="0" step="0.1"
                                   value="@GetDeviceSetting(deviceId).Weight.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                   @onchange="async eventArgs => await SetDeviceWeightAsync(deviceId, eventArgs.Value?.ToString())" />
                        </div>
                    </div>
                }
                <small class="text-muted">Select GPU indices for @llamaState.Backend. With no selection, all compatible devices are used.</small>
            }
            else
            {
                <p class="text-muted">No devices found.</p>
            }
        }
        else if (activeBackend is BackendTab.Vllm or BackendTab.Sglang)
        {
            <div class="field-group">
                <label class="form-label">Accelerator devices</label>
                <div class="python-device-list">
                    @foreach (var route in pythonDeviceRoutes.Where(route => route.Backends.Contains(activeBackend)))
                    {
                        <label class="python-device-option">
                            <input class="form-check-input" type="checkbox"
                                   checked="@pythonForm.IsDeviceSelected(route.Value)"
                                   @onchange="async eventArgs => await SetPythonDeviceSelectedAsync(route.Value, eventArgs.Value is true)" />
                            <span>@route.Label</span>
                        </label>
                    }
                </div>
                <label class="form-label" for="python-additional-device-routes">Additional device routes</label>
                <InputText id="python-additional-device-routes" class="form-control" @bind-Value="pythonForm.AdditionalDeviceRoutes" @bind-Value:after="SaveSettingsAsync" placeholder="cuda:1, cuda:2" />
                <small class="form-text">The requirements environment follows the selected device vendor. CUDA and XPU devices cannot be mixed in one worker.</small>
            </div>
        }
        else
        {
            <div class="field-group">
                <label class="form-label" for="dotllm-device-route">Device route</label>
                <InputText id="dotllm-device-route" class="form-control" @bind-Value="dotLlmForm.Device" @bind-Value:after="SaveSettingsAsync" />
            </div>
        }
    </section>
</section>

@if (activeBackend is BackendTab.Vllm or BackendTab.Sglang)
{
    <section class="config-panel">
        <div class="section-heading"><div><p class="eyebrow">PYTHON INFERENCE SERVER</p><h2>Load configuration</h2></div><span class="step-label">01</span></div>
        <div class="field-row">
            <div class="field-group"><label class="form-label" for="python-model">Model path or Hugging Face ID</label><InputText id="python-model" class="form-control" @bind-Value="pythonForm.ModelPath" @bind-Value:after="SaveSettingsAsync" placeholder="Qwen/Qwen3.8-Flash-Next" /></div>
            <div class="field-group"><label class="form-label" for="python-executable">Python environment</label><InputSelect id="python-executable" class="form-select" @bind-Value="pythonForm.PythonExecutable" @bind-Value:after="HandlePythonExecutableChangedAsync">
                @foreach (var option in PythonExecutableOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </InputSelect></div>
        </div>
        <div class="field-row">
            <div class="field-group"><label class="form-label" for="python-context">Max model length</label><InputNumber id="python-context" class="form-control" @bind-Value="pythonForm.MaxModelLength" @bind-Value:after="SaveSettingsAsync" /></div>
            <div class="field-group"><label class="form-label" for="python-tp">Tensor parallel size</label><InputNumber id="python-tp" class="form-control" @bind-Value="pythonForm.TensorParallelSize" @bind-Value:after="SaveSettingsAsync" /></div>
            <div class="field-group"><label class="form-label" for="python-gpu-memory">GPU memory utilization (%)</label><InputNumber id="python-gpu-memory" class="form-control" @bind-Value="pythonForm.GpuMemoryUtilization" @bind-Value:after="SaveSettingsAsync" /></div>
        </div>
        <label class="setting-toggle"><InputCheckbox @bind-Value="pythonForm.TrustRemoteCode" @bind-Value:after="SaveSettingsAsync" /> Trust remote code</label>
        @if (activeBackend == BackendTab.Vllm)
        {
            <div class="field-row">
                <div class="field-group"><label class="form-label" for="python-quantization">Quantization</label><InputSelect id="python-quantization" class="form-select" @bind-Value="pythonForm.Quantization" @bind-Value:after="SaveSettingsAsync">
                    <option value="">Automatic (model config)</option>
                    <option value="fp8">FP8</option>
                    <option value="gptq">GPTQ</option>
                </InputSelect></div>
                <div class="field-group"><label class="form-label" for="python-dtype">Model dtype</label><InputText id="python-dtype" class="form-control" @bind-Value="pythonForm.DType" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label" for="python-kv-cache-dtype">KV cache dtype</label><InputText id="python-kv-cache-dtype" class="form-control" @bind-Value="pythonForm.KvCacheDType" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
            <div class="field-row">
                <div class="field-group"><label class="form-label" for="python-mtp-tokens">MTP speculative tokens</label><InputNumber id="python-mtp-tokens" class="form-control" @bind-Value="pythonForm.MtpTokens" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label" for="python-max-seqs">Maximum sequences</label><InputNumber id="python-max-seqs" class="form-control" @bind-Value="pythonForm.MaxNumSeqs" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label" for="python-batched-tokens">Maximum batched tokens</label><InputNumber id="python-batched-tokens" class="form-control" @bind-Value="pythonForm.MaxNumBatchedTokens" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
            <label class="setting-toggle"><InputCheckbox @bind-Value="pythonForm.EnablePrefixCaching" @bind-Value:after="SaveSettingsAsync" /> Enable prefix caching</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="pythonForm.EnableXpuGraph" @bind-Value:after="SaveSettingsAsync" /> Enable XPU graph mode</label>
            <label class="setting-toggle"><InputCheckbox @bind-Value="pythonForm.EnableBf16MtpDraft" @bind-Value:after="SaveSettingsAsync" /> Keep MTP draft layers in BF16</label>
        }
        @if (!string.IsNullOrWhiteSpace(pythonStatus)) { <p class="mt-3" role="status">@pythonStatus</p> }
    </section>

    @if (GetBackendLoadLog() is { } backendLoadLog)
    {
        <section class="telemetry-panel backend-load-log-panel" aria-labelledby="backend-load-log-heading">
            <div class="section-heading">
                <div><p class="eyebrow">BACKEND LOAD LOG</p><h2 id="backend-load-log-heading">@GetBackendLabel(activeBackend) output</h2></div>
            </div>
            <textarea class="form-control log-output" rows="14" readonly>@backendLoadLog</textarea>
        </section>
    }

    <section class="telemetry-panel">
        <div class="section-heading"><div><p class="eyebrow">RUNTIME TELEMETRY</p><h2>Python engine status</h2></div></div>
        <dl class="telemetry-grid">
            <dt>Engine</dt>
            <dd>@GetBackendLabel(activeBackend)</dd>
            <dt>Python executable</dt>
            <dd>@pythonForm.PythonExecutable</dd>
            <dt>Model</dt>
            <dd>@(string.IsNullOrWhiteSpace(pythonForm.ModelPath) ? "Not selected" : pythonForm.ModelPath)</dd>
            <dt>Transport</dt>
            <dd>Local gRPC bridge</dd>
            <dt>Runtime</dt>
            <dd class="diagnostic-@(loadStatus?.Backend is "vLLM" or "SGLang" ? "ok" : "error")">@(isPythonLoading ? "Starting" : loadStatus?.Backend is "vLLM" or "SGLang" ? "Ready" : "Not running")</dd>
        </dl>
    </section>
}

@if (activeBackend == BackendTab.DotLlm)
