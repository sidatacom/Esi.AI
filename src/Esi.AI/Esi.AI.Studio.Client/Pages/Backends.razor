                <div class="field-group"><label class="form-label">YARN attention factor</label><InputNumber class="form-control" @bind-Value="llamaAdvancedState.YarnAttentionFactor" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">YARN beta fast</label><InputNumber class="form-control" @bind-Value="llamaAdvancedState.YarnBetaFast" @bind-Value:after="SaveSettingsAsync" /></div>
                <div class="field-group"><label class="form-label">YARN beta slow</label><InputNumber class="form-control" @bind-Value="llamaAdvancedState.YarnBetaSlow" @bind-Value:after="SaveSettingsAsync" /></div>
            </div>
