        new("OpenVINO", "Not supported", "GPU/NPU", "Not supported", "Yes (MULTI)", "No", "Intel OpenVINO plugin and device driver"),
        new("vLLM", "CUDA", "XPU option", "Not in current environment", "Yes (TP)", "No", "CUDA or Intel XPU stack per worker"),
        new("SGLang", "CUDA", "XPU", "ROCm where installed", "Yes (TP)", "No", "One homogeneous vendor driver stack"),
