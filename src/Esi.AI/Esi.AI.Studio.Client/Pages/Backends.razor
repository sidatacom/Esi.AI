    private void SyncOpenVinoDevices()
    {
        if (openVinoDiagnostics?.Devices is null)
            return;

        foreach (var device in openVinoDiagnostics.Devices.Where(device => device.IsCompatible && !IsExcludedDevice(device.Name)))
        {
            if (!openVinoState.Devices.ContainsKey(device.Id))
                openVinoState.Devices[device.Id] = new OpenVinoDeviceSetting(false, 0);
        }

        foreach (var device in openVinoState.Devices.Keys.Except(openVinoDiagnostics.Devices.Where(device => device.IsCompatible && !IsExcludedDevice(device.Name)).Select(device => device.Id), StringComparer.OrdinalIgnoreCase).ToArray())
            openVinoState.Devices.Remove(device);

        UpdateOpenVinoDeviceRoute();
    }

    private OpenVinoDeviceSetting GetOpenVinoDeviceSetting(string device) =>
        openVinoState.Devices.TryGetValue(device, out var setting)
            ? setting
            : new OpenVinoDeviceSetting(false, 0);

    private async Task SetOpenVinoDeviceEnabledAsync(string device, bool enabled)
    {
        var setting = GetOpenVinoDeviceSetting(device);
        if (enabled && device.StartsWith("NPU", StringComparison.OrdinalIgnoreCase))
        {
            foreach (var npuDevice in openVinoState.Devices.Keys
                .Where(key => key.StartsWith("NPU", StringComparison.OrdinalIgnoreCase) && !string.Equals(key, device, StringComparison.OrdinalIgnoreCase))
                .ToArray())
                openVinoState.Devices[npuDevice] = GetOpenVinoDeviceSetting(npuDevice) with { Enabled = false };
        }
        else if (enabled)
        {
            foreach (var npuDevice in openVinoState.Devices.Keys
                .Where(key => key.StartsWith("NPU", StringComparison.OrdinalIgnoreCase))
                .ToArray())
                openVinoState.Devices[npuDevice] = GetOpenVinoDeviceSetting(npuDevice) with { Enabled = false };
        }
        openVinoState.Devices[device] = enabled
            ? new OpenVinoDeviceSetting(true, setting.Weight > 0 ? setting.Weight : 1)
            : setting with { Enabled = false };
        UpdateOpenVinoDeviceRoute();
        await SaveSettingsAsync();
    }

    private async Task SetOpenVinoDeviceWeightAsync(string device, string? value)
    {
        _ = float.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var weight);
        var setting = GetOpenVinoDeviceSetting(device);
        openVinoState.Devices[device] = setting with { Weight = Math.Max(0, weight) };
        UpdateOpenVinoDeviceRoute();
        await SaveSettingsAsync();
    }

    private void UpdateOpenVinoDeviceRoute()
    {
        var enabledDevices = openVinoState.Devices
            .Where(pair => pair.Value.Enabled && pair.Value.Weight > 0)
            .OrderByDescending(pair => pair.Value.Weight)
            .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var npuDevice = enabledDevices.FirstOrDefault(pair => pair.Key.StartsWith("NPU", StringComparison.OrdinalIgnoreCase));
        var devices = npuDevice.Key is not null
            ? [npuDevice]
            : enabledDevices;
        openVinoState.Device = devices.Length switch
        {
            0 => string.Empty,
            1 => devices[0].Key,
            _ => $"MULTI:{string.Join(',', devices.Select(pair => pair.Key))}"
        };
    }

    private async Task SelectBackendAsync(BackendTab backend)
    {
        if (selectedProfileId.HasValue)
            selectedProfileIds[activeBackend] = selectedProfileId.Value;

        activeBackend = backend;
        await PersistSelectedBackendAsync(backend);
        statusMessage = null;
        isBackendRequirementsExpanded = false;
        backendPrerequisites = null;
        isAssigningProfile = false;
        isCreatingProfile = false;
        backendModels = await DataService.BackendModel_ReadAsync(GetConfigurationBackend(backend));
        await InvokeAsync(StateHasChanged);
        await RefreshBackendPrerequisitesAsync();
        var modelPath = backend switch
        {
            BackendTab.Llama => llamaState.ModelPath,
            BackendTab.OpenVino => openVinoState.ModelPath,
            BackendTab.DotLlm => dotLlmForm.ModelPath,
            _ => pythonForm.ModelPath
        };
        var configurationBackend = GetConfigurationBackend(backend);
        var rememberedProfile = selectedProfileIds.TryGetValue(backend, out var rememberedProfileId)
            ? profiles.FirstOrDefault(item => item.Id == rememberedProfileId && item.Backend == configurationBackend)
            : null;
        if (string.IsNullOrWhiteSpace(modelPath) && rememberedProfile is not null)
        {
            modelPath = rememberedProfile.ModelPath;
            SetModelPath(backend, modelPath);
        }
        if (string.IsNullOrWhiteSpace(modelPath))
        {
            modelPath = CurrentBackendModels.FirstOrDefault()?.Path ?? string.Empty;
            SetModelPath(backend, modelPath);
        }
        if (string.IsNullOrWhiteSpace(modelPath))
        {
            selectedProfileId = null;
            if (backend == BackendTab.OpenVino)
                ResetOpenVinoConfiguration();
            else if (backend == BackendTab.Llama)
                ResetModelConfiguration();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var profile = rememberedProfile ?? GetPreferredProfile(modelPath, configurationBackend);
        if (profile is not null)
        {
            TryApplyProfile(profile);
            SetModelPath(backend, profile.ModelPath);
            selectedProfileIds[backend] = profile.Id;
        }
        else
        {
            selectedProfileId = null;
            if (backend == BackendTab.OpenVino)
                ResetOpenVinoConfiguration();
            else if (backend == BackendTab.Llama)
                ResetModelConfiguration();
            else if (IsPythonBackendTab(backend))
                pythonForm.Reset();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task PersistSelectedBackendAsync(BackendTab backend)
    {
        var settings = await DataService.ApplicationSettings_ReadAsync();
        await DataService.ApplicationSettings_UpdateAsync(settings with
        {
