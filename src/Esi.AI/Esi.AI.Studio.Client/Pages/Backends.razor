    private IReadOnlyList<DeviceStatus> GetLlamaRoutingDevices()
    {
        var prefix = llamaState.Backend.Trim().ToUpperInvariant() switch
        {
            "SYCL" => "SYCL",
            "CUDA" => "CUDA",
            "VULKAN" => "VULKAN",
            _ => string.Empty
        };
        var configuredDevices = llamaState.BackendDevices.Keys
            .Where(device => prefix.Length == 0 || device.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            .ToArray();
        if (configuredDevices.Length > 0 && prefix is "SYCL" or "CUDA")
            return configuredDevices
                .Select((device, index) => new DeviceStatus(
                    prefix == "SYCL" ? $"SYCL{index}" : device,
                    prefix == "SYCL" ? $"SYCL{index}" : device,
                    0,
                    null,
                    prefix == "CUDA" ? "NVIDIA" : "Intel",
                    prefix == "SYCL" ? "SYCL native runtime" : "CUDA native runtime"))
                .ToArray();

        if (prefix == "SYCL")
        {
            var staleVulkanDevices = loadStatus?.Devices
                .Where(device => device.DeviceId.StartsWith("Vulkan", StringComparison.OrdinalIgnoreCase) ||
                    device.DeviceId.StartsWith("GPU", StringComparison.OrdinalIgnoreCase))
                .Where(device => !IsExcludedDevice(device.Description ?? device.Name))
                .ToArray() ?? [];
            if (staleVulkanDevices.Length > 0)
                return staleVulkanDevices
                    .Select((device, index) => device with { DeviceId = $"SYCL{index}" })
                    .ToArray();
        }

        var devices = loadStatus?.Devices
            .Where(device => prefix.Length == 0 || device.DeviceId.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            .Where(device => !IsExcludedDevice(device.Description ?? device.Name))
            .ToArray() ?? [];
        if (devices.Length > 0)
            return devices;

        return configuredDevices
            .Select(device => new DeviceStatus(
                device,
                device,
                0,
                null,
                prefix == "CUDA" ? "NVIDIA" : "Intel",
                prefix == "SYCL" ? "SYCL native runtime" : $"{prefix} native runtime"))
            .ToArray();
    }

    private static IReadOnlyDictionary<string, float> GetConfiguredLlamaDevices(LoadModelRequest request)
    {
        var configuredDevices = request.Devices is { Count: > 0 }
            ? request.Devices.ToDictionary(device => device, _ => 1f, StringComparer.OrdinalIgnoreCase)
            : request.VulkanDeviceWeights ?? new Dictionary<string, float>(StringComparer.OrdinalIgnoreCase);

        if (string.Equals(request.Backend, "SYCL", StringComparison.OrdinalIgnoreCase))
        {
            return configuredDevices
                .Select((device, index) => new KeyValuePair<string, float>(
                    device.Key.StartsWith("SYCL", StringComparison.OrdinalIgnoreCase) ? device.Key : $"SYCL{index}",
                    device.Value))
                .GroupBy(device => device.Key, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(group => group.Key, group => group.First().Value, StringComparer.OrdinalIgnoreCase);
        }

        return configuredDevices;
    }

    private static bool IsExcludedDevice(string deviceName) =>
        deviceName.Contains("UHD Graphics 630", StringComparison.OrdinalIgnoreCase);

    private string GetBackendDriverLabel(DeviceStatus device)
    {
        if (llamaState.Backend.Equals("SYCL", StringComparison.OrdinalIgnoreCase))
            return "Intel SYCL/Level Zero driver";
        if (llamaState.Backend.Equals("CUDA", StringComparison.OrdinalIgnoreCase))
            return "NVIDIA CUDA driver";
        if (!string.IsNullOrWhiteSpace(device.Driver))
            return device.Driver;
        if (!string.IsNullOrWhiteSpace(device.Vendor))
            return $"{device.Vendor} Vulkan driver";
        if (device.Description?.Contains("NVIDIA", StringComparison.OrdinalIgnoreCase) == true)
            return "NVIDIA Vulkan driver";
        if (device.Description?.Contains("Intel", StringComparison.OrdinalIgnoreCase) == true)
            return "Intel Vulkan/xe driver";
        if (device.Description?.Contains("AMD", StringComparison.OrdinalIgnoreCase) == true)
            return "AMD Vulkan driver";
        return "Vulkan driver";
    }

