@page "/settings"
@rendermode InteractiveAuto
@implements IAsyncDisposable
@using Esi.AI.Models
@using Esi.AI.Studio.Client.State
@using Esi.AI.Studio.Contracts
@inject IDataService DataService
@inject IApplicationSettingsEvents ApplicationSettingsEvents

<div class="settings-shell">
    <header class="settings-header">
        <div>
            <p class="eyebrow">STUDIO / GENERAL</p>
            <h1>General settings</h1>
            <p class="lede">Globale Laufzeitregeln für alle lokalen Backends.</p>
        </div>
        <button class="primary-button" type="button" @onclick="SaveAsync" disabled="@isSaving">@(isSaving ? "Speichert ..." : "Settings speichern")</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="settings-message" role="status">@message</p>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="settings-message settings-message-error" role="alert">@errorMessage</p>
    }

    <section class="settings-panel" aria-labelledby="workflow-definitions-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">WORKFLOWS</p>
                <h2 id="workflow-definitions-heading">Workflow definitions</h2>
            </div>
        </div>
        <p class="settings-note">Gespeicherte Flow-Definitionen aus der Datenbank. Die JSON-Struktur lässt sich pro Workflow aufklappen.</p>
        @if (flowDefinitions.Count == 0)
        {
            <p class="settings-note">Noch keine Workflows gespeichert.</p>
        }
        else
        {
            <div class="workflow-definition-list">
                @foreach (var definition in flowDefinitions)
                {
                    <details class="workflow-definition">
                        <summary><strong>@definition.Name</strong><span>v@definition.Version · @(definition.IsPublished ? "Published" : "Draft")</span></summary>
                        <textarea rows="14" readonly>@definition.DefinitionJson</textarea>
                    </details>
                }
            </div>
        }
    </section>

    <section class="settings-panel" aria-labelledby="inference-timeout-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">INFERENCE DEADLINE</p>
                <h2 id="inference-timeout-heading">Tool- und Prefill-Zeitbudget</h2>
            </div>
        </div>
        <p class="settings-note">Das vollständige Toolset bleibt erhalten. Diese Werte bestimmen nur, wie viel Zeit ein lokaler Backend-Aufruf für Vorbereitung und Prefill erhält.</p>
        <div class="settings-backends">
            @foreach (var timeout in form.Backends)
            {
                <div class="backend-timeout-row">
                    <strong>@timeout.Backend</strong>
                    <label class="field-group"><span>Basiszeit (s)</span><input type="number" min="0" step="1" @bind="timeout.BaseSeconds" @bind:event="oninput" /></label>
                    <label class="field-group"><span>Pro Tool (s)</span><input type="number" min="0" step="0.1" @bind="timeout.SecondsPerTool" @bind:event="oninput" /></label>
                    <label class="field-group"><span>Pro Prefill-Token (s)</span><input type="number" min="0" step="0.001" @bind="timeout.SecondsPerPrefillToken" @bind:event="oninput" /></label>
                </div>
            }
        </div>
    </section>

    <section class="settings-panel" aria-labelledby="runtime-sources-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">BACKEND RUNTIMES</p>
                <h2 id="runtime-sources-heading">Runtime-Quellen</h2>
            </div>
        </div>
        <p class="settings-note">Jedes Backend verwendet eine isolierte Runtime-Quelle. Native Backends werden über NuGet-Pakete oder den zugehörigen Runtime-Ordner verteilt; Python-Backends verwenden eine eigene venv.</p>
        <div class="runtime-options">
            <label class="field-group"><span>Katalog-URL</span><input @bind="runtimeOptions.CatalogUrl" /></label>
            <label class="field-group"><span>Installationsordner</span><input @bind="runtimeOptions.InstallationDirectory" /></label>
            <label class="checkbox-group"><input type="checkbox" @bind="runtimeOptions.AllowLocalPackages" /> Lokale Entwicklungspakete erlauben</label>
        </div>
        <div class="source-list">
            @foreach (var package in runtimeOptions.Packages)
            {
                <div class="source-row">
                    <div class="source-row-header"><strong>@package.Id</strong><button class="secondary-button" type="button" @onclick="() => RemovePackage(package)">Entfernen</button></div>
                    <div class="package-grid">
                        <label class="field-group"><span>Backend</span><select @bind="package.Backend"><option>Llama</option><option>OpenVINO</option><option>vLLM</option><option>SGLang</option><option>dotLLM</option></select></label>
                        <label class="field-group"><span>Route</span><input @bind="package.Route" /></label>
                        <label class="field-group"><span>RID</span><input @bind="package.RuntimeIdentifier" /></label>
                        <label class="field-group"><span>Version</span><input @bind="package.Version" /></label>
                        <label class="field-group field-wide"><span>Archiv-URL</span><input @bind="package.ArchiveUrl" /></label>
                        <label class="field-group field-wide"><span>Lokaler Pfad</span><input @bind="package.LocalPath" /></label>
                        <label class="field-group field-wide"><span>Erforderliche Dateien, komma-getrennt</span><input @bind="package.RequiredFilesText" /></label>
                        <label class="field-group field-wide"><span>Treiberanforderung</span><input @bind="package.DriverRequirement" /></label>
                        <label class="checkbox-group"><input type="checkbox" @bind="package.RequiresRestart" /> Neustart erforderlich</label>
                    </div>
                </div>
            }
        </div>
        <button class="secondary-button" type="button" @onclick="AddPackage">Paket hinzufügen</button>
    </section>

    <section class="settings-panel" aria-labelledby="model-library-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">MODEL LIBRARY</p>
                <h2 id="model-library-heading">Hugging Face</h2>
            </div>
        </div>
        <p class="settings-note">Für geschützte Repositories benötigt der Modelldownload einen Hugging-Face-Token mit Read-Berechtigung. Der Wert wird lokal gespeichert und nicht ins Repository geschrieben.</p>
        <label class="field-group" for="hugging-face-token">
            <span>Hugging-Face-Token</span>
            <input id="hugging-face-token" type="password" autocomplete="new-password" @bind="form.HuggingFaceToken" placeholder="@(form.HasHuggingFaceToken ? "Gespeicherter Token bleibt unverändert" : "hf_...")" />
        </label>
        @if (form.HasHuggingFaceToken)
        {
            <label class="checkbox-group"><input type="checkbox" @bind="form.ClearHuggingFaceToken" /> Gespeicherten Token entfernen</label>
        }
    </section>
</div>

<style>
    .settings-shell { display: grid; gap: 1.25rem; max-width: 70rem; padding: 2rem 1.25rem 3rem; }
    .settings-header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
    .settings-header h1 { margin: 0; }
    .settings-panel { border: 1px solid #d9d4ca; background: #fff; padding: 1.25rem; }
    .settings-note, .settings-message { color: #5e625f; }
    .settings-message { margin: 0; padding: .75rem 1rem; background: #e8f3ed; color: #185b3a; }
    .settings-message-error { background: #f9e7e3; color: #8b2f22; }
    .settings-backends { display: grid; gap: .75rem; }
    .source-list { display: grid; gap: .75rem; }
    .source-row { display: grid; gap: .3rem; padding: .85rem 0; border-top: 1px solid #ebe7df; }
    .source-row a { color: #176b5b; font-weight: 700; overflow-wrap: anywhere; }
    .source-row span { color: #5e625f; font-size: .9rem; }
    .runtime-options, .package-grid { display: grid; gap: .75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: .75rem; }
    .field-wide { grid-column: 1 / -1; }
    .source-row-header { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
    .workflow-definition-list { display: grid; gap: .75rem; }.workflow-definition { border-top: 1px solid #ebe7df; padding-top: .75rem; }.workflow-definition summary { display: flex; justify-content: space-between; gap: 1rem; cursor: pointer; }.workflow-definition summary span { color: #5e625f; font-size: .85rem; }.workflow-definition textarea { box-sizing: border-box; width: 100%; margin-top: .7rem; resize: vertical; border: 1px solid #c9c4bb; padding: .7rem; background: #faf9f6; font: .78rem/1.45 monospace; }
    .checkbox-group { display: flex; align-items: center; gap: .5rem; font-weight: 700; }
    .secondary-button { border: 1px solid #176b5b; background: transparent; color: #176b5b; padding: .55rem .8rem; font: inherit; font-weight: 700; }
    .backend-timeout-row { display: grid; grid-template-columns: 7rem repeat(3, minmax(0, 1fr)); align-items: end; gap: 1rem; padding: .85rem 0; border-top: 1px solid #ebe7df; }
    .field-group { display: grid; gap: .4rem; color: #313633; font-weight: 700; }
    .field-group input { width: 100%; border: 1px solid #c9c4bb; padding: .7rem; font: inherit; }
    @@media (max-width: 760px) { .settings-header { align-items: stretch; flex-direction: column; } .backend-timeout-row { grid-template-columns: 1fr; } }
</style>

@code {
    private readonly SettingsPageState pageState = new();
    private readonly SettingsForm form = new();
    private bool isSaving;
    private BackendRuntimeForm runtimeOptions = new();
    private IReadOnlyList<FlowDefinition> flowDefinitions = [];
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        ApplicationSettingsEvents.ApplicationSettings_Update += OnSettingsUpdatedAsync;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var settingsTask = DataService.ApplicationSettings_ReadAsync();
            var runtimeTask = DataService.BackendRuntimePackage_ReadAsync();
            var flowTask = DataService.FlowDefinition_ReadAsync();
            await Task.WhenAll(settingsTask, runtimeTask, flowTask);
            Apply(await settingsTask);
            runtimeOptions.Apply(await runtimeTask);
            flowDefinitions = await EnsureDefaultFlowDefinitionsAsync(await flowTask);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
    }

    private async Task<IReadOnlyList<FlowDefinition>> EnsureDefaultFlowDefinitionsAsync(IReadOnlyList<FlowDefinition> definitions)
    {
        var result = definitions.ToList();
        foreach (var (name, definitionJson) in DefaultFlowDefinitions)
        {
            if (result.Any(definition => definition.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
                continue;

            var now = DateTime.UtcNow;
            result.Add(await DataService.FlowDefinition_CreateAsync(new FlowDefinition(
                Guid.Empty,
                name,
                1,
                false,
                definitionJson,
                now,
                now)));
        }

        return result.OrderBy(definition => definition.Name).ToArray();
    }

    private static readonly (string Name, string DefinitionJson)[] DefaultFlowDefinitions =
    [
        ("Chat request router", """{"nodes":[{"Name":"Incoming chat request","Detail":"POST /v1/chat/completions","Kind":"trigger"},{"Name":"Route by model","Detail":"model + request shape","Kind":"route"},{"Name":"Local chat backend","Detail":"Loaded local model","Kind":"backend"}]}"""),
        ("Vision request router", """{"nodes":[{"Name":"Incoming vision request","Detail":"image + messages","Kind":"trigger"},{"Name":"Check image capability","Detail":"vision model required","Kind":"guard"},{"Name":"Vision backend","Detail":"Multimodal local model","Kind":"backend"}]}""")
    ];

    private async Task SaveAsync()
    {
        isSaving = true;
        message = null;
        errorMessage = null;
        try
        {
            if (form.Backends.Any(backend => !backend.IsValid))
            {
                errorMessage = "Alle Zeitbudgets müssen endlich und nicht negativ sein.";
                return;
            }

            Apply(await DataService.ApplicationSettings_UpdateAsync(form.ToContract()));
            runtimeOptions.Apply(await DataService.BackendRuntimePackage_UpdateAsync(runtimeOptions.ToContract()));
            message = "Settings gespeichert.";
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task OnSettingsUpdatedAsync(ApplicationSettings settings)
    {
        Apply(settings);
        return InvokeAsync(StateHasChanged);
    }

    private void Apply(ApplicationSettings settings)
    {
        form.Apply(settings);
    }

    private void AddPackage() => runtimeOptions.Packages.Add(new RuntimePackageForm());

    private void RemovePackage(RuntimePackageForm package) => runtimeOptions.Packages.Remove(package);

    public ValueTask DisposeAsync()
    {
        ApplicationSettingsEvents.ApplicationSettings_Update -= OnSettingsUpdatedAsync;
        return ValueTask.CompletedTask;
    }

    private sealed class SettingsForm
    {
        public List<BackendSettingsForm> Backends { get; } = BackendNames
            .Select(backend => new BackendSettingsForm(backend))
            .ToList();
        public ModelLibrarySettings ModelLibrary { get; private set; } = new();

        public string? HuggingFaceToken { get; set; }
        public bool HasHuggingFaceToken { get; private set; }
        public bool ClearHuggingFaceToken { get; set; }

        public ApplicationSettings ToContract() => new(
            Backends.Select(item => item.ToContract()).ToArray(),
            ModelLibrary: ModelLibrary with
            {
                HuggingFaceToken = ClearHuggingFaceToken
                    ? null
                    : string.IsNullOrWhiteSpace(HuggingFaceToken) ? existingHuggingFaceToken : HuggingFaceToken.Trim()
            });

        public void Apply(ApplicationSettings settings)
        {
            foreach (var backend in settings.InferenceTimeouts)
            {
                var form = Backends.FirstOrDefault(item => string.Equals(item.Backend, backend.Backend, StringComparison.OrdinalIgnoreCase));
                form?.Apply(backend);
            }

            existingHuggingFaceToken = settings.ModelLibrary?.HuggingFaceToken;
            HasHuggingFaceToken = !string.IsNullOrWhiteSpace(existingHuggingFaceToken);
            HuggingFaceToken = null;
            ClearHuggingFaceToken = false;
            ModelLibrary = settings.ModelLibrary ?? new ModelLibrarySettings();
        }

        private string? existingHuggingFaceToken;
    }

    private static IReadOnlyList<string> BackendNames { get; } = ["Llama", "OpenVINO", "vLLM", "SGLang", "dotLLM"];

    private sealed class BackendSettingsForm(string backend)
    {
        public string Backend { get; } = backend;
        public double BaseSeconds { get; set; } = 120;
        public double SecondsPerTool { get; set; } = 1;
        public double SecondsPerPrefillToken { get; set; } = .01;
        public bool IsValid => double.IsFinite(BaseSeconds) && BaseSeconds >= 0
            && double.IsFinite(SecondsPerTool) && SecondsPerTool >= 0
            && double.IsFinite(SecondsPerPrefillToken) && SecondsPerPrefillToken >= 0;

        public void Apply(InferenceTimeoutSettings settings)
        {
            BaseSeconds = settings.BaseSeconds;
            SecondsPerTool = settings.SecondsPerTool;
            SecondsPerPrefillToken = settings.SecondsPerPrefillToken;
        }

        public InferenceTimeoutSettings ToContract() => new(Backend, BaseSeconds, SecondsPerTool, SecondsPerPrefillToken);
    }

    private sealed class BackendRuntimeForm
    {
        public string? CatalogUrl { get; set; }
        public string? InstallationDirectory { get; set; }
        public bool AllowLocalPackages { get; set; }
        public List<RuntimePackageForm> Packages { get; } = [];

        public void Apply(BackendRuntimeOptions options)
        {
            CatalogUrl = options.CatalogUrl;
            InstallationDirectory = options.InstallationDirectory;
            AllowLocalPackages = options.AllowLocalPackages;
            Packages.Clear();
            Packages.AddRange(options.Packages.Select(RuntimePackageForm.FromContract));
        }

        public BackendRuntimeOptions ToContract() => new()
        {
            CatalogUrl = CatalogUrl,
            InstallationDirectory = InstallationDirectory,
            AllowLocalPackages = AllowLocalPackages,
            Packages = Packages.Select(package => package.ToContract()).ToList()
        };
    }

    private sealed class RuntimePackageForm
    {
        public string Id { get; set; } = "new-runtime-package";
        public string Backend { get; set; } = nameof(ConfigurationBackend.Llama);
        public string Route { get; set; } = "sycl";
        public string RuntimeIdentifier { get; set; } = "linux-x64";
        public string Version { get; set; } = "1.0.0";
        public string ArchiveUrl { get; set; } = string.Empty;
        public string Sha256 { get; set; } = string.Empty;
        public string RequiredFilesText { get; set; } = string.Empty;
        public string DriverRequirement { get; set; } = string.Empty;
        public bool RequiresRestart { get; set; } = true;
        public string? LocalPath { get; set; }

        public static RuntimePackageForm FromContract(BackendRuntimePackage package) => new()
        {
            Id = package.Id, Backend = package.Backend.ToString(), Route = package.Route,
            RuntimeIdentifier = package.RuntimeIdentifier, Version = package.Version,
            ArchiveUrl = package.ArchiveUrl, Sha256 = package.Sha256,
            RequiredFilesText = string.Join(", ", package.RequiredFiles), DriverRequirement = package.DriverRequirement,
            RequiresRestart = package.RequiresRestart, LocalPath = package.LocalPath
        };

        public BackendRuntimePackage ToContract() => new(
            Id.Trim(), Enum.Parse<ConfigurationBackend>(Backend, ignoreCase: true), Route.Trim(), RuntimeIdentifier.Trim(),
            Version.Trim(), ArchiveUrl.Trim(), Sha256.Trim(), RequiredFilesText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            DriverRequirement.Trim(), RequiresRestart, string.IsNullOrWhiteSpace(LocalPath) ? null : LocalPath.Trim());
    }
}