@page "/webapi"
@rendermode InteractiveWebAssembly

<div class="webapi-shell">
    <header class="webapi-header">
        <div>
            <p class="eyebrow">DEVELOPER API</p>
            <p class="lede">OpenAI-kompatible lokale API für Chat Completions und Modelle.</p>
        </div>
        <div class="webapi-links">
            <a href="swagger/v1/swagger.json" target="_blank" rel="noopener">Swagger JSON</a>
            <a href="openapi/v1.json" target="_blank" rel="noopener">OpenAPI 3.1</a>
        </div>
    </header>

    <section class="swagger-panel" aria-label="Swagger API Dokumentation">
        <iframe src="swagger/index.html" title="Swagger API Dokumentation"></iframe>
    </section>
</div>

<style>
    .webapi-shell { display: grid; gap: 1.25rem; height: calc(100vh - 2rem); min-height: 42rem; padding: 2rem 1.25rem 1.25rem; }
    .webapi-header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
    .webapi-header h1 { margin: 0; }
    .webapi-links { display: flex; flex-wrap: wrap; gap: .75rem 1rem; }
    .webapi-links a { color: #236b70; font-weight: 700; }
    .swagger-panel { min-height: 0; overflow: hidden; border: 1px solid #d9d4ca; background: #fff; }
    .swagger-panel iframe { display: block; width: 100%; height: 100%; min-height: 36rem; border: 0; }
    @@media (max-width: 680px) { .webapi-shell { height: auto; min-height: calc(100vh - 1rem); padding: 1.25rem .75rem .75rem; } .webapi-header { align-items: stretch; flex-direction: column; } .swagger-panel iframe { min-height: 42rem; } }
</style>
