@page "/llama"
@rendermode InteractiveWebAssembly

@inject HttpClient Http

<PageTitle>LLama</PageTitle>

<h1>LLama</h1>

<p>Lokale LLamaSharp-Inferenz und Backend-Konfiguration.</p>

<EditForm Model="form" OnValidSubmit="LoadModelAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label" for="model-path">GGUF model path</label>
        <InputText id="model-path" class="form-control" @bind-Value="form.ModelPath" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="backend">Backend</label>
        <InputSelect id="backend" class="form-select" @bind-Value="form.Backend">
            <option value="Vulkan">Vulkan</option>
            <option value="CPU">CPU</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label" for="gpu-layers">GPU layers</label>
        <InputNumber id="gpu-layers" class="form-control" @bind-Value="form.GpuLayerCount" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@isLoading">
        @(isLoading ? "Loading..." : "Load model")
    </button>
</EditForm>

@if (isLoading)
{
    <p class="mt-3" role="status">Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="mt-3" role="status">@statusMessage</p>
}

<label class="form-label mt-3" for="load-log">LLamaSharp load output</label>
<textarea id="load-log" class="form-control" rows="20" readonly>@(loadStatus?.LoadLog ?? "Noch kein Modell geladen.")</textarea>

@if (loadStatus is not null)
{
    <dl class="mt-3">
        <dt>Backend</dt>
        <dd>@loadStatus.Backend, @loadStatus.GpuLayerCount GPU layers</dd>
        <dt>GPU</dt>
        <dd>@(loadStatus.GpuName ?? "No NVIDIA GPU information available")</dd>
        <dt>Found Vulkan GPUs</dt>
        <dd>@loadStatus.FoundVulkanGpuCount</dd>
        @foreach (var device in loadStatus.VulkanDevices)
        {
            <dt>@device.Name</dt>
            <dd>@device.AssignedLayerCount layers, @(device.ModelBufferMiB?.ToString("F2") ?? "-") MiB model buffer</dd>
        }
        @if (loadStatus.GpuUsedMemoryMiB is not null && loadStatus.GpuTotalMemoryMiB is not null)
        {
            <dt>VRAM after loading</dt>
            <dd>@loadStatus.GpuUsedMemoryMiB / @loadStatus.GpuTotalMemoryMiB MiB</dd>
        }
        <dt>Model size</dt>
        <dd>@(loadStatus.ModelSizeInBytes / 1024d / 1024d / 1024d).ToString("F2") GiB</dd>
    </dl>

}

@code {
    private readonly ModelForm form = new() { GpuLayerCount = 20 };
    private bool isLoading;
    private string? statusMessage;
    private ModelLoadStatus? loadStatus;

    protected override async Task OnInitializedAsync()
    {
        var response = await Http.GetAsync("api/llama/status");
        if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
        {
            loadStatus = await response.Content.ReadFromJsonAsync<ModelLoadStatus>();
        }
    }

    private async Task LoadModelAsync()
    {
        isLoading = true;
        statusMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/llama/load", form);
            if (response.IsSuccessStatusCode)
            {
                loadStatus = await response.Content.ReadFromJsonAsync<ModelLoadStatus>();
                statusMessage = $"Loaded: {form.ModelPath}";
            }
            else
            {
                statusMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Loading was cancelled.";
        }
        catch (ArgumentException)
        {
            statusMessage = "Enter a valid GGUF model path and GPU layer count.";
        }
        catch (FileNotFoundException)
        {
            statusMessage = "The specified model file was not found.";
        }
        catch (Exception)
        {
            statusMessage = "The model could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class ModelForm
    {
        public string ModelPath { get; set; } = "/home/llm/LocalAI/models/llama-cpp/models/qwen3.8-27b/Qwen3.8-27B-Q4_K_M.gguf";

        public string Backend { get; set; } = "Vulkan";

        public int GpuLayerCount { get; set; }
    }

    private sealed record ModelLoadStatus(
        string ModelPath,
        string Backend,
        int GpuLayerCount,
        ulong ModelSizeInBytes,
        string? GpuName,
        long? GpuUsedMemoryMiB,
        long? GpuTotalMemoryMiB,
        int FoundVulkanGpuCount,
        IReadOnlyList<VulkanDeviceStatus> VulkanDevices,
        string LoadLog);

    private sealed record VulkanDeviceStatus(string Name, int AssignedLayerCount, double? ModelBufferMiB);
}
