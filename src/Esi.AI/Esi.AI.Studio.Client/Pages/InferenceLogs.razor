@page "/inference-logs"
@rendermode InteractiveAuto
@implements IAsyncDisposable

@using Esi.AI.Models
@inject IDataService DataService
@inject IInferenceLogEvents InferenceLogEvents
@inject IJSRuntime JS

<PageTitle>Inference logs</PageTitle>

<div class="inference-logs">
    <header class="inference-logs-header">
        <div>
            <p class="inference-logs-eyebrow">REQUEST DIAGNOSTICS</p>
            <h1>Inference logs</h1>
            <p>Live request history with correlation IDs and expandable text payloads. Image data is omitted; the latest 500 entries are kept in the local Studio database.</p>
        </div>
        <div class="inference-logs-header-actions">
            <button type="button" class="inference-logs-button" @onclick="ClearCompletedAsync" disabled="@(!HasCompletedLogs || isRefreshing || isClearing)">
                @(isClearing ? "Deleting ..." : "Delete all completed")
            </button>
            <button type="button" class="inference-logs-button" @onclick="RefreshAsync" disabled="@(isRefreshing || isClearing)">
                @(isRefreshing ? "Refreshing ..." : "Refresh")
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="inference-logs-alert" role="alert">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="inference-logs-success" role="status">@statusMessage</div>
    }

    @if (isRefreshing && logs.Count == 0)
    {
        <p class="inference-logs-empty">Loading inference history ...</p>
    }
    else if (logs.Count == 0)
    {
        <p class="inference-logs-empty">No inference requests have been recorded yet.</p>
    }
    else
    {
        <section class="inference-log-list" aria-label="Inference request history" aria-live="polite">
            @foreach (var log in logs)
            {
                <article class="inference-log-card">
                    <div class="inference-log-heading">
                        <div class="inference-log-title">
                            <span class="inference-log-status inference-log-status-@log.Status.ToString().ToLowerInvariant()">@GetStatusLabel(log.Status)</span>
                            <strong>@log.Backend · @log.Model</strong>
                        </div>
                        <time datetime="@log.StartedAtUtc.ToString("O")">@log.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</time>
                    </div>

                    <div class="inference-log-correlation">
                        <span>@GetPathLabel(log.Path)</span>
                        <code>@log.InferenceId</code>
                        @if (!string.IsNullOrWhiteSpace(log.BackendVariantId))
                        {
                            <span>Variant: @log.BackendVariantId</span>
                        }
                    </div>

                    <dl class="inference-log-metrics">
                        <div><dt>Input tokens</dt><dd>@FormatInputTokenCount(log)</dd></div>
                        <div><dt>Prefill duration</dt><dd>@FormatStepDuration(log.PrefillDurationMs)</dd></div>
                        <div><dt>Prefill rate</dt><dd>@FormatRate(log.PrefillTokensPerSecond, log.PrefillTokenCountIsEstimated)</dd></div>
                        <div><dt>Time to first token</dt><dd>@FormatStepDuration(log.TimeToFirstTokenMs)</dd></div>
                        <div><dt>Decode duration</dt><dd>@FormatStepDuration(log.DecodeDurationMs)</dd></div>
                        <div><dt title="Backend-reported generated-token rate, falling back to the rate calculated from decode time.">Decode rate</dt><dd>@FormatRate(log.DecodeTokensPerSecond)</dd></div>
                        <div><dt>Messages</dt><dd>@log.MessageCount</dd></div>
                        <div><dt>Images</dt><dd>@log.ImageCount</dd></div>
                        <div><dt>Tools</dt><dd>@log.ToolCount</dd></div>
                        <div><dt>Output</dt><dd>@FormatCount(log.OutputTokenCount) tokens</dd></div>
                        <div><dt>Duration</dt><dd>@FormatDuration(log.DurationMilliseconds)</dd></div>
                        <div><dt title="Prompt and output tokens divided by total request duration.">End-to-end rate</dt><dd>@FormatRate(log.EndToEndTokensPerSecond, log.PrefillTokenCountIsEstimated)</dd></div>
                        <div><dt>Streaming</dt><dd>@(log.Streaming ? "Yes" : "No")</dd></div>
                        @if (!string.IsNullOrWhiteSpace(log.FinishReason))
                        {
                            <div><dt>Finish reason</dt><dd>@log.FinishReason</dd></div>
                        }
                    </dl>

                    <div class="inference-log-payloads">
                        <details class="inference-log-payload">
                            <summary>Request</summary>
                            <pre>@(log.RequestPayload ?? "Request payload unavailable for this entry.")</pre>
                        </details>
                        <details class="inference-log-payload">
                            <summary>Response</summary>
                            <pre>@(log.ResponsePayload ?? (log.Status == InferenceLogStatus.Running ? "Generation is in progress." : "No response payload was recorded."))</pre>
                        </details>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
                    {
                        <details class="inference-log-error">
                            <summary>@(log.ErrorType ?? "Request error")</summary>
                            <p>@log.ErrorMessage</p>
                        </details>
                    }

                    <div class="inference-log-actions">
                        @if (log.Status != InferenceLogStatus.Running)
                        {
                            <button type="button" class="inference-logs-button inference-logs-button-secondary" @onclick="() => DeleteAsync(log.Id)">Delete</button>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    private readonly List<InferenceLog> logs = [];
    private bool isRefreshing;
    private bool isClearing;
    private string? errorMessage;
    private string? statusMessage;
    private bool HasCompletedLogs => logs.Any(log => log.Status != InferenceLogStatus.Running);

    protected override async Task OnInitializedAsync()
    {
        InferenceLogEvents.InferenceLog_Read += HandleReadAsync;
        InferenceLogEvents.InferenceLog_Create += HandleCreatedAsync;
        InferenceLogEvents.InferenceLog_Update += HandleUpdatedAsync;
        InferenceLogEvents.InferenceLog_Delete += HandleDeletedAsync;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        isRefreshing = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            await DataService.InferenceLog_ReadAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        errorMessage = null;
        statusMessage = null;
        try
        {
            await DataService.InferenceLog_DeleteAsync(id);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearCompletedAsync()
    {
        errorMessage = null;
        try
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Delete all completed inference logs from the database? Running requests will be kept.");
            if (!confirmed)
                return;

            isClearing = true;
            statusMessage = null;
            var deletedCount = await DataService.InferenceLog_ClearCompletedAsync();
            statusMessage = $"{deletedCount:N0} completed inference log{(deletedCount == 1 ? string.Empty : "s")} deleted.";
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isClearing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task HandleReadAsync(IReadOnlyList<InferenceLog> entries) => InvokeAsync(() =>
    {
        logs.Clear();
        Merge(entries);
        StateHasChanged();
    });

    private Task HandleCreatedAsync(InferenceLog entry) => UpdateEntryAsync(entry);

    private Task HandleUpdatedAsync(InferenceLog entry) => UpdateEntryAsync(entry);

    private Task UpdateEntryAsync(InferenceLog entry) => InvokeAsync(() =>
    {
        Upsert(entry);
        StateHasChanged();
    });

    private Task HandleDeletedAsync(InferenceLog entry) => InvokeAsync(() =>
    {
        logs.RemoveAll(existing => existing.Id == entry.Id);
        StateHasChanged();
    });

    private void Merge(IEnumerable<InferenceLog> entries)
    {
        foreach (var entry in entries)
            Upsert(entry);

        logs.Sort((left, right) => right.StartedAtUtc.CompareTo(left.StartedAtUtc));
        if (logs.Count > 500)
            logs.RemoveRange(500, logs.Count - 500);
    }

    private void Upsert(InferenceLog entry)
    {
        var existingIndex = logs.FindIndex(existing => existing.Id == entry.Id);
        if (existingIndex >= 0)
            logs[existingIndex] = entry;
        else
            logs.Add(entry);
    }

    private static string GetStatusLabel(InferenceLogStatus status) => status switch
    {
        InferenceLogStatus.Succeeded => "Succeeded",
        InferenceLogStatus.Failed => "Failed",
        InferenceLogStatus.Canceled => "Canceled",
        InferenceLogStatus.TimedOut => "Timed out",
        InferenceLogStatus.Interrupted => "Interrupted",
        _ => "Running"
    };

    private static string GetPathLabel(string path) => path switch
    {
        "OpenAI" => "OpenAI-compatible API",
        "SignalR" => "Studio chat",
        _ => path
    };

    private static string FormatCount(int? count) => count?.ToString("N0") ?? "—";

    private static string FormatInputTokenCount(InferenceLog log) =>
        log.PromptTokenCount is int promptTokenCount
            ? $"{promptTokenCount:N0} tokens"
            : log.EstimatedPrefillTokens is int estimate
                ? $"≈ {estimate:N0} tokens"
                : "—";

    private static string FormatStepDuration(double? durationMilliseconds) =>
        durationMilliseconds is double duration ? $"{duration:N1} ms" : "—";

    private static string FormatRate(double? tokensPerSecond, bool estimated = false) =>
        tokensPerSecond is double rate
            ? $"{(estimated ? "≈ " : string.Empty)}{rate:N1} tokens/s"
            : "—";

    private static string FormatDuration(long? durationMilliseconds) =>
        durationMilliseconds is { } duration ? $"{duration:N0} ms" : "In progress";

    public ValueTask DisposeAsync()
    {
        InferenceLogEvents.InferenceLog_Read -= HandleReadAsync;
        InferenceLogEvents.InferenceLog_Create -= HandleCreatedAsync;
        InferenceLogEvents.InferenceLog_Update -= HandleUpdatedAsync;
        InferenceLogEvents.InferenceLog_Delete -= HandleDeletedAsync;
        return ValueTask.CompletedTask;
    }
}
