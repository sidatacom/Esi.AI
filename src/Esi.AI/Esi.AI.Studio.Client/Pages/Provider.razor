@page "/provider"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable

@using Esi.AI.Models
@inject IDataService DataService
@inject NavigationManager NavigationManager
@inject IClientStateStore StateStore

<div class="provider-shell">
    <header class="provider-header">
        <div>
            <p class="eyebrow">MODEL PROVIDER / CONFIGURATION</p>
            <h1>Esi.AI Studio Provider</h1>
            <p class="lede">Die lokale OpenAI-kompatible Schnittstelle für deine geladenen Modelle.</p>
        </div>
        <button class="primary-button" type="button" @onclick="RefreshAsync" disabled="@isRefreshing">@(isRefreshing ? "Aktualisiere ..." : "Status aktualisieren")</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <section class="provider-alert provider-alert-error" role="alert">@errorMessage</section>
    }

    <section class="provider-overview" aria-labelledby="provider-overview-heading">
        <div class="provider-overview-heading">
            <div>
                <p class="eyebrow">PROVIDER STATUS</p>
                <h2 id="provider-overview-heading">OpenAI-compatible API</h2>
            </div>
            <span class="provider-status @(IsConnected ? "provider-status-online" : "provider-status-offline")">
                <span class="provider-status-dot" aria-hidden="true"></span>
                @(IsConnected ? "Verbunden" : "Nicht verbunden")
            </span>
        </div>
        <div class="provider-details">
            <div><span>Provider</span><strong>Esi.AI Studio</strong></div>
            <div><span>Base URL</span><code>http://127.0.0.1:7010/v1</code></div>
            <div><span>Model endpoint</span><code>GET /models</code></div>
            <div><span>Chat endpoint</span><code>POST /chat/completions</code></div>
        </div>
    </section>

    <section class="provider-grid">
        <section class="provider-panel" aria-labelledby="models-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">AVAILABLE MODELS</p>
                    <h2 id="models-heading">Geladene Modelle</h2>
                </div>
                <span class="provider-count">@LoadedModels.Count</span>
            </div>
            @if (isRefreshing && LoadedModels.Count == 0)
            {
                <p class="provider-empty">Lese den Runtime-Status ...</p>
            }
            else if (LoadedModels.Count == 0)
            {
                <div class="provider-empty"><strong>Kein Modell geladen.</strong><span>Lade zuerst ein Modell unter Backends.</span><button class="secondary-button" type="button" @onclick="OpenBackends">Backends öffnen</button></div>
            }
            else
            {
                <div class="provider-model-list">
                    @foreach (var model in LoadedModels)
                    {
                        <article class="provider-model @(model.IsLoading ? "provider-model-loading" : "")">
                            <div>
                                <strong>@GetModelName(model.ModelPath)</strong>
                                <span>@model.Runtime · @model.Backend@(model.IsLoading ? " · wird geladen" : "")</span>
                            </div>
                            @if (!model.IsLoading)
                            {
                                <button class="secondary-button" type="button" @onclick="OpenChat">Chat öffnen</button>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="provider-panel provider-connection-panel" aria-labelledby="connection-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">CLIENT CONNECTION</p>
                    <h2 id="connection-heading">VS Code Verbindung</h2>
                </div>
                <span class="connection-mark" aria-hidden="true">-&gt;</span>
            </div>
            <p>Der VS-Code-Provider verwendet dieselbe lokale API und übernimmt hier angezeigte geladene Modelle.</p>
            <dl class="connection-list">
                <div><dt>Vendor</dt><dd>Esi.AI Studio</dd></div>
                <div><dt>Model picker</dt><dd>Nach Status aktualisieren</dd></div>
                <div><dt>Streaming</dt><dd>Aktiviert</dd></div>
                <div><dt>Authentifizierung</dt><dd>Lokale Verbindung</dd></div>
            </dl>
            <p class="provider-note">Wenn im VS-Code-Chat „fetch failed“ erscheint, muss Esi.AI Studio auf Port 7010 laufen und mindestens ein Modell geladen sein.</p>
        </section>
    </section>
</div>

<style>
    .provider-shell { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; display: grid; gap: 1.25rem; }
    .provider-header, .provider-overview-heading, .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; }
    .provider-header h1, .provider-overview h2, .provider-panel h2 { margin: 0; }
    .provider-overview, .provider-panel { border: 1px solid #d9d4ca; background: #fbfaf6; }
    .provider-overview { padding: 1.35rem; }
    .provider-status { display: inline-flex; align-items: center; gap: .45rem; padding: .4rem .65rem; border: 1px solid #c9c3b8; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; }
    .provider-status-dot { width: .55rem; height: .55rem; border-radius: 50%; background: #8b3f2f; }
    .provider-status-online { color: #236b70; border-color: #a6c7c7; }.provider-status-online .provider-status-dot { background: #236b70; }
    .provider-details { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 1.25rem; }.provider-details div { display: grid; gap: .3rem; min-width: 0; }.provider-details span, .connection-list dt { color: #756f65; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }.provider-details strong, .provider-details code { overflow-wrap: anywhere; }.provider-details code { color: #236b70; font: .85rem/1.4 ui-monospace, SFMono-Regular, Consolas, monospace; }
    .provider-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr); gap: 1.25rem; }.provider-panel { padding: 1.35rem; }.provider-count { color: #236b70; font-size: 1.5rem; font-weight: 700; }.provider-model-list { display: grid; gap: .65rem; margin-top: 1.25rem; }.provider-model { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .9rem 0; border-top: 1px solid #d9d4ca; }.provider-model div { display: grid; gap: .3rem; min-width: 0; }.provider-model span { color: #756f65; font-size: .82rem; }.provider-model strong { overflow-wrap: anywhere; }.provider-model-loading { opacity: .65; }
    .provider-empty { min-height: 10rem; display: grid; place-content: center; gap: .65rem; margin: 1.25rem 0 0; color: #756f65; text-align: center; }.provider-empty strong { color: #302d28; }.provider-empty .secondary-button { justify-self: center; }.provider-connection-panel > p:not(.eyebrow) { color: #665f54; line-height: 1.55; }.connection-mark { color: #b65b38; font-size: 1.5rem; }.connection-list { display: grid; gap: .7rem; margin: 1.25rem 0; }.connection-list div { display: flex; justify-content: space-between; gap: 1rem; padding-top: .65rem; border-top: 1px solid #d9d4ca; }.connection-list dd { margin: 0; text-align: right; }.provider-note { margin: 0; padding-top: .85rem; border-top: 1px solid #d9d4ca; color: #756f65; font-size: .82rem; }.provider-alert { padding: .85rem 1rem; border: 1px solid #d9a99e; background: #f7e9e5; color: #8b3f2f; }.provider-alert-error { border-left: 3px solid #8b3f2f; }
    @@media (max-width: 820px) { .provider-details { grid-template-columns: repeat(2, minmax(0, 1fr)); }.provider-grid { grid-template-columns: 1fr; } }
    @@media (max-width: 560px) { .provider-shell { padding: 1.25rem .75rem 3rem; }.provider-header, .provider-overview-heading { align-items: stretch; flex-direction: column; }.provider-header .primary-button { width: 100%; }.provider-details { grid-template-columns: 1fr; }.provider-model { align-items: stretch; flex-direction: column; }.provider-model .secondary-button { width: 100%; }.connection-list div { align-items: start; flex-direction: column; gap: .25rem; }.connection-list dd { text-align: left; } }
</style>

@code {
    private bool isRefreshing;
    private string? errorMessage;

    private IReadOnlyList<LoadedModelStatus> LoadedModels => StateStore.LoadedModels.LoadedModels;
    private bool IsConnected => !string.IsNullOrWhiteSpace(StateStore.LoadedModels.Backend) || LoadedModels.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        StateStore.Changed += HandleStateChanged;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        isRefreshing = true;
        errorMessage = null;
        try
        {
            StateStore.ApplyLoadedModels(await DataService.LoadedModel_ReadAsync());
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private void OpenBackends() => NavigationManager.NavigateTo("backends");

    private void OpenChat() => NavigationManager.NavigateTo("chats");

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        StateStore.Changed -= HandleStateChanged;
        return ValueTask.CompletedTask;
    }

    private static string GetModelName(string modelPath)
    {
        var normalizedPath = modelPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var fileName = Path.GetFileName(normalizedPath);
        return string.IsNullOrWhiteSpace(fileName) ? normalizedPath : Path.GetFileNameWithoutExtension(fileName);
    }
}
