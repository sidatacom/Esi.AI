@implements IDisposable

@inject NavigationManager NavigationManager

<div class="studio-brand">
    <a href="" aria-label="Esi.AI Studio home">
        <span class="studio-brand-mark" aria-hidden="true">E</span>
        <span>
            <strong>Esi.AI</strong>
            <small>Studio control</small>
        </span>
    </a>
</div>

<div class="studio-navigation">
    <FluentNav Id="studio-navigation"
         Width="250px"
         UseIcons="false"
         BackgroundColor="transparent"
         BackgroundColorHover="rgba(255, 255, 255, .08)">
     <FluentNavItem Href="/" Match="NavLinkMatch.All">Overview</FluentNavItem>
     <FluentNavItem Href="backends">Backends</FluentNavItem>
     <FluentNavItem Href="models">Models</FluentNavItem>
     <FluentNavItem Href="webapi">Web API</FluentNavItem>
     <FluentNavItem Href="chats">Chats</FluentNavItem>
     <FluentNavItem Href="provider">Provider</FluentNavItem>
    <FluentNavItem Href="settings">Settings</FluentNavItem>
     <FluentNavItem Href="auth">Auth required</FluentNavItem>

        <AuthorizeView>
            <Authorized>
                <FluentNavItem Href="Account/Manage">@context.User.Identity?.Name</FluentNavItem>
                <form action="Account/Logout" method="post" class="studio-logout-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit">Log out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <FluentNavItem Href="Account/Register">Register</FluentNavItem>
                <FluentNavItem Href="Account/Login">Log in</FluentNavItem>
            </NotAuthorized>
        </AuthorizeView>
    </FluentNav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

