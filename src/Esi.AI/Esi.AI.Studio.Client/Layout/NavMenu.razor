@implements IDisposable

@inject NavigationManager NavigationManager

<div class="studio-brand">
    <a href="" aria-label="Esi.AI Studio home">
        <span class="studio-brand-mark" aria-hidden="true">E</span>
        <span>
            <strong>Esi.AI</strong>
            <small>Studio control</small>
        </span>
    </a>
</div>

<div class="studio-navigation">
    <nav id="studio-navigation" aria-label="Studio navigation">
        <NavLink href="/" Match="NavLinkMatch.All" data-enhance-nav="false">Overview</NavLink>
        <NavLink href="/backends" data-enhance-nav="false">Backends</NavLink>
        <NavLink href="/models" data-enhance-nav="false">Models</NavLink>
        <NavLink href="/webapi" data-enhance-nav="false">Web API</NavLink>
        <NavLink href="/chats" data-enhance-nav="false">Chats</NavLink>
        <NavLink href="/flow" data-enhance-nav="false">Flow</NavLink>
        <NavLink href="/provider" data-enhance-nav="false">Provider</NavLink>
        <NavLink href="/settings" data-enhance-nav="false">Settings</NavLink>
        <NavLink href="/auth" data-enhance-nav="false">Auth required</NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink href="/Account/Manage" data-enhance-nav="false">@context.User.Identity?.Name</NavLink>
                <form action="Account/Logout" method="post" class="studio-logout-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit">Log out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink href="/Account/Register" data-enhance-nav="false">Register</NavLink>
                <NavLink href="/Account/Login" data-enhance-nav="false">Log in</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

