<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Esi.AI.Backend.Llama.Cuda12</RootNamespace>
    <PackageId>Esi.AI.Backend.Llama.Cuda12</PackageId>
    <Version>0.1.0</Version>
    <Description>CUDA 12 inference backend module for Esi.AI using LLamaSharp.</Description>
    <PackageTags>esi-ai;backend;llama;cuda;cuda12;linux-x64</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Esi.AI.Backend.Abstractions/Esi.AI.Backend.Abstractions.csproj" />
    <ProjectReference Include="../Esi.AI.Models/Esi.AI.Models.csproj" />
    <ProjectReference Include="../../../origins/sidatacom/LLamaSharp/LLama/LLamaSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../origins/sidatacom/LLamaSharp/LLama/runtimes/deps/cu12.4.0/*.so"
          Link="runtimes/linux-x64/native/cuda12/%(Filename)%(Extension)"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/cuda12/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Esi.AI.Backend.Llama.Cuda12.Tests" />
  </ItemGroup>

</Project>