{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=Data/app.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OmniRoute": {
    "Enabled": false,
    "BaseUrl": "http://localhost:20128",
    "ForwardAuthorizationHeader": false,
    "TimeoutSeconds": 120
  },
  "InferenceTimeout": {
    "Backends": {
      "Llama": { "BaseSeconds": 120, "SecondsPerTool": 1, "SecondsPerPrefillToken": 0.01 },
      "OpenVINO": { "BaseSeconds": 120, "SecondsPerTool": 1, "SecondsPerPrefillToken": 0.01 },
      "vLLM": { "BaseSeconds": 120, "SecondsPerTool": 1, "SecondsPerPrefillToken": 0.01 },
      "SGLang": { "BaseSeconds": 120, "SecondsPerTool": 1, "SecondsPerPrefillToken": 0.01 },
      "dotLLM": { "BaseSeconds": 120, "SecondsPerTool": 1, "SecondsPerPrefillToken": 0.01 }
    }
  },
  "ModelLibrary": {
    "Directories": [
      "%USERPROFILE%/.cache/esi-ai/models",
      "/home/llm/LocalAI/models",
      "/home/llm/LocalAI/models/llama-cpp/models"
    ],
    "SearchLimit": 20,
    "MaxParallelFileDownloads": 2
  },
  "BackendRuntime": {
    "CatalogUrl": "",
    "Packages": []
  }
}
