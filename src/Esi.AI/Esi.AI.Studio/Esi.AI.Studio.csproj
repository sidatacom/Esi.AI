<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Esi_AI_Studio-06d2dd05-e7aa-451c-9de0-62a22d6b719a</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data\app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Esi.AI.Studio.Client\Esi.AI.Studio.Client.csproj" />
    <ProjectReference Include="..\Esi.AI.Core\Esi.AI.Core.csproj" />
    <ProjectReference Include="..\Esi.AI.Models\Esi.AI.Models.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- The upstream runtime publishes Ubuntu 24 x64 as its current Linux ABI target; it is used on Ubuntu 26.04. -->
    <PackageReference Include="OpenVINO.runtime.ubuntu.24-x86_64" Version="2026.3.0" />
    <PackageReference Include="JYPPX.OpenVINO.GenAI.runtime.ubuntu.24-x86_64" Version="2026.3.0" />
  </ItemGroup>

</Project>
