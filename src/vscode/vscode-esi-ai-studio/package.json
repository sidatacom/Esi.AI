{
  "name": "vscode-esi-ai-studio",
  "displayName": "Esi.AI Studio Models",
  "description": "Use models loaded by Esi.AI Studio as VS Code language models.",
  "version": "0.1.17",
  "publisher": "sidatacom",
  "license": "MIT",
  "author": "sidatacom",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidatacom/Esi.AI.git"
  },
  "homepage": "https://github.com/sidatacom/Esi.AI#readme",
  "bugs": {
    "url": "https://github.com/sidatacom/Esi.AI/issues"
  },
  "keywords": [
    "vscode",
    "language-model",
    "openai",
    "esi-ai",
    "local-ai"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "esiAiStudio",
          "title": "Esi.AI Studio",
          "icon": "resources/esi-ai-studio.svg"
        }
      ]
    },
    "views": {
      "esiAiStudio": [
        {
          "type": "webview",
          "id": "esiAiStudio.configuration",
          "name": "Provider"
        }
      ]
    },
    "commands": [
      {
        "command": "esiAiStudio.refreshModels",
        "title": "Esi AI Studio: Refresh Models"
      },
      {
        "command": "esiAiStudio.configureApiKey",
        "title": "Esi AI Studio: Configure API Key"
      },
      {
        "command": "esiAiStudio.inspectModels",
        "title": "Esi AI Studio: Inspect Registered Models"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "esi-ai-studio",
        "displayName": "Esi.AI Studio"
      }
    ],
    "configuration": {
      "title": "Esi.AI Studio Models",
      "properties": {
        "esiAiStudio.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7010/v1",
          "description": "Base URL of the Esi.AI Studio OpenAI-compatible API.",
          "pattern": "^https?://.+"
        },
        "esiAiStudio.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Maximum time in milliseconds for one Esi.AI Studio request."
        },
        "esiAiStudio.loggingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Write provider requests, responses, and bounded SSE traces to the configured log path."
        },
        "esiAiStudio.loggingPath": {
          "type": "string",
          "default": "",
          "description": "Path for the provider JSONL trace. Leave empty to use the operating system temporary directory."
        },
        "esiAiStudio.maxInputTokens": {
          "type": "number",
          "default": 32768,
          "minimum": 1,
          "description": "Input token limit advertised to VS Code for Esi.AI Studio models."
        },
        "esiAiStudio.maxOutputTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 1,
          "description": "Output token limit advertised to VS Code for Esi.AI Studio models."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "package": "vsce package",
    "install:local": "bash scripts/install.sh"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
