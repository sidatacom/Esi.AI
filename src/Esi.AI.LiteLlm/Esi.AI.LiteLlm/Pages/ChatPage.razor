@page "/chat"
@attribute [Authorize]
@rendermode InteractiveAuto

<h3>Esi.AI Chat</h3>

<div class="row">
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Chat</span>
                <span class="text-muted small">@CurrentProviderName</span>
            </div>
            <div class="card-body p-0" style="height: 400px; overflow-y: auto;">
                @foreach (var message in Messages)
                {
                    <div class="p-2 mb-2 @(message.Role == "user" ? "bg-light" : "bg-primary text-white") rounded">
                        @message.Content
                    </div>
                }
            </div>
            <div class="card-footer p-2 border-top">
                <div class="input-group">
                    <InputText @bind-Value="newMessage" class="form-control" placeholder="Type a message..." />
                    <InputButton ButtonType="Submit" class="btn btn-primary" @onclick="SendMessage" />
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">
                <h5>Provider Selection</h5>
            </div>
            <div class="card-body p-2">
                @foreach (var provider in AvailableProviders)
                {
                    <div class="mb-2">
                        <input type="radio" name="provider" @bind-value="CurrentProviderIndex" value="@((object)provider.Id)" class="form-check-input" />
                        <label class="form-check-label small text-muted">@provider.Name</label>
                    </div>
                }
            </div>
            <div class="card-footer small text-muted">
                @if (CurrentProviderInfo != null)
                {
                    <div>Status: @(CurrentProviderInfo.Value ? "Online" : "Offline")</div>
                    <div>Strategy: @CurrentRoutingStrategy</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Inject]
    private Esi.AI.Llm.Providers.IChatCompletionProvider? CurrentProvider { get; set; }

    [Inject]
    private Esi.AI.Llm.Router.ProviderRouter? Router { get; set; }

    [Inject]
    private Esi.AI.Llm.Cost.PricingConfiguration? PricingConfig { get; set; }

    private string newMessage = "";
    private List<Esi.AI.Llm.Contracts.ChatMessage> Messages = new();
    private int CurrentProviderIndex = 0;
    private Esi.AI.Llm.Models.ProviderInfo? CurrentProviderInfo;
    private RoutingStrategy CurrentRoutingStrategy = RoutingStrategy.RoundRobin;
    private List<Esi.AI.Llm.Models.ProviderInfo> AvailableProviders = new();

    protected override void OnInitialized()
    {
        // Load available providers from router
        AvailableProviders = Router?.GetRegisteredProviders() ?? new List<Esi.AI.Llm.Models.ProviderInfo>();
        
        // Subscribe to provider changes
        CurrentProviderInfo = AvailableProviders.Count > 0 ? AvailableProviders[0] : null;
    }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;

        var message = new Esi.AI.Llm.Contracts.ChatMessage { Role = "user", Content = newMessage };
        Messages.Add(message);
        newMessage = "";

        // TODO: Send to provider and get response
        // var result = CurrentProvider?.CompleteAsync(new ChatCompletionRequest { Messages = new[] { message } });
    }
}