@page "/cost"
@attribute [Authorize]
@rendermode InteractiveAuto

<h3>Esi.AI Cost Management</h3>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>Model Pricing Configuration</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <input type="text" class="form-control form-control-sm" placeholder="Model name" @bind-value="newModelName" />
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control form-control-sm" placeholder="Provider" @bind-value="newProviderName" />
                    </div>
                    <div class="col-md-3">
                        <input type="number" class="form-control form-control-sm" step="0.000001" placeholder="Input price" @bind-value="newInputPrice" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3">
                        <input type="number" class="form-control form-control-sm" step="0.000001" placeholder="Output price" @bind-value="newOutputPrice" />
                    </div>
                    <div class="col-md-3">
                        <input type="number" class="form-control form-control-sm" placeholder="Fixed cost" @bind-value="newFixedCost" />
                    </div>
                    <div class="col-md-6">
                        <select class="form-select form-select-sm">
                            <option>OpenAI</option>
                            <option>Anthropic</option>
                            <option>Google Gemini</option>
                            <option>Azure OpenAI</option>
                            <option>Ollama</option>
                        </select>
                    </div>
                </div>
                <button class="btn btn-primary w-100 mb-2" @onclick="AddPricing">Add Pricing</button>

                <h6>Configured Pricings</h6>
                <div class="list-group">
                    @foreach (var pricing in ConfiguredPricings)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center small">
                            <span>@pricing.ModelName (@pricing.ProviderName)</span>
                            <span>@pricing.InputTokenPrice$ input / @pricing.OutputTokenPrice$ output</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject]
    private Esi.AI.Llm.Cost.PricingConfiguration? PricingConfig { get; set; }

    private string newModelName = "";
    private string newProviderName = "";
    private decimal newInputPrice = 0m;
    private decimal newOutputPrice = 0m;
    private decimal newFixedCost = 0m;

    private List<Esi.AI.Llm.Models.ModelPricing> ConfiguredPricings => PricingConfig?.ModelPricings.ToList() ?? new List<Esi.AI.Llm.Models.ModelPricing>();

    private void AddPricing()
    {
        if (string.IsNullOrWhiteSpace(newModelName) || string.IsNullOrWhiteSpace(newProviderName)) return;

        PricingConfig?.AddPricing(newModelName, newProviderName, newInputPrice, newOutputPrice, newFixedCost);
        newModelName = "";
        newProviderName = "";
        newInputPrice = 0m;
        newOutputPrice = 0m;
        newFixedCost = 0m;
    }
}