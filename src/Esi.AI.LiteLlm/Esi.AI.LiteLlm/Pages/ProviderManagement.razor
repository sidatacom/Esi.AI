@page "/providers"
@attribute [Authorize]
@rendermode InteractiveAuto

<h3>Esi.AI Provider Management</h3>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>Registered Providers</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Strategy</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var provider in RegisteredProviders)
                            {
                                <tr>
                                    <td>@provider.Name</td>
                                    <td>@provider.Type</td>
                                    <td>
                                        <span class="badge bg-@(provider.IsOnline ? "success" : "danger")">
                                            @(provider.IsOnline ? "Online" : "Offline")
                                        </span>
                                    </td>
                                    <td>@provider.RoutingStrategy</td>
                                    <td>
                                        <button class="btn btn-link btn-sm text-primary" @onclick="(() => SelectProvider(provider))">Select</button>
                                        <button class="btn btn-link btn-sm text-danger" @onclick="(() => RemoveProvider(provider))">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary" @onclick="AddProvider">Add Provider</button>
                <button class="btn btn-link text-secondary" @onclick="ReloadProviders">Reload</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject]
    private Esi.AI.Llm.Router.ProviderRouter? Router { get; set; }

    [Inject]
    private Esi.AI.Llm.Redis.IRedisCacheService? RedisCache { get; set; }

    private List<Esi.AI.Llm.Models.ProviderInfo> RegisteredProviders = new();

    protected override void OnInitialized()
    {
        ReloadProviders();
    }

    private void ReloadProviders()
    {
        RegisteredProviders = Router?.GetRegisteredProviders() ?? new List<Esi.AI.Llm.Models.ProviderInfo>();
    }

    private void AddProvider()
    {
        // TODO: Add new provider dialog
        // For now, just reload
        ReloadProviders();
    }

    private void SelectProvider(Esi.AI.Llm.Models.ProviderInfo provider)
    {
        Router?.SelectProvider(provider.Name);
        ReloadProviders();
    }

    private void RemoveProvider(Esi.AI.Llm.Models.ProviderInfo provider)
    {
        Router?.UnregisterProvider(provider.Name);
        ReloadProviders();
    }
}