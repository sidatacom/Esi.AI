@page "/chat"
@attribute [Authorize]
@rendermode InteractiveAuto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Esi.AI
@using Esi.AI.Llm

<h3>Esi.AI Chat</h3>

<div class="row">
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Chat</span>
                <span class="text-muted small">@CurrentProvider</span>
            </div>
            <div class="card-body p-0" style="height: 400px; overflow-y: auto;">
                @foreach (var message in Messages)
                {
                    <div class="p-2 mb-2 @(message.Role == "user" ? "bg-light" : "bg-primary text-white") rounded">
                        @message.Content
                    </div>
                }
            </div>
            <div class="card-footer p-2 border-top">
                <div class="input-group">
                    <InputText @bind="newMessage" class="form-control" placeholder="Type a message..." />
                    <InputButton ButtonType="Submit" class="btn btn-primary" @onclick="SendMessage" />
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">
                <h5>Provider Selection</h5>
            </div>
            <div class="card-body p-2">
                @foreach (var provider in AvailableProviders)
                {
                    <div class="mb-2">
                        <InputRadio @bind="CurrentProviderIndex" class="form-check-input" />
                        <label class="form-check-label small text-muted">@provider.Name</label>
                    </div>
                }
            </div>
            <div class="card-footer small text-muted">
                @if (CurrentProvider != null)
                {
                    <div>Status: @(CurrentProvider.Value ? "Online" : "Offline")</div>
                    <div>Strategy: @CurrentRoutingStrategy</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Inject]
    private IChatCompletionProvider? CurrentProvider { get; set; }

    [Inject]
    private ProviderRouter? Router { get; set; }

    [Inject]
    private PricingConfiguration? PricingConfig { get; set; }

    private string newMessage = "";
    private List<ChatMessage> Messages = new();
    private int CurrentProviderIndex = 0;
    private RoutingStrategy CurrentRoutingStrategy = RoutingStrategy.RoundRobin;
    private List<ProviderInfo> AvailableProviders = new();

    protected override void OnInitialized()
    {
        // Load available providers from router
        AvailableProviders = Router?.GetRegisteredProviders() ?? new List<ProviderInfo>();
        
        // Subscribe to provider changes
        CurrentProvider = AvailableProviders.Count > 0 ? AvailableProviders[0].Name : null;
    }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;

        var message = new ChatMessage { Role = "user", Content = newMessage };
        Messages.Add(message);
        newMessage = "";

        // TODO: Send to provider and get response
        // var result = CurrentProvider?.CompleteAsync(new ChatCompletionRequest { Messages = new[] { message } });
    }
}